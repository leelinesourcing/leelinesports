---
// Three areas that carry past the order — cost control, sustainable production
// and after-sales. Split out of the Services section, which had run long, so
// they read as their own band rather than as a tail on the fabric library.
import { Image } from 'astro:assets'
import { r2 } from '../lib/images'

interface Area {
  title: string
  /** Descriptive paragraph, set under the image. */
  body: string
  img: string
  alt: string
}

interface Props {
  eyebrow?: string
  heading?: string
  lede?: string
  areas?: Area[]
}

const {
  eyebrow = 'Beyond the order',
  heading = 'The Parts That Outlive the Order.',
  lede = 'Cost, materials and support are settled up front, not after the fact — each one leaving a record you can point to.',
  areas = [
    {
      title: 'Cost control',
      body: 'Unit cost is engineered, not haggled. Order data runs through ERP scheduling so capacity is booked rather than chased, a 15-step QC process catches faults early so they never become rework, and value engineering takes cost out of the spec without changing what your customer receives.',
      img: r2('cost-control'),
      alt: 'Cost control across a custom sportswear production run',
    },
    {
      title: 'Sustainable production',
      body: 'Sustainability is specified, not claimed. Recycled and upcycled inputs are named on the bill of materials, dyeing runs on water-saving lines, and finishes are PFC-free — each one carrying the certificate to back it, so your own sustainability page has something to cite.',
      img: r2('sustainable-production'),
      alt: 'Sustainable and recycled materials used in custom sportswear',
    },
    {
      title: 'After-sales support',
      body: 'A dedicated contact carries your account from first quote to final reorder. Requests are logged and tracked, faults are answered with a plan rather than an apology, and claims settle in writing — so a problem on any job does not stall the next.',
      img: r2('after-sales-support'),
      alt: 'After-sales support for custom sportswear orders',
    },
  ],
} = Astro.props
---

<section class="cw-beyond cw-cv" id="beyond">
  <div class="cw-wrap">
    <div class="cw-beyond-head">
      <p class="cw-eyebrow" data-reveal="up">{eyebrow}</p>
      <h2 class="cw-h2" data-reveal="up" style="--rd:80ms">{heading}</h2>
      <p class="cw-lede" data-reveal="up" style="--rd:160ms">{lede}</p>
    </div>

    <ul class="cw-beyond-tiles">
      {areas.map((g) => (
        <li class="cw-beyond-tile" data-reveal="up">
          <figure class="cw-beyond-fig">
            <Image
              src={g.img}
              alt={g.alt}
              width={550}
              height={525}
              widths={[380, 760]}
              sizes="(min-width: 920px) 375px, 100vw"
              quality={80}
              loading="lazy"
              decoding="async"
            />
          </figure>

          <h3 class="cw-beyond-title">{g.title}</h3>
          <p class="cw-beyond-copy">{g.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cw-beyond {
    padding: 7rem 0 6rem;
    /* paper rather than linen: the sections either side are cream and linen, so
       linen here would merge into the Certifications band below it. */
    background: var(--color-paper);
  }
  /* head spans the container, the way every other section's does */
  .cw-beyond-head {
    max-width: none;
  }
  .cw-beyond-head .cw-lede {
    max-width: none;
  }

  /* Image, then title, then the description — three to a row. */
  .cw-beyond-tiles {
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .cw-beyond-tile {
    display: flex;
    flex-direction: column;
  }
  .cw-beyond-title {
    margin: 1.6rem 0 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-charcoal);
    font-variation-settings: 'opsz' 48;
  }
  .cw-beyond-copy {
    margin: 0.9rem 0 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-slate);
  }
  .cw-beyond-fig {
    margin: 0;
    overflow: hidden;
    border-radius: 13px;
    background: var(--color-cream);
  }
  .cw-beyond-fig img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* one grade across the set so the photos read as a family */
    filter: saturate(0.88) contrast(1.04);
  }

  @media (min-width: 920px) {
    .cw-beyond-tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem 1.6rem;
    }
  }
</style>
