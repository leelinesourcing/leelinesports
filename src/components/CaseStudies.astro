---
// Case studies — results-first.
// The previous layout ran 2,252px as three full-width image+ledger rows.
// Rebuilt so the number leads and the story supports it.
import { Image } from 'astro:assets'
import { r2 } from '../lib/images'

interface CaseStudy {
  img: string
  alt: string
  /** Category · market, set in small caps above the number. */
  kicker: string
  stat: string
  statLabel: string
  title: string
  /** One entry per sentence — each is set as its own paragraph. */
  detail: string[]
  attr: string
}

interface Props {
  eyebrow?: string
  lede?: string
  cases?: CaseStudy[]
}

const {
  eyebrow = 'Real results',
  lede = 'Three briefs that arrived as drawings and left as finished, inspected cartons.',
  cases = [
    {
      img: r2('compression-wear-amazon'),
      alt: 'Compression wear produced for a two-person Amazon brand',
      kicker: 'Compression wear · Amazon',
      stat: '0.4%',
      statLabel: 'defect rate, down from 6%',
      title: 'A two-person brand turned a sketch into three SKUs.',
      detail: [
        'No factory, no tech pack, no inventory knowledge — just a sketch and a deadline.',
        'We sourced the four-way stretch, built the pattern in-house and ran three SKUs at MOQ 200.',
        'Six months on, the brand was turning $40k a month on Amazon, each lot inspected to AQL 2.5 ahead of shipping.',
      ],
      attr: 'Founder, compression-wear label · Austin, TX',
    },
    {
      img: r2('team-apparel-crossfit-network'),
      alt: 'Sublimated team tees produced for a CrossFit box network',
      kicker: 'Team apparel · CrossFit network',
      stat: '10 days',
      statLabel: 'from PO to dispatched, XS–3XL',
      title: 'Four boxes needed matching tees in XS–3XL.',
      detail: [
        'Cracked prints after its first season, and a size range that stopped at XL.',
        'We moved them to heat-free sublimation dyed into the yarn, graded the pattern from XS to 3XL and ran 2,400 tees in a single pass.',
        'Delivered DDP in five weeks, with a repeat PO already on the books.',
      ],
      attr: 'Owner, 4-location box network · Phoenix, AZ',
    },
    {
      img: r2('swim-outdoor-upf-line'),
      alt: 'UPF 50+ swimwear produced for an outdoor swim brand',
      kicker: 'Swim & outdoor · UPF line',
      stat: 'Grade 4+',
      statLabel: 'colorfastness, up from Grade 2',
      title: 'A swimwear line that could not hold its colour.',
      detail: [
        'The old line was failing at Grade 2 under chlorine and customers were returning suits after a month.',
        'We rebuilt the fabric as a UPF 50+ knit, retested the dye lot to Grade 4+, and shipped 1,200 units by sea — landed DDP in 32 days, with the test report packed in the carton.',
      ],
      attr: 'Ops lead, outdoor swim brand · San Diego, CA',
    },
  ],
} = Astro.props
---

<section class="cw-cases cw-cv" id="cases">
  <div class="cw-wrap">
    <div class="cw-cases-head">
      <p class="cw-eyebrow" data-reveal="up">{eyebrow}</p>
      <h2 class="cw-h2" data-reveal="up" style="--rd:80ms">Sketch In.<br />Carton at the Dock.</h2>
      <p class="cw-lede" data-reveal="up" style="--rd:160ms">{lede}</p>
    </div>

    <div class="cw-case-grid">
      {cases.map((c, i) => (
        <article class="cw-case" data-reveal="up" style={`--rd:${i * 80}ms`}>
          <figure class="cw-case-fig">
            <Image
              src={c.img}
              alt={c.alt}
              width={550}
              height={525}
              widths={[275, 550]}
              sizes="(min-width: 760px) 33vw, 100vw"
              quality={80}
              loading="lazy"
              decoding="async"
            />
          </figure>

          <p class="cw-case-kicker">{c.kicker}</p>

          <p class="cw-case-stat">{c.stat}</p>
          <p class="cw-case-stat-label">{c.statLabel}</p>

          <h3 class="cw-case-title">{c.title}</h3>
          <div class="cw-case-detail">
            {c.detail.map((para) => <p>{para}</p>)}
          </div>

          <p class="cw-case-attr">{c.attr}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cw-cases {
    padding: 7rem 0 6rem;
    background: var(--color-cream);
  }
  .cw-cases-head {
    max-width: none;
  }
  .cw-cases-head .cw-lede {
    max-width: none;
  }

  .cw-case-grid {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  .cw-case {
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.4rem 1.6rem;
    background: var(--color-linen);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    border-radius: 20px;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.55s ease, border-color 0.35s ease;
  }
  .cw-case:hover {
    transform: translateY(-5px);
    box-shadow: 0 38px 74px -48px color-mix(in srgb, var(--color-ink) 52%, transparent);
    border-color: color-mix(in srgb, var(--color-steel) 30%, transparent);
  }
  .cw-case-fig {
    margin: 0 0 1.35rem;
    overflow: hidden;
    border-radius: 13px;
    background: var(--color-linen);
  }
  .cw-case-fig img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.03);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cw-case:hover .cw-case-fig img {
    transform: scale(1.05);
  }
  .cw-case-kicker {
    margin: 0;
    font-size: 0.81rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-berry);
  }
  .cw-case-stat {
    margin: 0.7rem 0 0;
    font-family: var(--font-heading);
    font-weight: 620;
    font-size: clamp(2.6rem, 5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--color-steel);
    font-variation-settings: 'opsz' 96;
  }
  .cw-case-stat-label {
    margin: 0.45rem 0 0;
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--color-slate);
  }
  .cw-case-title {
    margin: 1.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.14rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-charcoal);
    font-variation-settings: 'opsz' 40;
  }
  .cw-case-detail {
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .cw-case-detail p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-slate);
  }
  .cw-case-attr {
    margin: auto 0 0;
    padding-top: 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-slate);
    opacity: 0.85;
  }

  @media (min-width: 760px) {
    .cw-case-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
