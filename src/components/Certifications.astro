---
// Certifications & test standards.
// Layout: certificate image above the copy. Rebuilt text-first from the original
// three full-height scans, then the image was sized back up to 184px so the
// document is legible without burying the claim below it.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import certificate1 from '../assets/images/certificate-1.webp'
import certificate2 from '../assets/images/certificate-2.webp'
import certificate3 from '../assets/images/certificate-3.webp'
import markIso from '../assets/images/mark-ISO.webp'
import markIsoAlt from '../assets/images/mark-ISO-alt.webp'
import markBsci from '../assets/images/mark-bsci.webp'
import markGots from '../assets/images/mark-gots.webp'

interface Certificate {
  code: string
  label: string
  body: string
  img: ImageMetadata
}

interface Standard {
  code: string
  label: string
  /** The mark shown beside the code. */
  mark: ImageMetadata
}

interface Props {
  eyebrow?: string
  heading?: string
  lede?: string
  certs?: Certificate[]
  /** The standards run on every order. */
  standards?: Standard[]
  note?: string
}

const {
  eyebrow = 'Certified & Audited',
  heading = 'Standards You Can Verify.',
  lede = 'No clause buried in a PO. Nothing below is a claim without a certificate or a test behind it — and the paperwork travels with your shipment.',
  certs = [
    {
      code: 'OEKO-TEX® Standard 100',
      label: 'Tested for harmful substances',
      body: 'All fabric batches tested for harmful substances ahead of cutting.',
      img: certificate1,
    },
    {
      code: 'ISO 9001:2015',
      label: 'Quality management system',
      body: 'Certified quality management across sourcing, production and inspection.',
      img: certificate2,
    },
    {
      code: 'CE',
      label: 'Certificate of conformity',
      body: 'Independent conformity testing for documented EU market access.',
      img: certificate3,
    },
  ],
  standards = [
    // No body publishes a mark for AQL, so a stand-in image is used for now.
    { code: 'AQL 2.5 / 4.0', label: 'Inspection standard', mark: markGots },
    { code: 'ISO 5077', label: 'Dimensional stability', mark: markIso },
    { code: 'ISO 105', label: 'Colorfastness', mark: markIsoAlt },
    { code: 'BSCI', label: 'Social compliance audit', mark: markBsci },
  ],
  note = 'Certificates and test reports are available on request before you place a bulk order.',
} = Astro.props
---

<section class="cw-certs cw-cv" id="certifications">
  <div class="cw-wrap">
    <div class="cw-certs-head">
      <p class="cw-eyebrow" data-reveal="up">{eyebrow}</p>
      <h2 class="cw-h2" data-reveal="up" style="--rd:80ms">{heading}</h2>
      <p class="cw-lede" data-reveal="up" style="--rd:160ms">{lede}</p>
    </div>

    <div class="cw-certs-grid">
      {certs.map((c, i) => (
        <a
          class="cw-cert"
          href={c.img.src}
          target="_blank"
          rel="noopener"
          data-reveal="up"
          style={`--rd:${i * 70}ms`}
        >
          <figure class="cw-cert__thumb">
            <Image
              src={c.img}
              alt={`${c.code} certificate`}
              width={800}
              height={1000}
              quality={80}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="cw-cert__body">
            <span class="cw-cert__code">{c.code}</span>
            <span class="cw-cert__label">{c.label}</span>
            <p class="cw-cert__text">{c.body}</p>
            <span class="cw-cert__link">View certificate <span aria-hidden="true">&#8599;</span></span>
          </div>
        </a>
      ))}
    </div>

    <div class="cw-certs-standards" data-reveal="up">
      <span class="cw-certs-standards__title">Also run on every order</span>
      <ul>
        {standards.map((s) => (
          <li>
            <Image
              class="cw-std-mark"
              src={s.mark}
              alt=""
              width={92}
              height={92}
              quality={80}
              loading="lazy"
              decoding="async"
            />
            <span class="cw-std-text">
              <span class="cw-std-code">{s.code}</span>
              <span class="cw-std-label">{s.label}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <p class="cw-certs-note" data-reveal="up">{note}</p>
  </div>
</section>

<style>
  .cw-certs {
    padding: 6.5rem 0 6rem;
    background: var(--color-linen);
  }
  .cw-certs-head {
    max-width: none;
  }
  .cw-certs-head .cw-lede {
    max-width: none;
  }

  .cw-certs-grid {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .cw-cert {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 1.4rem 1.4rem 1.55rem;
    background: var(--color-cream);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    border-radius: 18px;
    text-decoration: none;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.55s ease, border-color 0.35s ease;
  }
  .cw-cert:hover {
    transform: translateY(-5px);
    box-shadow: 0 34px 66px -46px color-mix(in srgb, var(--color-ink) 50%, transparent);
    border-color: color-mix(in srgb, var(--color-steel) 30%, transparent);
  }
  /* the scan is proof, not the headline — sized so the document reads
     without the copy being pushed out of view */
  .cw-cert__thumb {
    margin: 0;
    width: 184px;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
    background: var(--color-paper);
  }
  .cw-cert__thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cw-cert:hover .cw-cert__thumb img {
    transform: scale(1.04);
  }

  .cw-cert__code {
    display: block;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.3rem;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-charcoal);
    font-variation-settings: 'opsz' 48;
  }
  .cw-cert__label {
    display: block;
    margin-top: 0.28rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 420;
    font-size: 0.97rem;
    color: var(--color-berry);
  }
  .cw-cert__text {
    margin: 0.75rem 0 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-slate);
  }
  .cw-cert__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.85rem;
    font-size: 0.90rem;
    font-weight: 700;
    color: var(--color-steel);
  }
  .cw-cert__link span {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cw-cert:hover .cw-cert__link span {
    transform: translate(2px, -2px);
  }

  .cw-certs-standards {
    margin-top: 1.5rem;
    padding: 1.75rem 1.6rem;
    background: var(--color-cream);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    border-radius: 18px;
  }
  .cw-certs-standards__title {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 420;
    font-size: 0.97rem;
    color: var(--color-berry);
  }
  .cw-certs-standards ul {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem 1.5rem;
  }
  .cw-certs-standards li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  /* The mark is decorative — the code beside it carries the meaning. */
  .cw-std-mark {
    flex: none;
    width: 2.9rem;
    height: 2.9rem;
    object-fit: contain;
  }
  .cw-std-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .cw-std-code {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.08rem;
    letter-spacing: -0.015em;
    color: var(--color-charcoal);
  }
  .cw-std-label {
    font-size: 0.92rem;
    color: var(--color-slate);
  }

  .cw-certs-note {
    margin: 1.75rem 0 0;
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--color-slate);
  }

  @media (min-width: 620px) {
    .cw-certs-standards ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 940px) {
    .cw-certs-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.4rem;
    }
    .cw-cert {
      padding: 1.5rem 1.5rem 1.7rem;
      gap: 1.25rem;
    }
    .cw-certs-standards ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
