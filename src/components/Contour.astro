---
// Concentric "contour" mark — the eyebrow ornament beside section kickers.
// Tinted via `text-*` utilities; the centre dot pulls the berry accent.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className = '' } = Astro.props;
---
<svg
  class:list={['contour', className]}
  viewBox="0 0 128 128"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
>
  <circle class="c-ring c-ring--a" cx="66" cy="62" r="53" />
  <circle class="c-ring c-ring--b" cx="67" cy="64" r="40" />
  <circle class="c-ring c-ring--c" cx="68" cy="66" r="27" />
  <circle class="c-ring c-ring--d" cx="69" cy="68" r="15" />
  <circle class="c-dot" cx="70" cy="70" r="3.4" />
</svg>

<style>
  .contour {
    display: block;
    overflow: visible;
  }
  .c-ring {
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .c-ring--a { opacity: 0.28; }
  .c-ring--b { opacity: 0.42; }
  .c-ring--c { opacity: 0.62; }
  .c-ring--d { opacity: 0.9; stroke-width: 1.7; }
  .c-dot {
    fill: var(--color-berry);
  }
</style>
