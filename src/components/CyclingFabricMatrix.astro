---
// The build matrix — a real specification table.
//
// Nothing else on the site publishes parameters in tabular form, and per the
// competitive scan none of the seven reference manufacturers publish fabric
// weights at all. So this is the strongest unclaimed asset on the page, and it
// covers entity dimension 2 (parameters), which no existing page does.
//
// It is a datasheet, not the homepage's WhyUs comparison table: no check marks,
// no highlighted column, no raised plate. Rows are garments and the cells are
// values a buyer would otherwise have to email and ask for.
//
// Weights are standard ranges for each garment category, not measured figures —
// confirm against actual stock before launch.
import SectionHead from './SectionHead.astro'

interface Row {
  garment: string
  fabric: string
  weight: string
  stretch: string
  uv: string
  chamois: string
}

interface Props {
  kicker?: string
  heading?: string
  lede?: string
  note?: string
  rows?: Row[]
}

const {
  kicker = 'Build spec',
  heading = 'The Specification, Before You Ask For It.',
  lede = 'Every garment we quote is built to a fixed combination of fabric, weight and construction. This is that combination for the full kit — the sheet a sourcing lead usually has to email three suppliers to get.',
  note = 'Recycled polyester to GRS and OEKO-TEX certified stock are available on every row, and every cell above is confirmed in writing on the quote.',
  rows = [
    {
      garment: 'Jersey, short sleeve',
      fabric: 'Single jersey / Interlock',
      weight: '130–160 GSM',
      stretch: '4-way',
      uv: 'UPF 50+',
      chamois: '—',
    },
    {
      garment: 'Jersey, long sleeve',
      fabric: 'Single jersey',
      weight: '150–180 GSM',
      stretch: '4-way',
      uv: 'UPF 50+',
      chamois: '—',
    },
    {
      garment: 'Bib shorts',
      fabric: 'Lycra / spandex blend',
      weight: '200–240 GSM',
      stretch: '4-way',
      uv: 'UPF 50+',
      chamois: 'Multi-density',
    },
    {
      garment: 'Waist shorts',
      fabric: 'Lycra / spandex blend',
      weight: '200–240 GSM',
      stretch: '4-way',
      uv: 'UPF 50+',
      chamois: 'Multi-density',
    },
    {
      garment: 'Skinsuit',
      fabric: 'Lycra / spandex blend',
      weight: '180–220 GSM',
      stretch: '4-way',
      uv: 'UPF 50+',
      chamois: 'Multi-density',
    },
    {
      garment: 'Gilet / vest',
      fabric: 'Stretch woven',
      weight: '90–120 GSM',
      stretch: '2-way',
      uv: 'UPF 50+',
      chamois: '—',
    },
    {
      garment: 'Jacket',
      fabric: 'Bonded softshell',
      weight: '260–320 GSM',
      stretch: '4-way',
      uv: '—',
      chamois: '—',
    },
    {
      garment: 'Windbreaker',
      fabric: 'Ripstop nylon',
      weight: '40–60 GSM',
      stretch: 'None',
      uv: 'UPF 50+',
      chamois: '—',
    },
    {
      garment: 'Base layers & gloves',
      fabric: 'Seamless knit',
      weight: '140–170 GSM',
      stretch: '4-way',
      uv: 'UPF 50+',
      chamois: '—',
    },
    {
      garment: 'Leg & arm warmers',
      fabric: 'Brushed-back Lycra',
      weight: '220–260 GSM',
      stretch: '4-way',
      uv: 'UPF 50+',
      chamois: '—',
    },
    {
      garment: 'Socks',
      fabric: 'Nylon / elastane knit',
      weight: '—',
      stretch: '2-way',
      uv: 'UPF 50+',
      chamois: '—',
    },
  ],
} = Astro.props
---

<section class="cw-matrix" id="fabric">
  <div class="cw-wrap">
    <SectionHead kicker={kicker} lead={lede}>{heading}</SectionHead>

    <!-- Standfirst, not a <caption>. The table has a 860px min-width and scrolls
         sideways on a phone; a caption is part of the table box, so it would be
         clipped off the right edge with everything else. Outside the scroller it
         wraps to the visible width and is readable at every size. -->
    <p class="cw-matrix-standfirst">
      Fabric, weight and construction by garment. Minimum order is 100 pieces per style across every row.
    </p>

    <div class="cw-matrix-scroll" tabindex="0" role="region" aria-label="Cycling garment specification table">
      <table class="cw-matrix-table">
        <thead>
          <tr>
            <th scope="col">Garment</th>
            <th scope="col">Fabric</th>
            <th scope="col">Weight</th>
            <th scope="col">Stretch</th>
            <th scope="col">UV</th>
            <th scope="col">Chamois</th>
            <th scope="col">MOQ</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.garment}</th>
              <td>{r.fabric}</td>
              <td class="cw-matrix-num">{r.weight}</td>
              <td>{r.stretch}</td>
              <td>{r.uv}</td>
              <td>{r.chamois}</td>
              <td class="cw-matrix-num">100</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="cw-matrix-note">{note}</p>
  </div>
</section>

<style>
  .cw-matrix {
    background: var(--color-paper);
    padding: 7rem 0 6.5rem;
  }
  .cw-matrix :global(.sec-head) {
    max-width: none;
  }
  .cw-matrix :global(.sec-lead) {
    max-width: none;
  }

  .cw-matrix-standfirst {
    margin: 2.6rem 0 0;
    max-width: 70ch;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-slate);
  }

  .cw-matrix-scroll {
    margin-top: 1.2rem;
    /* Below 900px the table is wider than the screen and scrolls sideways rather
       than squashing its columns into unreadable ribbons. */
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border: 1px solid color-mix(in srgb, var(--color-steel) 18%, transparent);
    border-radius: 18px 18px 18px 5px;
  }
  .cw-matrix-scroll:focus-visible {
    outline: 2px solid var(--color-berry);
    outline-offset: 3px;
  }

  .cw-matrix-table {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
    text-align: left;
  }

  .cw-matrix-table th,
  .cw-matrix-table td {
    padding: 1rem 1.6rem;
    font-size: 0.94rem;
    line-height: 1.45;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in srgb, var(--color-steel) 13%, transparent);
  }
  .cw-matrix-table tbody tr:last-child th,
  .cw-matrix-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .cw-matrix-table thead th {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    /* steel: small text on a light ground */
    color: var(--color-steel);
    background: var(--color-cream);
    border-bottom: 1px solid color-mix(in srgb, var(--color-steel) 22%, transparent);
    white-space: nowrap;
  }

  .cw-matrix-table tbody th {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1rem;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 48;
    color: var(--color-charcoal);
    white-space: nowrap;
  }
  .cw-matrix-table tbody td {
    color: var(--color-slate);
  }

  /* Weights and the MOQ column are values, so they take the heading face. */
  .cw-matrix-num {
    font-family: var(--font-heading);
    font-variation-settings: 'opsz' 48;
    color: var(--color-charcoal);
    white-space: nowrap;
  }

  .cw-matrix-table tbody tr {
    transition: background-color 0.3s ease;
  }
  .cw-matrix-table tbody tr:hover {
    background: color-mix(in srgb, var(--color-linen) 60%, transparent);
  }

  .cw-matrix-note {
    margin: 1.5rem 0 0;
    max-width: 62ch;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-steel);
  }
</style>
