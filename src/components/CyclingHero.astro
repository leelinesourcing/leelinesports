---
// Cycling hero — a split, not a veil.
//
// Both existing heroes (Hero.astro, GolfHero.astro) are full-bleed photographs
// under a steel→ink gradient with the copy sitting on top. Doing that a third
// time would make this page read as the golf page in different colours, so the
// photograph here is bright and unveiled and the copy sits on a flat denim panel
// beside it.
//
// The side effect is the useful one: because no text ever sits on the
// photograph, the contrast ceiling that forces every other hero to abandon berry
// does not apply. Berry is still spent on exactly one thing — the CTA.
import { r2 } from '../lib/images'
import Button from './Button.astro'

interface Props {
  kicker?: string
  /** The brand half of the headline, set in paper. */
  headingLead?: string
  /** The benefit half, set in gold. See the accent note under the H1 styles. */
  headingAccent?: string
  sub?: string
  ctaLabel?: string
  ctaHref?: string
  image?: string
  imageAlt?: string
}

const {
  kicker = 'Airflow You Can Feel, A Fit You Can Trust!',
  // The 40% breathability and the 10 years are marketing claims with nothing
  // behind them: no test report, no date. The dry rate carries no number on
  // purpose — the homepage's moisture-wicking card (Services.astro) says the
  // fabric "dries in minutes, not hours", so a "3-second" figure here would
  // contradict it, and that card is locked. This is the side that gives.
  headingLead = 'Expert Cycling Apparel Manufacturers:',
  headingAccent = '40% Better Breathability for a Perfect, Second-Skin Fit',
  sub = 'Backed by 10 years of manufacturing excellence, we source advanced moisture-wicking textiles with an ultra-fast dry rate. Let us build your next bestselling collection with lightweight apparel designed to move flawlessly with the body.',
  ctaLabel = 'Get a cycling quote',
  ctaHref = '#quote',
  image = r2('cycling-hero'),
  imageAlt = 'Road cyclist riding in a custom-manufactured cycling jersey and bib shorts',
} = Astro.props
---

<section class="cw-cyhero" id="top" data-hero>
  <div class="cw-cyhero-grid">
    <div class="cw-cyhero-copy">
      <p class="cw-cyhero-kicker cw-hero-item" style="--rd:0ms">{kicker}</p>

      <h1 class="cw-cyhero-h1 cw-hero-item" style="--rd:90ms">
        {headingLead} <span class="cw-cyhero-accent">{headingAccent}</span>
      </h1>

      <p class="cw-cyhero-sub cw-hero-item" style="--rd:200ms">{sub}</p>

      <div class="cw-cyhero-action cw-hero-item" style="--rd:300ms">
        <Button href={ctaHref}>{ctaLabel}</Button>
      </div>
    </div>

    <figure class="cw-cyhero-fig">
      <img
        src={image}
        alt={imageAlt}
        width={2000}
        height={1333}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </figure>
  </div>
</section>

<style>
  .cw-cyhero {
    background: var(--color-denim);
    /* Above the nav's transparent height so the solid bar has ground to sit on. */
    padding-top: 5.5rem;
  }

  .cw-cyhero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .cw-cyhero-copy {
    /*
      Align the copy's left edge with .cw-wrap without nesting one, because the
      photograph in the next column has to reach the viewport edge. This
      reproduces .cw-wrap's own maths: its gutter plus whatever margin the
      1240px cap leaves over.
    */
    padding: 3.5rem calc(max(0px, (100vw - 1240px) / 2) + clamp(1.25rem, 4vw, 2rem)) 3.75rem;
  }

  .cw-cyhero-kicker {
    margin: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 420;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    /* paper, not cream: the extra luminance is the most contrast available here */
    color: var(--color-paper);
  }

  .cw-cyhero-h1 {
    margin: 1.1rem 0 0;
    font-family: var(--font-heading);
    font-weight: 620;
    /* Sized for a 90-character headline sharing its row with the photograph.
       At the 3.4rem this started on it ran to eight lines and pushed the CTA
       below the fold on a laptop; 2.7rem holds it to five or six. */
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    /* 1.09 rather than the 1 this started on: at display size Fraunces sets its
       ascenders and descenders tight enough that flush lines read as a block.
       The letter-spacing is tracking of -0.01em, not the -0.03em it opened with,
       which was closing the gaps inside words as well as between them. */
    line-height: 1.09;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 120, 'SOFT' 40;
    color: var(--color-paper);
    text-wrap: balance;
  }
  /*
    The benefit half of the headline takes the warm accent.

    Gold and not berry: berry is the site's usual accent, but it measures 1.13:1
    on this denim panel and simply cannot be read here. Gold is 4.6:1 on denim —
    past the 4.5:1 bar, and the H1 is display size where 3:1 is the floor.

    The colour is emphasis only. The sentence reads complete without it, so
    nothing is lost if the colour is not perceived.
  */
  .cw-cyhero-accent {
    color: var(--color-gold);
  }

  .cw-cyhero-sub {
    margin: 1.35rem 0 0;
    /* Deliberately looser than a comfortable body measure. The column is already
       the tighter constraint at every breakpoint, so this only stops the lede
       from running the full width on the widest screens. */
    max-width: 58ch;
    font-size: 1.08rem;
    line-height: 1.64;
    color: color-mix(in srgb, var(--color-cream) 76%, transparent);
  }

  .cw-cyhero-action {
    margin-top: 2.2rem;
  }

  .cw-cyhero-fig {
    margin: 0;
    overflow: hidden;
    /* 16/11 on a phone: tall enough to read as a hero, short enough that the
       headline is still the first thing in view below the nav. */
    aspect-ratio: 16 / 11;
  }
  .cw-cyhero-fig img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The rider sits left of centre in the frame; cover-cropping from the middle
       would push them out of the column. */
    object-position: 35% 50%;
    filter: saturate(0.9) contrast(1.03);
  }

  @media (min-width: 880px) {
    .cw-cyhero {
      padding-top: 0;
    }
    .cw-cyhero-grid {
      /* Even halves. The photograph was on the smaller share so the headline
         could run long, but the frame is portrait once the hero is tall, and a
         3:2 photograph in a portrait frame loses about a third of its width to
         the cover crop — the rider ends up cropped to a strip. Widening the
         frame is the only lever that shows more of the picture without trimming
         the hero's height, so the copy gives the width back instead.
         The 26rem floor still protects the rider on a small laptop. */
      grid-template-columns: minmax(0, 1fr) minmax(26rem, 50%);
      align-items: stretch;
      /* Tall enough that the hero reads as the page's opening statement rather
         than a band of copy: the copy is vertically centred, so this buys air
         above and below it in equal measure. Raised from 41rem on the user's
         read that the section still arrived short. */
      min-height: 46rem;
    }
    .cw-cyhero-copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 9rem;
      padding-bottom: 6rem;
      padding-inline-end: clamp(2rem, 3vw, 3.5rem);
    }
    .cw-cyhero-fig {
      aspect-ratio: auto;
      min-height: 46rem;
    }
  }
</style>
