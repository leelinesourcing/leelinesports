---
// Reviews as quote rows, not cards.
//
// Testimonials.astro is a denim pull-quote card beside two cream cards with
// circular avatars. GolfReviews.astro is two paper cards with a gold star row
// and a justified first line. A third card treatment would read as padding, so
// these are bare rows: a hairline between each, the attribution held in a narrow
// left column, and the quote given the full measure of the page in the heading
// face. No card, no border, no shadow.
//
// cw-cv is safe here: nothing in the nav or the footer anchors to #reviews.
import { reviewHead, reviews } from '../data/cycling-reviews'
import SectionHead from './SectionHead.astro'

interface Props {
  kicker?: string
  heading?: string
  lede?: string
}

const { kicker = reviewHead.kicker, heading = reviewHead.heading, lede = reviewHead.lede } =
  Astro.props
---

<!-- No cw-cv here. The quote rows are data-reveal children, so the browser has to
     have their real geometry before the observer can decide they are visible.
     Paint-skipping the section left them stuck at opacity 0. -->
<section class="cw-cyrev" id="reviews">
  <div class="cw-wrap">
    <SectionHead kicker={kicker} lead={lede}>{heading}</SectionHead>

    <ul class="cw-cyrev-list">
      {reviews.map((r, i) => (
        <li class="cw-cyrev-row" data-reveal="up" style={`--rd:${i * 80}ms`}>
          <figure class="cw-cyrev-attrib">
            {r.avatar ? (
              <img
                class="cw-cyrev-photo"
                src={r.avatar}
                alt={r.alt ?? ''}
                width={120}
                height={120}
                loading="lazy"
                decoding="async"
              />
            ) : (
              /* Placeholder for a review with no photograph supplied. A monogram,
                 not a stock face — putting a stranger's picture under a named
                 customer is a fabricated endorsement. Swap in the real photo
                 when it arrives. */
              <span class="cw-cyrev-photo cw-cyrev-blank" aria-hidden="true">
                {r.name.trim().charAt(0)}
              </span>
            )}
            <figcaption class="cw-cyrev-who">
              <span class="cw-cyrev-name">{r.name}</span>
              <span class="cw-cyrev-role">{r.role}</span>
            </figcaption>
          </figure>

          <blockquote class="cw-cyrev-quote">
            {r.quote.split('\n').map((para) => <p>{para}</p>)}
          </blockquote>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cw-cyrev {
    background: var(--color-cream);
    padding: 7rem 0 6.5rem;
  }
  .cw-cyrev :global(.sec-head) {
    max-width: none;
  }
  .cw-cyrev :global(.sec-lead) {
    max-width: none;
  }

  .cw-cyrev-list {
    margin: 3.2rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 22%, transparent);
  }

  .cw-cyrev-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.4rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
  }

  .cw-cyrev-attrib {
    margin: 0;
  }
  .cw-cyrev-photo {
    display: block;
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 22px 22px 22px 6px;
    border: 1px solid color-mix(in srgb, var(--color-steel) 20%, transparent);
    filter: saturate(0.88) contrast(1.03);
  }
  /* The placeholder that stands in when no photograph was supplied: the same
     88px box as a real one, so the row keeps its shape. */
  .cw-cyrev-blank {
    display: grid;
    place-items: center;
    background: var(--color-linen);
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-steel);
  }

  .cw-cyrev-who {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  /* Only stand the name off the photograph when there is one. */
  .cw-cyrev-photo + .cw-cyrev-who {
    margin-top: 0.85rem;
  }
  .cw-cyrev-name {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-variation-settings: 'opsz' 48;
    color: var(--color-charcoal);
  }
  .cw-cyrev-role {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 420;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-steel);
  }

  .cw-cyrev-quote {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    /* Down from a 1.42rem max, then down again to 1.05rem. These are buyer
       reviews, not pull quotes — the section's weight belongs to the names and
       the standard badges, and at display size the longer quotes ran to a wall
       of type. Slightly above the golf reviews' 1rem: this column is a full
       container wide rather than half of one. */
    font-size: clamp(0.94rem, 1.4vw, 1.05rem);
    line-height: 1.62;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 48;
    color: var(--color-charcoal);
    /* Justified, with the same hyphens: auto the golf reviews use. Justification
       without it stretches inter-word space until the gaps line up into rivers
       down the column. It works because Layout sets lang="en". */
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  /* Paragraphs are marked by the indent alone, the way the golf reviews do it —
     no gap between them, so the indent is doing the separating. */
  .cw-cyrev-quote p {
    margin: 0;
    text-indent: 2em;
  }

  @media (min-width: 760px) {
    .cw-cyrev-row {
      /* Attribution holds a narrow column so the quote gets the full measure —
         the reverse of the two card treatments already on the site.
         Centred rather than top-aligned: the longer quotes run to six lines, and
         a photo pinned to the top of that reads as detached from the words it
         belongs to. */
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3rem;
      padding: 3rem 0;
      align-items: center;
    }
  }
</style>
