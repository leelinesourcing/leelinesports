---
// Sample-to-bulk timeline — a dated track.
//
// The site's other process block (Process.astro) is a sticky vertical ledger of
// numbered rows. This is the same information as a dimension line: five gates
// on one horizontal rail, each carrying the day range it actually occupies. The
// point is that the dates are on the page — per the competitive scan, only one
// of seven reference manufacturers commits to any lead time at all, and none
// publishes a sample duration.
//
// Horizontal on desktop, a vertical rail on a phone: five columns of this copy
// at 375px would be unreadable, and rotating the rail is truer to the content
// than dropping the dates.
import SectionHead from './SectionHead.astro'

interface Stage {
  /** The day range, e.g. 'Day 3–7'. */
  day: string
  title: string
  detail: string
}

interface Props {
  kicker?: string
  heading?: string
  lede?: string
  stages?: Stage[]
}

const {
  kicker = 'Sample to bulk',
  heading = 'Day by Day, From Sketch to Delivered.',
  lede = 'Most factories will not put a date on anything until you have paid a deposit. Here is the sequence we work to, including the week where nothing moves but your approval.',
  stages = [
    {
      day: 'Day 0–2',
      title: 'Brief and mockup',
      detail:
        'You send the sketch or tech pack. We return a digital mockup in your Pantone colours plus a DDP quote with the MOQ confirmed in writing.',
    },
    {
      day: 'Day 3–5',
      title: 'Strike-off proof',
      detail:
        'A printed panel proof goes out, so the colour is agreed on fabric rather than on a backlit screen. This is where most colour disputes get settled before they exist.',
    },
    {
      day: 'Day 7',
      title: 'Fit sample',
      detail:
        'A sewn sample is couriered to you. The sample fee comes off your bulk invoice, so seeing the kit first costs you nothing but the week.',
    },
    {
      day: 'Day 10',
      title: 'Size set approved',
      detail:
        'You sign off the grade rules across the full size run. Nothing is cut until this gate is passed.',
    },
    {
      day: 'Day 35–45',
      title: 'Bulk and inspection',
      detail:
        'Twenty-five to thirty-five days of production, then inspection to AQL 2.5 major and 4.0 minor with a man-in-plant and photo evidence before the carton is sealed.',
    },
  ],
} = Astro.props
---

<section class="cw-tl" id="timeline">
  <div class="cw-wrap">
    <SectionHead kicker={kicker} lead={lede}>{heading}</SectionHead>

    <ol class="cw-tl-list">
      {stages.map((s, i) => (
        <li class="cw-tl-item" data-reveal="up" style={`--rd:${i * 70}ms`}>
          <span class="cw-tl-node" aria-hidden="true"></span>
          <p class="cw-tl-day">{s.day}</p>
          <h3 class="cw-tl-title">{s.title}</h3>
          <p class="cw-tl-detail">{s.detail}</p>
        </li>
      ))}
    </ol>

    <p class="cw-tl-transit">
      Then transit, DDP with duties paid: <strong>express 3–5 days</strong>, air freight 7–12, sea freight 25–40. We quote all three landed so you can compare them on cost rather than on guesswork.
    </p>
  </div>
</section>

<style>
  .cw-tl {
    background: var(--color-cream);
    padding: 7rem 0 6.5rem;
  }
  .cw-tl :global(.sec-head) {
    max-width: none;
  }
  .cw-tl :global(.sec-lead) {
    max-width: none;
  }

  /* ── the rail ─────────────────────────────────────────── */
  .cw-tl-list {
    position: relative;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Vertical on a phone: the rail runs down the left of the stack. */
  .cw-tl-list::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 2rem;
    width: 1px;
    background: color-mix(in srgb, var(--color-steel) 26%, transparent);
  }

  .cw-tl-item {
    position: relative;
    padding-inline-start: 2.2rem;
    padding-bottom: 2rem;
  }
  .cw-tl-item:last-child {
    padding-bottom: 0;
  }

  /* Cream, not transparent: the node has to mask the rail it sits on. */
  .cw-tl-node {
    position: absolute;
    left: 0;
    top: 3px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--color-cream);
    border: 1.5px solid var(--color-berry);
  }
  .cw-tl-node::after {
    content: '';
    position: absolute;
    inset: 3.5px;
    border-radius: 50%;
    background: var(--color-berry);
  }

  .cw-tl-day {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 620;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 48;
    color: var(--color-steel);
  }
  .cw-tl-title {
    margin: 0.35rem 0 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.24rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 48;
    color: var(--color-charcoal);
  }
  .cw-tl-detail {
    margin: 0.5rem 0 0;
    font-size: 0.96rem;
    line-height: 1.62;
    color: var(--color-slate);
  }

  .cw-tl-transit {
    margin: 2.8rem 0 0;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 20%, transparent);
    max-width: 78ch;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-slate);
  }
  .cw-tl-transit strong {
    font-weight: 700;
    color: var(--color-charcoal);
  }

  /* ── the rail, laid flat ──────────────────────────────── */
  @media (min-width: 820px) {
    .cw-tl-list {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0 1.6rem;
    }
    /* One rule across the top, at the nodes' vertical centre. */
    .cw-tl-list::before {
      left: 0;
      right: 0;
      top: 7px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .cw-tl-item {
      padding-inline-start: 0;
      padding-top: 2.1rem;
      padding-bottom: 0;
    }
    .cw-tl-node {
      left: 0;
      top: 0;
    }
  }
</style>
