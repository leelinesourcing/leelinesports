---
// Product mosaic, matching the published range one for one.
//
// The order and the count are the legacy site's: jerseys, bib shorts, vests,
// jackets, windbreakers, skinsuits, socks, leg warmers, caps — nine garments,
// three to a row. Gloves were carried here but are not part of the published
// range, so they are gone; do not add a tenth back without the range changing
// alongside it.
import { r2 } from '../lib/images'
import SectionHead from './SectionHead.astro'

interface Garment {
  name: string
  note: string
  img: string
  alt: string
}

interface Props {
  kicker?: string
  heading?: string
  lede?: string
  garments?: Garment[]
}

const {
  kicker = 'What we make',
  heading = 'The Whole Kit, From One Production Line.',
  lede = 'Nine garments your buyers actually order, from the race jersey down to the cap. Every one comes off the same line, to the same tolerance sheet and the same inspection standard.',
  garments = [
    {
      name: 'Custom Cycling Jerseys',
      note: 'Sublimated panels in your Pantone colours, flatlock-stitched, with a full-length YKK zip and a silicone waist gripper.',
      img: r2('cycling-jersey'),
      alt: 'Custom cycling jersey with sublimated team graphics and a full-length zip',
    },
    {
      name: 'Custom Cycling Bib Shorts',
      note: 'Four-way stretch Lycra at 220 GSM with a multi-density chamois, laser-cut leg openings and silicone grippers.',
      img: r2('cycling-bib-shorts'),
      alt: 'Custom cycling bib shorts in four-way stretch Lycra with a multi-density chamois',
    },
    {
      name: 'Custom Cycling Vests',
      note: 'Packable wind blocking with a mesh back panel and a full-length zip, sized to layer over a jersey.',
      img: r2('cycling-vest'),
      alt: 'Custom cycling gilet with a mesh back panel',
    },
    {
      name: 'Custom Cycling Jackets',
      note: 'Thermal front, breathable back and taped seams, cut as a shoulder-season layer rather than a rain shell.',
      img: r2('cycling-jacket'),
      alt: 'Custom cycling jacket with a thermal front panel',
    },
    {
      name: 'Custom Cycling Windbreakers',
      note: 'A featherweight shell that folds into its own rear pocket — wind-resistant and light enough to forget.',
      img: r2('cycling-windbreaker'),
      alt: 'Custom packable cycling windbreaker',
    },
    {
      name: 'Custom Cycling Skinsuits',
      note: 'Seamless aero panels cut in one piece, with no pockets or gripper bands to break the surface.',
      img: r2('cycling-skinsuit'),
      alt: 'Custom cycling skinsuit with seamless aerodynamic panels',
    },
    {
      name: 'Custom Cycling Socks',
      note: 'Compression cuff, cushioned sole and a knitted crest, knitted to the height and banding you set.',
      img: r2('cycling-socks'),
      alt: 'Custom cycling socks with a knitted logo and compression cuff',
    },
    {
      name: 'Custom Cycling Leg Warmers',
      note: 'Brushed back for shoulder season with a gripper top, cut to match the bib shorts so the join sits flush.',
      img: r2('cycling-leg-warmers'),
      alt: 'Custom cycling leg warmers in brushed-back fabric',
    },
    {
      name: 'Custom Cycling Caps',
      note: 'Four-panel cotton twill with a wicking band, printed or embroidered to your mark in your colourway.',
      img: r2('cycling-cap'),
      alt: 'Custom four-panel cycling cap with a printed design',
    },
  ],
} = Astro.props
---

<section class="cw-cytypes" id="types">
  <div class="cw-wrap">
    <SectionHead kicker={kicker} lead={lede}>{heading}</SectionHead>

    <ul class="cw-cytypes-grid">
      {garments.map((g, i) => (
        <li class="cw-cytypes-item" data-reveal="up" style={`--rd:${(i % 3) * 70}ms`}>
          <figure class="cw-cytypes-fig">
            <img src={g.img} alt={g.alt} width={560} height={535} loading="lazy" decoding="async" />
          </figure>
          <h3 class="cw-cytypes-name">{g.name}</h3>
          <p class="cw-cytypes-note">{g.note}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cw-cytypes {
    background: var(--color-linen);
    padding: 7rem 0 6.5rem;
  }
  /* The section head runs the full container width, as on every other page. */
  .cw-cytypes :global(.sec-head) {
    max-width: none;
  }
  .cw-cytypes :global(.sec-lead) {
    max-width: none;
  }

  .cw-cytypes-grid {
    margin: 3.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    /* Two on a phone, three from 620px up and never four — the row count is a
       deliberate match to the published range, not a responsive accident. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.4rem 1.4rem;
  }
  .cw-cytypes-item {
    min-width: 0;
  }
  .cw-cytypes-fig {
    margin: 0;
    overflow: hidden;
    /* paper: the product shots are cut out on white and would show a seam on
       cream */
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    border-radius: 22px 22px 22px 7px;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.55s ease, border-color 0.35s ease;
  }
  .cw-cytypes-item:hover .cw-cytypes-fig {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--color-steel) 30%, transparent);
    box-shadow: 0 34px 66px -46px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }
  .cw-cytypes-fig img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.03);
    transition: transform 0.9s var(--ease), filter 0.9s var(--ease);
  }
  .cw-cytypes-item:hover .cw-cytypes-fig img {
    transform: scale(1.05);
    filter: saturate(1) contrast(1.03);
  }
  .cw-cytypes-name {
    margin: 1rem 0 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: clamp(1.02rem, 2vw, 1.3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-variation-settings: 'opsz' 48, 'SOFT' 40;
    color: var(--color-charcoal);
    text-wrap: balance;
  }
  .cw-cytypes-note {
    margin: 0.45rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    /* steel, not slate: small text on a light ground */
    color: var(--color-steel);
  }

  @media (min-width: 620px) {
    .cw-cytypes-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.6rem 1.8rem;
    }
  }
</style>
