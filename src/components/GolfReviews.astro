---
// Golf reviews — two buyer quotes as equal cards, side by side.
//
// Was a single stacked column with the copy running the full container width;
// at that width each quote read as a wall. Two equal columns halve the measure
// and put the two buyers on the same footing. The attribution is pinned to the
// card's foot, so the two name lines sit level even though one quote is longer.
//
// The quotes themselves live in src/data/golf-reviews.ts, not in default props
// like the page's other sections. They are rewrites of real customers' reviews
// with a provenance caveat attached (see that file), and keeping them in one
// place is what stops the same person appearing with two different wordings.
import SectionHead from './SectionHead.astro'
import Stars from './Stars.astro'
import { reviews, reviewHead } from '../data/golf-reviews'

interface Props {
  kicker?: string
  heading?: string
  lede?: string
  testimonials?: typeof reviews
}

const {
  kicker = reviewHead.kicker,
  heading = reviewHead.heading,
  lede = reviewHead.lede,
  testimonials = reviews,
} = Astro.props

// Paragraph breaks are single newlines; one <p> each, so every paragraph takes
// its own first-line indent while staying gap-free.
const paras = (q: string) => q.split('\n')
---

<section class="cw-rev cw-cv" id="reviews">
  <div class="cw-wrap">
    <SectionHead kicker={kicker} lead={lede}>{heading}</SectionHead>

    <div class="cw-rev-grid">
      {
        testimonials.map((t) => (
          <figure class="cw-rev-card" data-reveal="up">
            <div class="cw-rev-top">
              <img
                class="cw-rev-photo"
                src={t.avatar}
                alt={t.alt ?? ''}
                width={96}
                height={96}
                loading="lazy"
                decoding="async"
              />
              <div class="cw-rev-id">
                <Stars count={5} />
                <span class="cw-rev-name">{t.name}</span>
              </div>
            </div>

            <blockquote class="cw-rev-quote">
              {paras(t.quote).map((p, i, all) => (
                <p>
                  {i === 0 ? '“' : ''}
                  {p}
                  {i === all.length - 1 ? '”' : ''}
                </p>
              ))}
            </blockquote>

            <figcaption class="cw-rev-role">{t.role}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cw-rev {
    padding: 7rem 0 6.5rem;
    background: var(--color-cream);
  }
  .cw-rev :global(.sec-head) {
    max-width: none;
  }
  .cw-rev :global(.sec-lead) {
    max-width: none;
  }

  .cw-rev-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  .cw-rev-card {
    /* flex column so the attribution can be pushed to the foot */
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: clamp(1.35rem, 2.2vw, 1.85rem);
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    /* the house notch */
    border-radius: 22px 22px 22px 6px;
  }

  .cw-rev-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  /* the buyer's own photo, kept small so it reads as evidence rather than as a
     product shot */
  .cw-rev-photo {
    flex: none;
    width: 3rem;
    height: 3rem;
    object-fit: cover;
    border-radius: 10px;
    background: var(--color-linen);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
  }
  .cw-rev-id {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  /* :global() so the rule reaches the row rendered by <Stars> — that SVG carries
     Stars' own scope id, so a plain class selector here never matches. Gold, not
     berry: berry is the palette's accent everywhere else, which is exactly why it
     did not read as a rating. */
  .cw-rev-id :global(.cw-stars) {
    color: var(--color-gold);
  }
  .cw-rev-name {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 0.96rem;
    letter-spacing: -0.015em;
    color: var(--color-charcoal);
  }

  .cw-rev-quote {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 430;
    font-variation-settings: 'opsz' 72, 'SOFT' 60;
    font-size: clamp(0.92rem, 1.25vw, 1rem);
    line-height: 1.52;
    letter-spacing: -0.01em;
    color: var(--color-charcoal);
    /* Justified, like the cycling reviews. `hyphens: auto` is not optional
       here: justification without it stretches inter-word space until the gaps
       line up into rivers down the column, which at this measure (~half the
       container) is very visible. It works because Layout sets lang="en". */
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .cw-rev-quote p {
    margin: 0;
    text-indent: 2em;
  }

  /* margin-top:auto pins both attributions to the card's foot, so the two name
     lines sit level even when the quotes differ in length */
  .cw-rev-role {
    margin: auto 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
    font-size: 0.83rem;
    line-height: 1.5;
    color: var(--color-slate);
  }

  @media (min-width: 900px) {
    .cw-rev-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }
</style>
