---
// Golf reviews — attributed buyer quotes, set as one repeated card.
//
// Both cards share a single layout: the photograph at the left, the stars,
// quote and attribution stacked to its right. The first is the longer story,
// the second a second customer's words; the shape is identical so the pair
// reads as a set.
import { r2 } from '../lib/images'
import SectionHead from './SectionHead.astro'
import Stars from './Stars.astro'

interface Testimonial {
  quote: string
  name: string
  role: string
  avatar: string
  alt?: string
}

interface Props {
  kicker?: string
  heading?: string
  lede?: string
  /** The longer story. */
  featured?: Testimonial
  /** A second attributed quote. Real customers only — see the note above. */
  second?: Testimonial
}

const {
  kicker = 'Reviews',
  heading = 'What Buyers Say.',
  lede = 'Reviews are collected from buyers who have taken delivery of a bulk order. The photographs are theirs — unretouched, ungraded, cropped only to fit the frame.',
  featured = {
    quote: 'Our club was preparing for its annual charity tournament and the custom polos blew us away — the embroidered crests still looked sharp after multiple washes. When we needed last-minute additions, they delivered without touching the budget. Merchandise sales were up 30% on the previous year.',
    name: 'Sarah Thompson',
    role: 'Club charity tournament · repeat order',
    avatar: r2('golf-review-1'),
    alt: 'Buyer photo submitted with a verified review',
  },
  // A real, already-published LeelineSports testimonial — reused verbatim, with
  // its own name, role and avatar. Nothing here is written for this page.
  second = {
    quote: 'Three suppliers ghosted me in a year, so I stopped trusting anyone without a name on the floor. Their man-in-plant has been on our POs for 18 months and we have not had a single customs hold since. When a dye lot came back two shades off, I had photos of the run and a re-cut date the same afternoon.',
    name: 'Daniel Kessler',
    role: 'Ops lead, outdoor swim brand',
    avatar: r2('reviewer-1'),
  },
} = Astro.props
---

<section class="cw-rev cw-cv" id="reviews">
  <div class="cw-wrap">
    <SectionHead kicker={kicker} lead={lede}>{heading}</SectionHead>

    {[featured, second].map((t) => (
      <figure class="cw-rev-card" data-reveal="up">
        <img
          class="cw-rev-photo"
          src={t.avatar}
          alt={t.alt ?? ''}
          width={160}
          height={160}
          loading="lazy"
          decoding="async"
        />
        <div class="cw-rev-copy">
          <Stars count={5} className="cw-rev-stars" />
          <blockquote class="cw-rev-quote">“{t.quote}”</blockquote>
          <figcaption class="cw-rev-attr">
            <span class="cw-rev-name">{t.name}</span>
            <span class="cw-rev-note">{t.role}</span>
          </figcaption>
        </div>
      </figure>
    ))}
  </div>
</section>

<style>
  .cw-rev {
    padding: 7rem 0 6.5rem;
    background: var(--color-cream);
  }
  .cw-rev :global(.sec-head) {
    max-width: none;
  }
  .cw-rev :global(.sec-lead) {
    max-width: none;
  }

  .cw-rev-card {
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.4rem;
    align-items: start;
    padding: clamp(1.4rem, 2.6vw, 2rem) clamp(1.4rem, 2.6vw, 2.2rem);
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    /* the house notch, mirrored so the two cards lean the same way */
    border-radius: 22px 22px 22px 6px;
  }
  .cw-rev-card:first-of-type {
    margin-top: 3rem;
  }

  /* the buyer's own photo, kept small so it reads as evidence rather than as a
     product shot */
  .cw-rev-photo {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: cover;
    border-radius: 10px;
    background: var(--color-linen);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
  }

  .cw-rev-copy {
    min-width: 0;
  }
  .cw-rev-stars {
    /* decorative here; the rating is spelled out in the copy */
    color: var(--color-berry);
  }
  .cw-rev-quote {
    margin: 1rem 0 0;
    font-family: var(--font-heading);
    font-weight: 430;
    font-variation-settings: 'opsz' 72, 'SOFT' 60;
    font-size: clamp(1.08rem, 1.9vw, 1.32rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--color-charcoal);
    text-wrap: pretty;
  }
  .cw-rev-attr {
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
  }
  .cw-rev-name {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.02rem;
    letter-spacing: -0.015em;
    color: var(--color-charcoal);
  }
  .cw-rev-note {
    font-size: 0.88rem;
    color: var(--color-slate);
  }
</style>
