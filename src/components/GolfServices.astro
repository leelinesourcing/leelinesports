---
// Services — four models, one per row, with the photograph alternating sides.
//
// The alternating image is what stops four rows of text reading as a wall, and
// each row closes on a short bullet list of what the engagement actually
// includes, so the reader can scan to the one that matches their situation.
import { r2 } from '../lib/images'
import SectionHead from './SectionHead.astro'

interface Service {
  n: string
  title: string
  body: string
  items: string[]
  img: string
  alt: string
}

interface Props {
  kicker?: string
  heading?: string
  lede?: string
  services?: Service[]
}

const {
  kicker = 'Services',
  heading = 'More Than Cut and Sew.',
  lede = 'Three ways we take work on. Which one you use depends on how much of the product you have already defined — a finished tech pack, a reference garment, or an idea and a photograph.',
  services = [
    {
      n: '01',
      title: 'OEM & ODM production',
      body: 'Two ways in, the same line. Send a finished tech pack and we cut, sew and decorate to it — or send a sketch, a reference garment or even just photographs, and we develop the pattern, the spec sheet and the size run for you.',
      items: [
        'OEM — we build to your tech pack, pattern and grade rules',
        'ODM — pattern, spec sheet and size run drafted for you, no tech pack required',
        '80–98% similarity against your reference sample or photographs',
        'Reorders repeat off the approved PP sample, not a fresh fit round',
      ],
      img: r2('golf-range-polos'),
      alt: 'Custom golf polo produced to a brand tech pack under OEM and ODM terms',
    },
    {
      n: '02',
      title: 'Manufacturing & quality control',
      body: 'We make the garment, rather than broker it out. Cutting, sewing and decoration run on booked capacity in our own facility, with checks at incoming fabric, in-line and pre-shipment — and a supervisor on the floor rather than a phone number.',
      items: [
        'Cut, sewn and decorated in our own facility',
        'Fabric inspected at intake, then in-line, then before packing',
        'AQL 2.5 major / 4.0 minor on the finished lot',
        'Live video and floor photographs before dispatch',
      ],
      img: r2('golf-collar-macro'),
      alt: 'Fused golf polo collar and placket inspected at pre-production sign-off',
    },
    {
      n: '03',
      title: 'Logistics & FBA prep',
      body: 'Consolidated warehousing for kitting and bundling across styles, then duty-paid delivery to your door — or straight into Amazon.',
      items: [
        'Kitting and bundling across styles in one warehouse',
        'One landed number — duty paid, no customs bill at the dock',
        'Barcoded, poly-bagged and injected into Amazon fulfilment centres',
      ],
      img: r2('step-delivery'),
      alt: 'Finished golf apparel shipped by air, sea and road with duties paid',
    },
  ],
} = Astro.props
---

<section class="cw-svc cw-cv" id="services">
  <div class="cw-wrap">
    <SectionHead kicker={kicker} lead={lede}>{heading}</SectionHead>

    <ol class="cw-svc-list">
      {services.map((s) => (
        <li class="cw-svc-row" data-reveal="up">
          <div class="cw-svc-copy">
            <p class="cw-svc-n">{s.n}</p>
            <h3 class="cw-svc-title">{s.title}</h3>
            <p class="cw-svc-body">{s.body}</p>
            <ul class="cw-svc-items">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>

          <figure class="cw-svc-fig">
            <img
              src={s.img}
              alt={s.alt}
              width={640}
              height={480}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cw-svc {
    padding: 7rem 0 6.5rem;
    background: var(--color-linen);
  }
  .cw-svc :global(.sec-head) {
    max-width: none;
  }
  .cw-svc :global(.sec-lead) {
    max-width: none;
  }

  .cw-svc-list {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
  }
  .cw-svc-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
  }

  .cw-svc-copy {
    min-width: 0;
  }
  .cw-svc-n {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-variation-settings: 'opsz' 48, 'SOFT' 0;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--color-berry);
  }
  .cw-svc-title {
    margin: 0.45rem 0 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-variation-settings: 'opsz' 80, 'SOFT' 40;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    text-wrap: balance;
  }
  .cw-svc-body {
    margin: 0.8rem 0 0;
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--color-slate);
    text-wrap: pretty;
  }
  .cw-svc-items {
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .cw-svc-items li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-charcoal);
  }
  .cw-svc-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-berry);
  }

  .cw-svc-fig {
    margin: 0;
    overflow: hidden;
    background: var(--color-cream);
    /* the house notch — three corners soft, one cut */
    border-radius: 20px 20px 20px 6px;
  }
  .cw-svc-fig img {
    display: block;
    width: 100%;
    /* the sources run 4:3, 3:2 and portrait; the frame normalises them, with the
       bias keeping the collar and the heads clear of the crop */
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.88) contrast(1.03);
    transition: transform 0.9s var(--ease), filter 0.9s var(--ease);
  }
  .cw-svc-row:hover .cw-svc-fig img {
    transform: scale(1.05);
    filter: saturate(1) contrast(1.03);
  }

  @media (min-width: 900px) {
    .cw-svc-row {
      grid-template-columns: 1fr 0.78fr;
      gap: 3.4rem;
      align-items: center;
      padding: 3rem 0;
    }
    /* every second service flips: the photograph moves to the left column and
       the copy takes the wider right one, so the column widths swap with it */
    .cw-svc-row:nth-child(even) {
      grid-template-columns: 0.78fr 1fr;
    }
    .cw-svc-row:nth-child(even) .cw-svc-fig {
      grid-column: 1;
      grid-row: 1;
    }
    .cw-svc-row:nth-child(even) .cw-svc-copy {
      grid-column: 2;
      grid-row: 1;
    }
    .cw-svc-list > .cw-svc-row:first-child {
      border-top: none;
      padding-top: 0;
    }
    .cw-svc-list > .cw-svc-row:last-child {
      padding-bottom: 0;
    }
  }
</style>
