---
import { Image } from 'astro:assets'
import { r2 } from '../lib/images'
import Button from './Button.astro'
import Mark from './Mark.astro'
import Stars from './Stars.astro'

interface Props {
  /** Star-rating line above the headline. */
  rating?: string
  /** Body copy under the headline. */
  subheading?: string
  image?: string
  imageAlt?: string
  /** Oversized drop-initial watermark behind the image. */
  initial?: string
  primaryLabel?: string
  primaryHref?: string
}

const {
  rating = '4.8/5 from 200+ reviews',
  subheading = 'Send a sketch—we run sampling (7–21 days), 50–300 pc starts, AQL inspection and DDP delivery. About 40% of new apparel brands fail in two years from overstock; flexible runs can cut unsold inventory ~30%. You test small, scale what sells, and carry none of the factory risk.',
  image = r2('custom-sportswear-manufacturers'),
  imageAlt = 'Cyclist wearing custom manufactured sportswear',
  initial = 'L',
  primaryLabel = 'Request a quote',
  primaryHref = '#quote',
} = Astro.props
---

<section class="cw-hero" id="top" data-hero>
  <div class="cw-hero-media">
    <Image
      src={image}
      alt={imageAlt}
      width={550}
      height={525}
      widths={[720, 1440]}
      sizes="100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
  <div class="cw-hero-veil" aria-hidden="true"></div>

  <!-- giant serif drop-initial watermark -->
  <span class="cw-hero-initial" data-parallax="0.18" aria-hidden="true">{initial}</span>

  <!-- slowly rotating registration mark -->
  <Mark className="cw-hero-dial" />

  <div class="cw-hero-content">
    <div class="cw-hero-item" style="--rd:0ms">
      <p class="cw-hero-rating">
        <Stars />
        <span>{rating}</span>
      </p>
    </div>

    <h1 class="cw-h1 cw-hero-item" style="--rd:90ms">
      <slot><span class="cw-h1-line">Custom Sportswear Manufacturers:</span><span class="cw-h1-line cw-h1-claim">Scale Your Brand with <em>Zero Risk</em> & Full Support.</span></slot>
    </h1>

    <p class="cw-hero-sub cw-hero-item" style="--rd:200ms">{subheading}</p>

    <div class="cw-hero-cta cw-hero-item" style="--rd:300ms">
      <Button href={primaryHref}>{primaryLabel}</Button>
    </div>
  </div>
</section>

<style>
  .cw-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-steel);
  }
  .cw-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cw-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 74% 40%;
    animation: cw-hero-zoom 18s ease-out forwards;
    filter: saturate(0.9) contrast(1.03);
  }
  .cw-hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(196deg,
        color-mix(in srgb, var(--color-steel) 92%, transparent) 0%,
        color-mix(in srgb, var(--color-steel) 70%, transparent) 38%,
        color-mix(in srgb, var(--color-steel) 26%, transparent) 68%,
        color-mix(in srgb, var(--color-ink) 55%, transparent) 100%);
  }

  /* ghost drop-initial */
  .cw-hero-initial {
    position: absolute;
    z-index: 2;
    left: -0.06em;
    top: 6%;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: clamp(16rem, 34vw, 30rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: color-mix(in srgb, var(--color-cream) 5.5%, transparent);
    user-select: none;
    pointer-events: none;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }

  /* rotating registration dial */
  .cw-hero-dial {
    position: absolute;
    z-index: 3;
    right: 4.5%;
    bottom: 12%;
    width: 58px;
    height: 58px;
    color: var(--color-berry);
    opacity: 0.9;
    animation: cw-spin 64s linear infinite;
    transform-origin: 50% 50%;
  }

  .cw-hero-content {
    position: relative;
    z-index: 3;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    /* symmetric top/bottom padding so the centred block puts the text itself on
       the hero's centre line, with the top figure still clearing the nav */
    padding: 8.5rem clamp(1.25rem, 4vw, 2rem) 8.5rem;
    text-align: center;
  }
  .cw-h1 {
    margin: 1.4rem auto 0;
    color: var(--color-cream);
    /* spans the full 1280px hero column (1216px once the sides are padded) so
       the headline sets on as few lines as the copy allows */
    max-width: 76rem;
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    line-height: 1.02;
    /* The headline used to carry authored <br> breaks; it is too long for them
       now, so it balances itself against whatever the clamp resolves to. */
    text-wrap: balance;
  }
  .cw-h1 em {
    font-style: italic;
    font-weight: 430;
    letter-spacing: -0.045em;
    /* the hyphen in "zero-risk" is a legal break point; keep the term whole */
    white-space: nowrap;
  }
  /* One block per sentence. Balancing the headline as a single block across
     the forced break left "Support." alone on the last line; as separate
     blocks each sentence balances inside itself. */
  .cw-h1-line {
    display: block;
    text-wrap: balance;
  }
  /* Two-tone headline: the descriptor stays in cream and the promise takes
     berry, so the one accent in the palette lands on the claim, not the label. */
  .cw-h1-claim {
    color: var(--color-berry);
  }
  /* Star-rating line, in place of the old eyebrow. The stars hold the full
     cream and the score sits in the muted tone the eyebrow used, so the row
     reads as one unit without spending a second accent. */
  .cw-hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.45rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--color-cream) 26%, transparent);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-cream) 68%, transparent);
  }
  /* :global() so the rule reaches the row rendered by <Stars> */
  .cw-hero-rating :global(.cw-stars) {
    color: var(--color-cream);
  }
  .cw-hero-sub {
    /* held to its own narrower measure than the headline above it */
    max-width: 69rem;
    margin: 1.7rem auto 0;
    font-size: 1.14rem;
    line-height: 1.62;
    color: color-mix(in srgb, var(--color-cream) 82%, transparent);
  }
  .cw-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }
  /* entrance — will-change is applied by site.js for the duration of the
     entrance only, never left on the elements. */
  .cw-hero-item {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    transition-delay: var(--rd, 0ms);
  }
  .cw-hero.is-in .cw-hero-item {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 719px) {
    .cw-hero-dial {
      display: none;
    }
  }

  @keyframes cw-hero-zoom {
    from { transform: scale(1.14); }
    to { transform: scale(1.02); }
  }
  @keyframes cw-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
