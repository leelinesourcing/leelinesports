---
import { r2 } from '../lib/images'
import Button from './Button.astro'
import Mark from './Mark.astro'
import Stars from './Stars.astro'

interface Props {
  /** Star-rating line above the headline. */
  rating?: string
  /** Body copy under the headline. */
  subheading?: string
  image?: string
  imageAlt?: string
  primaryLabel?: string
  primaryHref?: string
}

const {
  rating = '4.8/5 from 200+ reviews',
  subheading = 'We engineer high-performance activewear, team uniforms, and seamless gym apparel tailored to your exact tech packs. Send a sketch—we deliver samples in 7 days, full AQL inspection, and door-to-door DDP shipping. Eliminate overstock risk, validate market demand with zero factory liability, and scale your winning styles seamlessly.',
  image = r2('custom-sportswear-manufacturers'),
  imageAlt = 'Cyclist wearing custom manufactured sportswear',
  primaryLabel = 'Request a quote',
  primaryHref = '#quote',
} = Astro.props
---

<section class="cw-hero" id="top" data-hero>
  <div class="cw-hero-media">
    <img
      src={image}
      alt={imageAlt}
      width={550}
      height={525}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
  <div class="cw-hero-veil" aria-hidden="true"></div>

  <!-- slowly rotating registration mark -->
  <Mark className="cw-hero-dial" />

  <div class="cw-hero-content">
    <div class="cw-hero-item" style="--rd:0ms">
      <p class="cw-hero-rating">
        <Stars />
        <span>{rating}</span>
      </p>
    </div>

    <h1 class="cw-h1 cw-hero-item" style="--rd:90ms">
      <slot><span class="cw-h1-line">Custom Sportswear Manufacturers:</span><span class="cw-h1-line cw-h1-claim">Scale Your Brand with <em>99.6% QC Pass Rates</em> & Full Support.</span></slot>
    </h1>

    <p class="cw-hero-sub cw-hero-item" style="--rd:200ms">{subheading}</p>

    <div class="cw-hero-cta cw-hero-item" style="--rd:300ms">
      <Button href={primaryHref}>{primaryLabel}</Button>
    </div>
  </div>
</section>

<style>
  .cw-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-steel);
  }
  .cw-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cw-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 74% 40%;
    animation: cw-hero-zoom 18s ease-out forwards;
    filter: saturate(0.9) contrast(1.03);
  }
  .cw-hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(196deg,
        color-mix(in srgb, var(--color-steel) 92%, transparent) 0%,
        color-mix(in srgb, var(--color-steel) 70%, transparent) 38%,
        color-mix(in srgb, var(--color-steel) 26%, transparent) 68%,
        color-mix(in srgb, var(--color-ink) 55%, transparent) 100%);
  }

  /* rotating registration dial */
  .cw-hero-dial {
    position: absolute;
    z-index: 3;
    right: 4.5%;
    bottom: 12%;
    width: 58px;
    height: 58px;
    color: var(--color-berry);
    opacity: 0.9;
    animation: cw-spin 64s linear infinite;
    transform-origin: 50% 50%;
  }

  .cw-hero-content {
    position: relative;
    z-index: 3;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    /* symmetric top/bottom padding so the centred block puts the text itself on
       the hero's centre line, with the top figure still clearing the nav */
    padding: 8.5rem clamp(1.25rem, 4vw, 2rem) 8.5rem;
    text-align: center;
  }
  .cw-h1 {
    margin: 1.4rem auto 0;
    /* Heavier, larger and pure white than the shared .cw-h1 token, which the
       design-system specimen keeps at 620 / cream. */
    font-weight: 700;
    color: var(--color-paper);
    /* spans the full 1280px hero column (1216px once the sides are padded) so
       the headline sets on as few lines as the copy allows */
    max-width: 76rem;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 1.02;
    /* The headline used to carry authored <br> breaks; it is too long for them
       now, so it balances itself against whatever the clamp resolves to. */
    text-wrap: balance;
  }
  /* No weight override: the italic and the berry tint already carry the accent,
     so the term stays as heavy as the headline around it. */
  .cw-h1 em {
    font-style: italic;
    letter-spacing: -0.045em;
    /* keeps the two-word term from breaking across lines */
    white-space: nowrap;
  }
  /* One block per sentence. Balancing the headline as a single block across
     the forced break left "Support." alone on the last line; as separate
     blocks each sentence balances inside itself. */
  .cw-h1-line {
    display: block;
    text-wrap: balance;
  }
  /* Two-tone headline: the descriptor stays in cream and the promise takes
     berry, so the one accent in the palette lands on the claim, not the label. */
  .cw-h1-claim {
    color: var(--color-berry);
  }
  /* Star-rating line, in place of the old eyebrow. The stars hold the full
     cream and the score sits in the muted tone the eyebrow used, so the row
     reads as one unit without spending a second accent. */
  .cw-hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.45rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--color-cream) 26%, transparent);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-cream) 68%, transparent);
  }
  /* :global() so the rule reaches the row rendered by <Stars> */
  .cw-hero-rating :global(.cw-stars) {
    color: var(--color-cream);
  }
  .cw-hero-sub {
    /* held to its own narrower measure than the headline above it */
    max-width: 69rem;
    margin: 1.7rem auto 0;
    font-size: 1.14rem;
    line-height: 1.62;
    color: var(--color-paper);
  }
  .cw-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }
  /* entrance — will-change is applied by site.js for the duration of the
     entrance only, never left on the elements. */
  .cw-hero-item {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    transition-delay: var(--rd, 0ms);
  }
  .cw-hero.is-in .cw-hero-item {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 719px) {
    .cw-hero-dial {
      display: none;
    }
  }

  @keyframes cw-hero-zoom {
    from { transform: scale(1.14); }
    to { transform: scale(1.02); }
  }
  @keyframes cw-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
