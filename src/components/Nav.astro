---
import Button from './Button.astro'
import Mark from './Mark.astro'

interface NavLink {
  label: string
  href: string
}

interface Props {
  /** Wordmark is set in two parts so the second half can stay italic. */
  brandName?: string
  brandAccent?: string
  links?: NavLink[]
  ctaLabel?: string
  ctaHref?: string
  /** WhatsApp label used in the mobile menu. */
  phoneLabel?: string
  whatsappHref?: string
}

const {
  brandName = 'Leeline',
  brandAccent = 'Sports',
  links = [
    { label: 'Verticals', href: '#verticals' },
    { label: 'Process', href: '#process' },
    { label: 'Proof', href: '#proof' },
    { label: 'FAQ', href: '#faq' },
  ],
  ctaLabel = 'Request a quote',
  ctaHref = '#quote',
  phoneLabel = 'WhatsApp +86 139 8615 2456',
  whatsappHref = 'https://wa.me/8613986152456',
} = Astro.props
---

<header class="cw-nav" id="site-nav">
  <div class="cw-nav-inner">
    <a href="#top" class="cw-nav-logo" aria-label={`${brandName}${brandAccent} — home`}>
      <Mark className="cw-nav-mark" />
      <span class="cw-nav-word">{brandName}<em>{brandAccent}</em></span>
    </a>

    <nav class="cw-nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="cw-nav-actions">
      <Button href={ctaHref} size="sm" class="cw-nav-cta">{ctaLabel}</Button>
    </div>

    <button class="cw-nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu">
      <span></span><span></span>
    </button>
  </div>

  <div class="cw-nav-menu" id="nav-menu">
    <div class="cw-nav-menu-inner">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="cw-nav-menu-wa" href={whatsappHref} target="_blank" rel="noopener">{phoneLabel}</a>
      <Button href={ctaHref} class="cw-nav-menu-cta">{ctaLabel}</Button>
    </div>
  </div>
</header>

<style>
  .cw-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    border-bottom: 1px solid transparent;
    transition: background-color 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease, backdrop-filter 0.4s ease;
  }
  .cw-nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.9rem clamp(1.25rem, 4vw, 2rem);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    justify-content: space-between;
  }
  .cw-nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    line-height: 1;
  }
  .cw-nav-mark {
    width: 21px;
    height: 21px;
    color: var(--color-berry);
  }
  .cw-nav-word {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    white-space: nowrap;
    transition: color 0.4s ease;
  }
  .cw-nav-word em {
    font-style: italic;
    font-weight: 420;
  }
  .cw-nav-links {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }
  .cw-nav-links a {
    font-family: var(--font-body);
    font-size: 0.97rem;
    font-weight: 600;
    color: var(--color-cream);
    text-decoration: none;
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.3s ease;
  }
  .cw-nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -3px;
    height: 2px;
    background: var(--color-berry);
    transition: right 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cw-nav-links a:hover::after {
    right: 0;
  }
  .cw-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .cw-nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
    border-radius: 999px;
    cursor: pointer;
  }
  .cw-nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-cream);
    border-radius: 2px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  .cw-nav.is-open .cw-nav-toggle span:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .cw-nav.is-open .cw-nav-toggle span:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .cw-nav-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    background: var(--color-steel);
  }
  .cw-nav.is-open .cw-nav-menu {
    grid-template-rows: 1fr;
    box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
  .cw-nav-menu-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0.5rem clamp(1.25rem, 4vw, 2rem) 1.5rem;
    gap: 0.25rem;
  }
  /* :global() so the rules also reach the anchor rendered by <Button> */
  .cw-nav-menu-inner :global(a) {
    font-family: var(--font-body);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--color-cream);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--color-berry) 30%, transparent);
  }
  .cw-nav-menu-inner :global(a.cw-btn) {
    margin-top: 1rem;
    align-self: flex-start;
    color: var(--color-cream);
    border-bottom: none;
  }
  .cw-nav-menu-wa {
    font-family: var(--font-heading) !important;
    font-style: italic;
    font-size: 1.03rem !important;
    color: var(--color-berry) !important;
    border-bottom: none !important;
  }

  /* scrolled state */
  .cw-nav.is-scrolled {
    background: color-mix(in srgb, var(--color-cream) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: color-mix(in srgb, var(--color-steel) 14%, transparent);
    box-shadow: 0 12px 40px -28px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }
  .cw-nav.is-scrolled .cw-nav-word,
  .cw-nav.is-scrolled .cw-nav-links a {
    color: var(--color-steel);
  }
  .cw-nav.is-scrolled .cw-nav-toggle {
    border-color: color-mix(in srgb, var(--color-ink) 25%, transparent);
  }
  .cw-nav.is-scrolled .cw-nav-toggle span {
    background: var(--color-steel);
  }
  .cw-nav.is-scrolled .cw-nav-menu {
    background: var(--color-cream);
  }
  .cw-nav.is-scrolled .cw-nav-menu-inner :global(a) {
    color: var(--color-steel);
  }

  @media (min-width: 880px) {
    .cw-nav-links {
      display: flex;
    }
    .cw-nav-toggle {
      display: none;
    }
    .cw-nav-menu {
      display: none;
    }
  }
  @media (max-width: 879px) {
    .cw-nav-actions {
      display: none;
    }
  }
</style>
