---
import Button from './Button.astro'
import Mark from './Mark.astro'

interface NavLink {
  label: string
  href: string
  /** Renders as a dropdown under this link. One level only. */
  children?: { label: string; href: string }[]
}

interface Props {
  /** Wordmark is set in two parts so the second half can stay italic. */
  brandName?: string
  brandAccent?: string
  links?: NavLink[]
  ctaLabel?: string
  ctaHref?: string
  /** WhatsApp label used in the mobile menu. */
  phoneLabel?: string
  whatsappHref?: string
  /**
   * Give the nav its own opaque bar from the first paint instead of letting it
   * sit transparently on the hero. For heroes whose top is light, where the cream
   * wordmark and links would land on a light ground. Left off, the nav behaves
   * exactly as before.
   */
  solid?: boolean
}

const {
  brandName = 'Leeline',
  brandAccent = 'Sports',
  links = [
    {
      label: 'Product',
      href: '/golf-apparel-manufacturer/',
      // Both vertical pages are listed on every route, so the Product menu is
      // the same menu whichever one you are on. Adding cycling here changes the
      // homepage's dropdown; the render is otherwise untouched.
      children: [
        { label: 'GOLF APPAREL', href: '/golf-apparel-manufacturer/' },
        { label: 'CYCLING APPAREL', href: '/cycling-apparel-manufacturers/' },
      ],
    },
    // The homepage's default set, kept in step with the golf page's labels.
    // The anchors are not a one-to-one port: the homepage fuses customisation
    // and service into one block — #services carries the kicker "What we
    // customise" and the heading "Your All-in-One Solution." — so Customisation
    // points there and Services points at #beyond, the post-order support block.
    { label: 'Customisation', href: '#services' },
    { label: 'Services', href: '#beyond' },
    { label: 'FAQ', href: '#faq' },
  ],
  ctaLabel = 'Request a quote',
  ctaHref = '#quote',
  phoneLabel = 'WhatsApp +86 139 8615 2456',
  whatsappHref = 'https://wa.me/8613986152456',
  solid = false,
} = Astro.props
---

<header class:list={['cw-nav', solid && 'cw-nav--solid']} id="site-nav">
  <div class="cw-nav-inner">
    <a href="#top" class="cw-nav-logo" aria-label={`${brandName}${brandAccent} — home`}>
      <Mark className="cw-nav-mark" />
      <span class="cw-nav-word">{brandName}<em>{brandAccent}</em></span>
    </a>

    <nav class="cw-nav-links" aria-label="Primary">
      {
        links.map((l) =>
          l.children ? (
            <div class="cw-nav-drop">
              <a
                href={l.href}
                class="cw-nav-drop-trigger"
                aria-haspopup="true"
                aria-expanded="false"
              >
                {l.label}
                <span class="cw-nav-caret" aria-hidden="true" />
              </a>
              <div class="cw-nav-drop-menu">
                {l.children.map((c) => <a href={c.href}>{c.label}</a>)}
              </div>
            </div>
          ) : (
            <a href={l.href}>{l.label}</a>
          )
        )
      }
    </nav>

    <div class="cw-nav-actions">
      <Button href={ctaHref} size="sm" class="cw-nav-cta">{ctaLabel}</Button>
    </div>

    <button class="cw-nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu">
      <span></span><span></span>
    </button>
  </div>

  <div class="cw-nav-menu" id="nav-menu">
    <div class="cw-nav-menu-inner">
      {
        links.map((l) => (
          <>
            <a href={l.href}>{l.label}</a>
            {l.children?.map((c) => (
              <a class="cw-nav-menu-sub" href={c.href}>{c.label}</a>
            ))}
          </>
        ))
      }
      <a class="cw-nav-menu-wa" href={whatsappHref} target="_blank" rel="noopener">{phoneLabel}</a>
      <Button href={ctaHref} class="cw-nav-menu-cta">{ctaLabel}</Button>
    </div>
  </div>
</header>

<style>
  .cw-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    border-bottom: 1px solid transparent;
    transition: background-color 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease, backdrop-filter 0.4s ease;
  }
  .cw-nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.9rem clamp(1.25rem, 4vw, 2rem);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    justify-content: space-between;
  }
  .cw-nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    line-height: 1;
  }
  .cw-nav-mark {
    width: 21px;
    height: 21px;
    color: var(--color-berry);
  }
  .cw-nav-word {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    white-space: nowrap;
    transition: color 0.4s ease;
  }
  .cw-nav-word em {
    font-style: italic;
    font-weight: 420;
  }
  .cw-nav-links {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }
  .cw-nav-links a {
    font-family: var(--font-body);
    font-size: 0.97rem;
    font-weight: 600;
    color: var(--color-cream);
    text-decoration: none;
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.3s ease;
  }
  .cw-nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -3px;
    height: 2px;
    background: var(--color-berry);
    transition: right 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cw-nav-links a:hover::after {
    right: 0;
  }
  .cw-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .cw-nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
    border-radius: 999px;
    cursor: pointer;
  }
  .cw-nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-cream);
    border-radius: 2px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  .cw-nav.is-open .cw-nav-toggle span:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .cw-nav.is-open .cw-nav-toggle span:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .cw-nav-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    background: var(--color-steel);
  }
  .cw-nav.is-open .cw-nav-menu {
    grid-template-rows: 1fr;
    box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
  .cw-nav-menu-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0.5rem clamp(1.25rem, 4vw, 2rem) 1.5rem;
    gap: 0.25rem;
  }
  /* :global() so the rules also reach the anchor rendered by <Button> */
  .cw-nav-menu-inner :global(a) {
    font-family: var(--font-body);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--color-cream);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--color-berry) 30%, transparent);
  }
  .cw-nav-menu-inner :global(a.cw-btn) {
    margin-top: 1rem;
    align-self: flex-start;
    color: var(--color-cream);
    border-bottom: none;
  }
  .cw-nav-menu-wa {
    font-family: var(--font-heading) !important;
    font-style: italic;
    font-size: 1.03rem !important;
    color: var(--color-berry) !important;
    border-bottom: none !important;
  }

  /* scrolled state */
  .cw-nav.is-scrolled {
    background: color-mix(in srgb, var(--color-cream) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: color-mix(in srgb, var(--color-steel) 14%, transparent);
    box-shadow: 0 12px 40px -28px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }
  .cw-nav.is-scrolled .cw-nav-word,
  .cw-nav.is-scrolled .cw-nav-links a {
    color: var(--color-steel);
  }
  .cw-nav.is-scrolled .cw-nav-toggle {
    border-color: color-mix(in srgb, var(--color-ink) 25%, transparent);
  }
  .cw-nav.is-scrolled .cw-nav-toggle span {
    background: var(--color-steel);
  }
  .cw-nav.is-scrolled .cw-nav-menu {
    background: var(--color-cream);
  }
  .cw-nav.is-scrolled .cw-nav-menu-inner :global(a) {
    color: var(--color-steel);
  }

  /* Opt-in solid bar (`solid` prop). Opaque and unblurred where the scrolled
     state is translucent: the point is that the nav does not blend into the
     photograph behind it. Kept separate from .is-scrolled so site.js's scroll
     toggle cannot switch it back off at the top of the page. */
  .cw-nav--solid {
    background: var(--color-cream);
    border-bottom-color: color-mix(in srgb, var(--color-steel) 14%, transparent);
    box-shadow: 0 12px 40px -28px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }
  .cw-nav--solid .cw-nav-word,
  .cw-nav--solid .cw-nav-links a {
    color: var(--color-steel);
  }
  .cw-nav--solid .cw-nav-toggle {
    border-color: color-mix(in srgb, var(--color-ink) 25%, transparent);
  }
  .cw-nav--solid .cw-nav-toggle span {
    background: var(--color-steel);
  }
  .cw-nav--solid .cw-nav-menu {
    background: var(--color-cream);
  }
  .cw-nav--solid .cw-nav-menu-inner :global(a) {
    color: var(--color-steel);
  }

  /* Dropdown — any link carrying `children`. Desktop only; below 880px the whole
     .cw-nav-links block is hidden and the sub-items render flat in the mobile
     menu instead. */
  .cw-nav-drop {
    position: relative;
    display: flex;
    align-items: center;
  }
  .cw-nav-caret {
    display: inline-block;
    margin-left: 0.4rem;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid currentColor;
  }
  .cw-nav-drop-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 0.5rem);
    min-width: 14rem;
    padding: 0.4rem 0;
    background: var(--color-cream);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    box-shadow: 0 24px 48px -30px color-mix(in srgb, var(--color-ink) 55%, transparent);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  /* Hover opens these on a pointer, and the click handler in site.js adds
     .is-open. :focus-within used to open them too, but it fought the toggle:
     clicking the trigger focuses it, so a second click could never close the
     menu. Keyboard users press Enter on the focused link instead, which fires
     the same click handler. */
  .cw-nav-drop:hover .cw-nav-drop-menu,
  .cw-nav-drop.is-open .cw-nav-drop-menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  /* Declared after the .cw-nav-links a rules so it wins the specificity tie: a
     dropdown always sits on its own cream panel, whatever state the nav is in. */
  .cw-nav-links .cw-nav-drop-menu a {
    display: block;
    padding: 0.55rem 1.1rem;
    font-size: 0.98rem;
    color: var(--color-steel);
  }
  .cw-nav-links .cw-nav-drop-menu a::after {
    display: none;
  }
  .cw-nav-links .cw-nav-drop-menu a:hover {
    background: color-mix(in srgb, var(--color-steel) 8%, transparent);
  }
  /* the mobile menu indents sub-items rather than nesting them */
  .cw-nav-menu-inner :global(.cw-nav-menu-sub) {
    padding-left: 1.6rem;
    font-size: 0.98rem;
  }

  @media (min-width: 880px) {
    .cw-nav-links {
      display: flex;
    }
    .cw-nav-toggle {
      display: none;
    }
    .cw-nav-menu {
      display: none;
    }
  }
  @media (max-width: 879px) {
    .cw-nav-actions {
      display: none;
    }
  }
</style>
