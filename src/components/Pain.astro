---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import painImage from '../assets/images/image-11.avif'
import Mark from './Mark.astro'

interface Fear {
  fear: string
  fix: string
}

interface Props {
  eyebrow?: string
  heading?: string
  lede?: string
  fears?: Fear[]
  image?: ImageMetadata
  imageAlt?: string
  cardTitle?: string
  /** [code, description] pairs listed on the floating tolerance card. */
  tolerances?: [string, string][]
}

const {
  eyebrow = 'The mess we handle',
  heading = 'Importing Shouldn’t Be a Coin Flip.',
  lede = 'Every brand carries the same four fears. We didn’t build a supply chain to soothe them with adjectives — we built a spec sheet with teeth.',
  fears = [
    {
      fear: '“The sample looked great. The container didn’t.”',
      fix: 'A pre-production sample is signed off against the spec sheet ahead of any cutting, then the lot is inspected to AQL 2.5 major / 4.0 minor prior to packing. You see the inspection report before the cartons move.',
    },
    {
      fear: '“Customs held my pallet for three weeks.”',
      fix: 'Duty-paid pricing folds freight, duties and clearance into an all-in landed figure, approved up front. Nothing is left to settle at the dock, and there is no demurrage bill you did not budget for.',
    },
    {
      fear: '“The logo peeled after two washes.”',
      fix: 'Decoration is tested to ISO 105 and held to Grade 4+ colorfastness, and the print method is matched to the fabric, never pulled from a fixed menu. If a finish will not survive the wash cycle, it does not go on your garment.',
    },
    {
      fear: '“My supplier ghosted me mid-PO.”',
      fix: 'Man-in-plant supervision and live video inspections, so you are never guessing where a PO stands. Six stages take an order from brief to boxed — 1 business day to quote, 5–10 days to sample, a duty-paid number to your door.',
    },
  ],
  image = painImage,
  imageAlt = 'Stack of blank t-shirts awaiting inspection',
  cardTitle = 'The tolerances we guarantee, in writing.',
  tolerances = [
    ['AQL', '2.5 major / 4.0 minor'],
    ['ISO 5077', 'shrinkage ≤3–5%'],
    ['ISO 105', 'colorfast Grade 4+'],
  ],
} = Astro.props
---

<section class="cw-pain cw-cv" id="pain">
  <div class="cw-wrap">
    <div class="cw-pain-head">
      <p class="cw-eyebrow" data-reveal="up">{eyebrow}</p>
      <h2 class="cw-h2" data-reveal="mask" style="--rd:80ms">{heading}</h2>
      <p class="cw-lede" data-reveal="up" style="--rd:160ms">{lede}</p>
    </div>

    <div class="cw-pain-grid">
      <div class="cw-pain-copy">
        <div class="cw-pain-rows">
          {fears.map((r) => (
            <div class="cw-pain-row" data-reveal="left">
              <p class="cw-pain-fear">{r.fear}</p>
              <p class="cw-pain-fix">{r.fix}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="cw-pain-figure" data-reveal="right">
        <figure class="cw-pain-fig">
          <div class="cw-pain-img">
            <Image
              src={image}
              alt={imageAlt}
              width={550}
              height={525}
              widths={[275, 550]}
              sizes="(min-width: 880px) 45vw, 100vw"
              quality={80}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="cw-pain-card">
            <Mark className="cw-pain-card-mark" />
            <p class="cw-pain-card-title">{cardTitle}</p>
            <ul class="cw-pain-card-list">
              {tolerances.map(([code, description]) => (
                <li><span>{code}</span>{description}</li>
              ))}
            </ul>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .cw-pain {
    padding: 6.5rem 0 6rem;
    background: var(--color-linen);
  }
  .cw-pain-head {
    max-width: none;
  }
  .cw-pain-head .cw-lede {
    max-width: none;
  }
  .cw-pain-grid {
    margin-top: 3rem;
    display: grid;
    gap: 3rem;
  }
  .cw-pain-copy {
    max-width: 40rem;
  }
  .cw-pain-rows {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cw-pain-row {
    padding: 1.15rem 1.35rem 1.2rem;
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    border-radius: 16px;
  }
  .cw-pain-fear {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 470;
    font-size: 1.16rem;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--color-charcoal) 42%, transparent);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--color-berry) 45%, transparent);
    text-decoration-thickness: 1px;
  }
  .cw-pain-fix {
    margin: 0.45rem 0 0;
    font-size: 1.01rem;
    font-weight: 600;
    color: var(--color-charcoal);
  }
  .cw-pain-fix::before {
    content: '↳ ';
    color: var(--color-berry);
  }

  .cw-pain-figure {
    align-self: center;
  }
  .cw-pain-fig {
    margin: 0;
    position: relative;
  }
  .cw-pain-img {
    border-radius: 28px 28px 8px 28px;
    overflow: hidden;
    aspect-ratio: 1 / 1.16;
    box-shadow: 0 34px 70px -38px color-mix(in srgb, var(--color-ink) 28%, transparent);
  }
  .cw-pain-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) sepia(0.14) saturate(0.7) hue-rotate(200deg) contrast(1.05) brightness(0.92);
  }
  .cw-pain-card {
    position: absolute;
    left: -0.75rem;
    bottom: -2.25rem;
    max-width: 20rem;
    background: var(--color-paper);
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--color-steel) 14%, transparent);
    padding: 1.1rem 1.25rem;
    box-shadow: 0 26px 56px -28px color-mix(in srgb, var(--color-ink) 26%, transparent);
  }
  .cw-pain-card-mark {
    width: 17px;
    height: 17px;
    color: var(--color-berry);
  }
  .cw-pain-card-title {
    margin: 0.6rem 0 0.9rem;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-steel);
  }
  .cw-pain-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .cw-pain-card-list li {
    display: flex;
    gap: 0.55rem;
    font-size: 0.91rem;
    font-weight: 600;
    color: var(--color-charcoal);
  }
  .cw-pain-card-list span {
    flex: none;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-slate);
    min-width: 4.1rem;
  }

  @media (min-width: 880px) {
    .cw-pain-grid {
      /* wider copy column: the cards are the taller side, so giving them more
         width is what brings the two columns closest to level — past ~639px the
         card text stops reflowing and only the figure keeps shrinking. */
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      align-items: center;
    }
  }
</style>
