---
// "Your all-in-one solution".
// Fabric leads: a framing rule, a full-width statement, then its own library of
// weave cards. The other four capability areas follow as their own cards, each
// with an image and a spec list.
import { r2 } from '../lib/images'
import SectionHead from './SectionHead.astro'

interface Weave {
  name: string
  note: string
  /** Decorative thumbnail — rendered with empty alt. */
  thumb: string
}

interface Fabric {
  /** Two-digit index shown beside the title. */
  n: string
  title: string
  /** Prose, one entry per paragraph. */
  body: string[]
  /** The constructions held in the standing library. */
  weaves: Weave[]
}

interface Area {
  /** Two-digit index shown above the title. */
  n: string
  title: string
  /** Descriptive paragraph, set the same way as the fabric block's. */
  body: string
  /** The spec list, set as bullets under the paragraph. */
  items: string[]
  img: string
  alt: string
}

interface Props {
  kicker?: string
  lede?: string
  fabric?: Fabric
  areas?: Area[]
}

const {
  kicker = 'What we customise',
  lede = 'Forty things you can specify across five areas — colour and trim, fabric, cost, sustainability and support, all handled in-house.',
  fabric = {
    n: '01',
    title: 'Performance fabrics',
    body: [
      'Fabric decides how a garment performs, prints and washes — and what it costs landed. No batch is cut until it has been tested: composition, shrinkage and colorfastness against the tolerance sheet. The standing library covers moisture-wicking knits, 4-way stretch, UV protection and compression constructions, so a prototype never waits on a mill — and anything outside it we develop to your brief, holding the same fabric for your reorders.',
    ],
    weaves: [
      { name: 'Moisture-wicking', note: 'Pulls sweat off the skin and spreads it flat, so it dries in minutes, not hours.', thumb: r2('moisture-wicking') },
      { name: '4-way stretch', note: 'Recovers in both directions — a squat or a sprint does not leave the garment bagged out.', thumb: r2('4-way-stretch') },
      { name: 'UV protection', note: 'UPF 50+ knits that hold their rating through repeated washing.', thumb: r2('uv-protection') },
      { name: 'Compression fit', note: 'Graduated pressure built into the pattern, not faked with a tighter cut.', thumb: r2('compression-fit') },
      { name: 'Antimicrobial', note: 'Silver-ion treatment that stops the garment turning after a session.', thumb: r2('antimicrobial') },
      { name: 'Flatlock seams', note: 'Flat, chafe-free joins that sit level against the skin.', thumb: r2('flatlock-seams') },
      { name: 'Laser-cut ventilation', note: 'Cut, not punched, so the edges stay clean and never fray.', thumb: r2('laser-cut-ventilation') },
      { name: 'Abrasion-resistant panels', note: 'Reinforced zones at the seat, knees and shoulders, where the wear actually lands.', thumb: r2('abrasion-resistant-panels') },
    ],
  },
  areas = [
    {
      n: '02',
      title: 'Sleeve length & sizing',
      body: 'Sleeve and size are pattern decisions, not afterthoughts. We hold blocks from capped to long, and grade any style against your chart or ours, so the fit holds at both ends of the run — not only on the sample size.',
      img: r2('sleeve-length-sizing'),
      alt: 'Custom team apparel produced across a full size run',
      items: [
        'Cap, half and long sleeves',
        'Raglan and drop-shoulder',
        'Size chart grading',
        'Youth and tall runs',
        'Relaxed and race fits',
        'Waistband and hem options',
      ],
    },
    {
      n: '03',
      title: 'Embroidery & screen printing',
      body: 'Decoration is chosen for the fabric it sits on — not lifted from a standard list. Embroidery is digitised from your artwork and stitched on the frame; screen prints are matched to a Pantone you approve and cured so the colour survives the wash cycle.',
      img: r2('embroidery-screen-printing'),
      alt: 'Custom printed apparel produced by LeelineSports',
      items: [
        'Digitised embroidery',
        'Screen printing',
        'Heat transfer and sublimation',
        'Pantone colour matching',
        'Reflective elements',
        'Placement and scale guides',
      ],
    },
    {
      n: '04',
      title: 'Packaging',
      body: 'Packaging is specified like anything else on the bill of materials. Polybags, hangtags and carton marks are set to your brand and to the channel you ship into — retail shelf or marketplace — so the carton arrives intact rather than merely arriving cheap.',
      img: r2('packaging'),
      alt: 'Custom sportswear packed for bulk shipment',
      items: [
        'Polybags and garment bags',
        'Hangtags and stickers',
        'Custom carton marks',
        'Retail and e-commerce packing',
        'Barcode and FNSKU labels',
        'Gift and multi-pack options',
      ],
    },
    {
      n: '05',
      title: 'Labels',
      body: 'Labels carry the claims your market requires, so they are set early and checked against the spec. Woven and printed main labels, care and content labels and heat-sealed neck labels are all matched to your artwork, including the compliance text your destination market asks for.',
      img: r2('labels'),
      alt: 'Woven and printed garment labels produced by LeelineSports',
      items: [
        'Woven main labels',
        'Printed neck labels',
        'Care and content labels',
        'Heat-sealed labels',
        'Size and origin marks',
        'Compliance and warning text',
      ],
    },
  ],
} = Astro.props
---

<section class="cw-allinone cw-cv" id="services">
  <div class="cw-wrap">
    <div class="cw-allinone-head">
      <SectionHead kicker={kicker}>
        <slot>Your All-in-One Solution.</slot>
      </SectionHead>
      <p class="cw-ai-lede" data-reveal="up" style="--rd:160ms">{lede}</p>
    </div>

    <article class="cw-ai-feature" data-reveal="up" style="--rd:120ms">
      <div class="cw-ai-media">
        <span class="cw-ai-num">{fabric.n}</span>
        <h3 class="cw-ai-title">{fabric.title}</h3>
      </div>

      <div class="cw-ai-feature-body">
        {fabric.body.map((p) => <p class="cw-ai-copy">{p}</p>)}
      </div>
    </article>

    {/* The standing library — one close-up per construction, so the card names
        the weave it actually shows. */}
    <ul class="cw-ai-weaves">
      {fabric.weaves.map((w) => (
        <li class="cw-ai-weave" data-reveal="up">
          <span class="cw-ai-weave-thumb">
            <img
              src={w.thumb}
              alt=""
              width={480}
              height={320}
              loading="lazy"
              decoding="async"
            />
          </span>
          <h4 class="cw-ai-weave-name">{w.name}</h4>
          <p class="cw-ai-weave-note">{w.note}</p>
        </li>
      ))}
    </ul>

    <div class="cw-ai-grid">
      {areas.map((g, i) => (
        <article class:list={['cw-ai-card', i % 2 === 1 && 'cw-ai-card--flip']} data-reveal="up">
          <div class="cw-ai-text">
            <span class="cw-ai-num">{g.n}</span>
            <h3 class="cw-ai-title">{g.title}</h3>
            <p class="cw-ai-copy">{g.body}</p>

            <ul class="cw-ai-list">
              {/* shortest first so the longest labels land on the final row —
                  a wrapped long label only stretches the last row, not the middle.
                  Anything past 30 characters takes a full row of its own. */}
              {g.items.slice().sort((a, b) => a.length - b.length).map((it) => (
                <li class:list={[{ 'cw-ai-item--wide': it.length >= 30 }]}>{it}</li>
              ))}
            </ul>
          </div>

          <figure class="cw-ai-fig">
            <img
              src={g.img}
              alt={g.alt}
              width={550}
              height={525}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cw-allinone {
    padding: 6.5rem 0 6rem;
    background: var(--color-cream);
  }
  /* head spans the container so the title and lede line up with the content
     grid below, the way the Verticals section does */
  .cw-allinone-head {
    display: grid;
    gap: 1.6rem;
    max-width: none;
  }
  /* :global() so the rule reaches the head rendered by <SectionHead> */
  .cw-allinone-head :global(.sec-head) {
    max-width: none;
  }
  .cw-ai-lede {
    margin: 0;
    font-size: 1.10rem;
    line-height: 1.66;
    color: var(--color-slate);
  }

  /* ── fabric leads the section ─────────────────────────── */
  /* No card here, and no side-by-side label: the block reads top-down —
     rule, index and title, then the prose under them. */
  .cw-ai-feature {
    /* the head sits directly above this one, so it opens tighter than the
       category cards below — still balanced top-to-bottom, just closer in */
    margin-top: 2.2rem;
    padding-top: 2.2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }
  .cw-ai-copy {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-slate);
  }

  /* fabric grid — paper on cream so it reads lighter than the cards below */
  .cw-ai-weaves {
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .cw-ai-weave {
    padding: 1.3rem 1.3rem 1.45rem;
    background: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-steel) 13%, transparent);
    border-radius: 16px;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s ease, border-color 0.3s ease;
  }
  .cw-ai-weave:hover {
    transform: translateY(-3px);
    box-shadow: 0 28px 54px -38px color-mix(in srgb, var(--color-ink) 50%, transparent);
    border-color: color-mix(in srgb, var(--color-steel) 28%, transparent);
  }
  /* Rectangle across the card, text underneath. 3:2 matches the service
     figures elsewhere, so the set still reads as one family. */
  .cw-ai-weave-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-linen);
  }
  .cw-ai-weave-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04);
  }
  .cw-ai-weave-name {
    margin: 0.85rem 0 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.12rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-charcoal);
    font-variation-settings: 'opsz' 40;
  }
  .cw-ai-weave-note {
    margin: 0.5rem 0 0;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-slate);
  }

  /* ── the specify-anything areas ───────────────────────── */
  /* Same treatment as the fabric block above — a rule, then the index and
     title, then the content — so every area reads as one set rather than a
     stack of boxed cards. */
  .cw-ai-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  .cw-ai-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    margin-top: 3.4rem;
    padding-top: 3.4rem;
    border-top: 1px solid color-mix(in srgb, var(--color-steel) 16%, transparent);
  }
  .cw-ai-text .cw-ai-copy {
    margin-top: 0.8rem;
  }
  .cw-ai-text .cw-ai-list {
    margin-top: 1.1rem;
  }

  .cw-ai-num {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.00rem;
    letter-spacing: 0.08em;
    color: var(--color-berry);
    font-variation-settings: 'opsz' 40;
  }
  .cw-ai-title {
    margin: 0.4rem 0 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-charcoal);
    font-variation-settings: 'opsz' 48;
  }
  .cw-ai-fig {
    margin: 0;
    overflow: hidden;
    border-radius: 13px;
    background: var(--color-cream);
  }
  .cw-ai-fig img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* one grade across the set so the photos read as a family */
    filter: saturate(0.88) contrast(1.04);
  }

  .cw-ai-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem 1.5rem;
    align-content: center;
  }
  /* The spec list is set in Fraunces so it reads as a list of terms rather than
     more prose — the descriptive paragraph above it stays Manrope. */
  .cw-ai-list li {
    position: relative;
    padding-left: 1.1rem;
    font-family: var(--font-heading);
    font-weight: 540;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    line-height: 1.45;
    color: var(--color-charcoal);
    font-variation-settings: 'opsz' 40;
  }
  .cw-ai-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    border: 1.4px solid var(--color-berry);
  }

  @media (min-width: 560px) {
    .cw-ai-weaves {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 700px) {
    .cw-ai-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 920px) {
    .cw-ai-weaves {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.2rem;
    }
    /* the text and the image sit side by side, the image swapping sides on
       every other block so the run reads as a zigzag rather than a column */
    .cw-ai-card {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 3.2rem;
      align-items: center;
    }
    .cw-ai-card--flip {
      grid-template-columns: 380px minmax(0, 1fr);
    }
    .cw-ai-card--flip > .cw-ai-fig {
      grid-column: 1;
      grid-row: 1;
    }
    .cw-ai-card--flip > .cw-ai-text {
      grid-column: 2;
      grid-row: 1;
    }
    .cw-ai-list {
      grid-template-columns: repeat(2, 1fr);
      padding: 0;
    }
    /* a label too long for one column takes the whole row instead of wrapping */
    .cw-ai-item--wide {
      grid-column: 1 / -1;
    }
  }
</style>
