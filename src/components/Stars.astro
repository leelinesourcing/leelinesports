---
/**
 * Stars — a row of filled rating stars.
 * Decorative: the numeric rating beside it carries the meaning, so the row is
 * hidden from assistive tech. Tints via currentColor.
 */
interface Props {
  /** How many stars to draw. */
  count?: number
  className?: string
}
const { count = 5, className = '' } = Astro.props
---

<svg
  class={`cw-stars ${className}`}
  viewBox={`0 0 ${count * 24} 24`}
  fill="none"
  aria-hidden="true"
>
  {Array.from({ length: count }, (_, i) => (
    <path
      d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
      transform={`translate(${i * 24} 0)`}
      fill="currentColor"
    />
  ))}
</svg>

<style>
  .cw-stars {
    height: 15px;
    width: auto;
    flex: none;
    display: inline-block;
    vertical-align: -0.12em;
  }
</style>
