---
const cols = [
  { h: 'Verticals', links: ['Performance wear', 'Team sports', 'Swim & outdoor'] },
  { h: 'Company', links: ['About us', 'Case studies', 'Contact'] },
  { h: 'Support', links: ['FAQ', 'WhatsApp', 'Email'] },
];
---

<footer class="on-dark border-t border-white/10 bg-brand-primary text-white">
  <div class="mx-auto max-w-[1280px] px-5 pt-16 sm:px-8">
    <div class="grid gap-12 pb-14 lg:grid-cols-12">
      <!-- Brand -->
      <div class="lg:col-span-5">
        <a href="#top" class="inline-flex items-center gap-3" aria-label="LeelineSports home">
          <span class="grid h-12 place-items-center rounded-[3px] bg-white px-2.5">
            <img src="/images/redesign/image-01.png" alt="LeelineSports" class="h-7 w-auto" width="127" height="23" />
          </span>
        </a>
        <p class="mt-6 max-w-[38ch] text-[14px] leading-relaxed text-white/60">
          Custom sportswear manufacturing and supply-chain partner — bridging Chinese production and Western
          e-commerce with AQL 2.5 QC and DDP logistics.
        </p>
        <div class="mt-8 space-y-0 border-t border-white/10">
          <div class="spec">
            <span class="k">WhatsApp</span>
            <span class="lead"></span>
            <span class="v">+86 139 8615 2456</span>
          </div>
          <div class="spec">
            <span class="k">Email</span>
            <span class="lead"></span>
            <span class="v">info@leelinesports.com</span>
          </div>
          <div class="spec">
            <span class="k">Ground office</span>
            <span class="lead"></span>
            <span class="v">Wuhan, Hubei · CN</span>
          </div>
        </div>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-4">
        {cols.map((c) => (
          <div>
            <p class="mono mb-4 text-[10px] uppercase tracking-[0.22em] text-white/40">{c.h}</p>
            <ul class="space-y-3">
              {c.links.map((l) => (
                <li>
                  <a href="#top" class="text-[14px] text-white/70 transition-colors hover:text-brand-accent">{l}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Big mark -->
      <div class="lg:col-span-3 lg:text-right">
        <p class="font-heading text-[clamp(2.4rem,5vw,4rem)] font-bold leading-none tracking-[-0.04em] text-white/10">
          FIELD<br />MANUAL
        </p>
        <p class="mono mt-4 text-[10px] uppercase tracking-[0.2em] text-white/40">Doc no. LS-FM-2026-001 · Rev B</p>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-white/10 py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="mono text-[10px] uppercase tracking-[0.16em] text-white/40">© 2026 LeelineSports. All rights reserved.</p>
      <p class="mono text-[10px] uppercase tracking-[0.16em] text-brand-accent">We handle the mess. You handle the sales.</p>
    </div>
  </div>
</footer>
