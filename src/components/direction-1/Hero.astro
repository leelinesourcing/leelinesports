---
const specs = [
  { k: 'MOQ', v: '50–100 blanks · 200–300 custom' },
  { k: 'Quality control', v: 'AQL 2.5 · ISO 5077 · ISO 105' },
  { k: 'Logistics', v: 'DDP · Express 3–5d · Air 7–12d' },
];
---

<section id="top" class="hatch relative bg-brand-primary text-white">
  <!-- Document header bar -->
  <div class="border-b border-white/10">
    <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-x-8 gap-y-1.5 px-5 py-3 sm:px-8">
      <span class="mono text-[10px] uppercase tracking-[0.24em] text-white/45">LeelineSports — Field Manual</span>
      <span class="mono hidden text-[10px] uppercase tracking-[0.24em] text-white/45 md:inline">Doc no. LS-FM-2026-001 · Rev B</span>
      <span class="mono flex items-center gap-2 text-[10px] uppercase tracking-[0.24em] text-brand-accent">
        <span class="blink h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
        Status: Approved
      </span>
    </div>
  </div>

  <div class="mx-auto max-w-[1280px] px-5 sm:px-8">
    <div class="grid items-stretch gap-10 py-14 sm:py-20 lg:grid-cols-12 lg:gap-12 lg:py-24">
      <!-- Left: copy -->
      <div class="lg:col-span-7 lg:pr-4">
        <p class="ha mb-7 flex items-center gap-3" style="animation-delay:.05s">
          <span class="h-px w-10 bg-brand-accent"></span>
          <span class="mono text-[11px] uppercase tracking-[0.26em] text-white/55">Custom sportswear · OEM / ODM · Supply chain</span>
        </p>

        <h1 class="font-heading font-semibold leading-[0.94] tracking-[-0.035em] text-[clamp(2.7rem,7.2vw,6.1rem)]">
          <span class="ha block" style="animation-delay:.12s">We handle</span>
          <span class="ha block" style="animation-delay:.2s">the mess.</span>
          <span class="ha txt-outline block" style="animation-delay:.3s">You handle the sales.</span>
        </h1>

        <p class="ha mt-8 max-w-[52ch] text-[15px] leading-relaxed text-white/70 sm:text-[17px]" style="animation-delay:.42s">
          LeelineSports is the outsourced procurement department for your brand. Bring us a sketch or a
          tech pack — we return a landed, inspected, FBA-ready order. You never touch a shipment.
        </p>

        <div class="ha mt-9 flex flex-wrap items-center gap-3" style="animation-delay:.52s">
          <a href="#quote" class="btn-spring mono bg-brand-accent px-5 py-3.5 text-[12px] font-semibold uppercase tracking-[0.16em] text-brand-primary">
            Request a quote
          </a>
          <a href="https://wa.me/8613986152456" class="btn-spring mono border border-white/18 px-5 py-3.5 text-[12px] uppercase tracking-[0.16em] text-white/80 hover:border-brand-accent hover:text-brand-accent">
            WhatsApp +86 139 8615 2456
          </a>
        </div>

        <!-- Spec strip -->
        <div class="ha mt-12 max-w-[560px]" style="animation-delay:.64s">
          {specs.map((s) => (
            <div class="spec">
              <span class="k">{s.k}</span>
              <span class="lead"></span>
              <span class="v">{s.v}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: full-bleed image plate -->
      <div class="ha relative lg:col-span-5" style="animation-delay:.38s">
        <figure class="crop media relative h-full min-h-[320px] text-white/20">
          <img
            src="/images/redesign/image-11.avif"
            alt="Custom t-shirt production line under inspection in Wuhan"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            width="800"
            height="1000"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-primary/70 via-transparent to-brand-primary/10"></div>
          <!-- stamp -->
          <div class="absolute right-4 top-4 border border-white/40 bg-brand-primary/70 px-3 py-1.5 backdrop-blur-sm">
            <span class="mono text-[10px] uppercase tracking-[0.2em] text-white">Fig. 01 — AQL 2.5 pass</span>
          </div>
          <figcaption class="absolute inset-x-0 bottom-0 flex items-center justify-between px-4 pb-4 text-white/80">
            <span class="mono text-[10px] uppercase tracking-[0.2em]">Sample floor · Wuhan</span>
            <span class="mono text-[10px] uppercase tracking-[0.2em]">23.1186° N · 114.3552° E</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .txt-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);
  }
</style>
