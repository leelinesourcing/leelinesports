---
import SectionHead from './SectionHead.astro';

const icps = [
  { code: 'ICP-01', name: 'FBA Front-Runner', who: 'Solo Amazon private-label seller', bring: 'One winning SKU', handle: 'TOS-safe fabrics, poly-bag FBA prep, DDP landed cost' },
  { code: 'ICP-02', name: 'Gym Visionary', who: 'Gym / CrossFit owner', bring: 'Your logo', handle: 'XS–3XL sizing, sublimated (not heat-pressed) marks, 50-pc reorders' },
  { code: 'ICP-03', name: 'Influencer Icon', who: 'Creator launching a merch line', bring: 'A Pantone', handle: 'Exact color match, NDA, recycled fabrics' },
  { code: 'ICP-04', name: 'League Logician', who: 'Teams & schools procurement', bring: 'A deadline', handle: 'Consistent reorders, low MOQ, on-time delivery' },
  { code: 'ICP-05', name: 'Diversifying Retailer', who: '$1M+ e-commerce manager', bring: 'A supplier risk', handle: 'Redundancy, honest QC reports, Wuhan consolidation' },
];
---

<section id="icps" class="border-t border-brand-text/10 bg-brand-bg">
  <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-[62ch]">
      <SectionHead
        num="05"
        mark="Who this is for"
        title="You bring the brand. We bring the rest."
        intro="Five buyers run the same anxiety: importing from China without a ground team. Each one hands us a different problem — and the same result."
      />
    </div>

    <div class="crop mt-14 border border-brand-text/10 bg-white text-brand-primary/15">
      <div class="flex items-center justify-between border-b border-brand-text/10 px-5 py-3.5 sm:px-7">
        <span class="mono text-[11px] uppercase tracking-[0.22em] text-brand-muted">ICP manifest</span>
        <span class="mono text-[11px] uppercase tracking-[0.22em] text-brand-primary">5 profiles</span>
      </div>

      <div class="hidden border-b border-brand-text/10 md:grid md:grid-cols-[1.2fr_0.8fr_1.6fr] md:gap-6 md:px-7 md:py-3">
        <span class="mono text-[10px] uppercase tracking-[0.2em] text-brand-muted">Profile</span>
        <span class="mono text-[10px] uppercase tracking-[0.2em] text-brand-muted">You bring</span>
        <span class="mono text-[10px] uppercase tracking-[0.2em] text-brand-muted">We handle</span>
      </div>

      <div data-stagger>
        {icps.map((p) => (
          <div
            data-reveal="rise"
            class="group grid gap-3 border-b border-brand-text/10 px-5 py-6 last:border-b-0 hover:bg-brand-bg/50 sm:px-7 md:grid-cols-[1.2fr_0.8fr_1.6fr] md:gap-6 md:py-5"
          >
            <div>
              <span class="mono text-[10px] uppercase tracking-[0.2em] text-brand-accent">{p.code}</span>
              <h3 class="mt-1 font-heading text-[1.05rem] font-semibold tracking-[-0.01em] text-brand-text">{p.name}</h3>
              <p class="mt-0.5 text-[13px] text-brand-muted">{p.who}</p>
            </div>
            <div class="md:pt-1">
              <span class="mono mb-1 block text-[9px] uppercase tracking-[0.2em] text-brand-muted md:hidden">You bring</span>
              <p class="text-[14px] font-medium text-brand-text">{p.bring}</p>
            </div>
            <div class="md:pt-1">
              <span class="mono mb-1 block text-[9px] uppercase tracking-[0.2em] text-brand-muted md:hidden">We handle</span>
              <p class="text-[14px] leading-relaxed text-brand-muted">{p.handle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
