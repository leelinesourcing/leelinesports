---
const links = [
  { href: '#verticals', label: 'Verticals' },
  { href: '#deliver', label: 'Capabilities' },
  { href: '#process', label: 'Process' },
  { href: '#why-us', label: 'Why us' },
  { href: '#faq', label: 'FAQ' },
];
---
<header
  data-nav
  class="sticky top-0 z-50 border-b border-white/10 bg-brand-primary/95 backdrop-blur transition-all duration-300"
>
  <div class="mx-auto flex h-[68px] max-w-[1320px] items-center justify-between gap-4 px-5 sm:px-8">
    <!-- Title block -->
    <a href="#top" class="flex min-w-0 items-center gap-3" aria-label="LeelineSports home">
      <span class="grid h-11 shrink-0 place-items-center rounded-[3px] bg-white px-2.5 ring-1 ring-black/5">
        <img src="/images/redesign/image-01.png" alt="LeelineSports" class="h-6 w-auto" width="127" height="23" />
      </span>
      <span class="hidden flex-col leading-none sm:flex">
        <span class="mono text-[9px] uppercase tracking-[0.28em] text-brand-accent">Field Manual</span>
        <span class="mt-1.5 font-heading text-[13px] font-semibold tracking-tight text-white">Supply-chain partner</span>
      </span>
    </a>

    <!-- Links -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="group relative px-3 py-2 font-body text-[13px] font-medium text-white/70 transition-colors hover:text-white"
        >
          {l.label}
          <span class="absolute inset-x-3 bottom-0 h-px origin-left scale-x-0 bg-brand-accent transition-transform duration-300 ease-out group-hover:scale-x-100"></span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <a
        href="https://wa.me/8613986152456"
        class="mono hidden items-center gap-2 border border-white/15 px-3 py-2 text-[11px] uppercase tracking-[0.14em] text-white/75 transition-colors hover:border-brand-accent hover:text-brand-accent md:flex"
      >
        <span class="blink inline-block h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
        WhatsApp
      </a>
      <a
        href="#quote"
        class="btn-spring mono bg-brand-accent px-4 py-2.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-primary"
      >
        Request a quote
      </a>
      <button
        data-menu
        class="grid h-10 w-10 place-items-center border border-white/15 text-white lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- scroll progress -->
  <div class="absolute inset-x-0 top-0 h-[2px] bg-white/5">
    <div data-progress class="h-full origin-left bg-brand-accent" style="transform: scaleX(0)"></div>
  </div>

  <!-- Mobile menu -->
  <div data-menu-panel class="hidden border-t border-white/10 bg-brand-primary lg:hidden">
    <nav class="mx-auto flex max-w-[1320px] flex-col px-5 py-4" aria-label="Mobile">
      {links.map((l) => (
        <a
          href={l.href}
          class="flex items-center justify-between border-b border-white/10 py-3.5 font-body text-sm text-white/80 last:border-0 hover:text-brand-accent"
        >
          {l.label}
          <span class="mono text-[10px] tracking-[0.2em] text-white/35">→</span>
        </a>
      ))}
      <a
        href="https://wa.me/8613986152456"
        class="mono mt-3 flex items-center gap-2 border border-white/15 px-3 py-3 text-[11px] uppercase tracking-[0.14em] text-white/75"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
        WhatsApp +86 139 8615 2456
      </a>
    </nav>
  </div>
</header>

<style>
  .blink {
    animation: blink 2.4s ease-in-out infinite;
  }
  .is-scrolled {
    box-shadow: 0 1px 0 0 rgba(242, 163, 60, 0.45);
  }
  @media (prefers-reduced-motion: reduce) {
    .blink {
      animation: none;
    }
  }
</style>
