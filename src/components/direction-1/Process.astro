---
import SectionHead from './SectionHead.astro';

const steps = [
  { t: 'T+0', name: 'Discovery', body: 'Brief and tech-pack review. We qualify the product, the fabric, and the finish — then shortlist from 5,000+ vetted suppliers.', out: 'Matched supplier shortlist' },
  { t: 'T+3', name: 'Shortlist', body: 'Two or three factories matched to your spec, each quoted with full DDP landed cost so there is nothing hidden downstream.', out: 'Landed-cost quotes' },
  { t: 'T+7', name: 'Sampling', body: 'Physical samples in 5–10 days. Sample fees are refunded against the bulk order once you approve.', out: 'Approved sample' },
  { t: 'T+14', name: 'Production + QC', body: 'Bulk run under AQL 2.5 inspection with man-in-plant supervision. You receive the count, the pull, and the verdict.', out: 'QC report + photos' },
  { t: 'T+21', name: 'Delivery', body: 'DDP door-to-door — or poly-bagged, labeled, and injected straight into your Amazon FC.', out: 'FBA-ready units' },
];
---

<section id="process" class="grid-tex border-t border-brand-text/10 bg-brand-surface">
  <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <SectionHead
            num="04"
            mark="The process"
            title="Five steps. Twenty-one days."
            intro="A repeatable production sequence with a named deliverable at every gate — so the timeline is a contract, not a hope."
          />
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
            {[
              { k: 'Sampling', v: '5–10 days' },
              { k: 'Bulk lead', v: 'From 21 days' },
              { k: 'Pricing', v: 'DDP landed' },
            ].map((s) => (
              <div class="spec min-w-[180px] flex-1">
                <span class="k">{s.k}</span>
                <span class="lead"></span>
                <span class="v">{s.v}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Timeline -->
      <div class="lg:col-span-7">
        <ol class="relative border-l border-brand-text/15" data-stagger>
          {steps.map((s, i) => (
            <li data-reveal="slide-left" class="relative pb-10 pl-8 last:pb-0">
              <span class="absolute -left-[6px] top-1.5 h-3 w-3 border-2 border-brand-surface bg-brand-accent ring-1 ring-brand-text/20"></span>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="font-heading text-[2.4rem] font-bold leading-none tracking-[-0.04em] text-brand-text/15">
                  0{i + 1}
                </span>
                <span class="mono text-[11px] uppercase tracking-[0.2em] text-brand-accent">{s.t}</span>
              </div>
              <h3 class="mt-3 font-heading text-[1.35rem] font-semibold tracking-[-0.015em] text-brand-text">{s.name}</h3>
              <p class="mt-2 max-w-[52ch] text-[14px] leading-relaxed text-brand-muted">{s.body}</p>
              <p class="mono mt-3 text-[10px] uppercase tracking-[0.18em] text-brand-muted">
                Deliverable · <span class="text-brand-primary">{s.out}</span>
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
