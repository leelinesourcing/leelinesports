---
interface Props {
  num?: string;
  mark?: string;
  title: string;
  intro?: string;
  tone?: 'light' | 'dark';
}
const { num, mark, title, intro, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<header class="relative" data-reveal="rise">
  <div
    aria-hidden="true"
    class={`num-outline pointer-events-none absolute -top-5 -left-1 select-none font-heading font-bold leading-none text-[clamp(4.5rem,11vw,8.5rem)] tracking-[-0.04em] ${dark ? 'is-dark' : ''}`}
    style={`--num-stroke: ${dark ? 'rgba(255,255,255,0.16)' : 'rgba(15,27,45,0.14)'};`}
  >
    {num}
  </div>
  <div class="relative">
    {mark && (
      <p class="mb-6 flex items-center gap-3">
        <span class="h-px w-9 bg-brand-accent"></span>
        <span class={`mono text-[11px] uppercase tracking-[0.24em] ${dark ? 'text-white/55' : 'text-brand-muted'}`}>
          § {num} · {mark}
        </span>
      </p>
    )}
    <h2
      class={`font-heading text-[clamp(1.85rem,3.6vw,3.05rem)] leading-[1.03] tracking-[-0.025em] ${dark ? 'font-semibold text-white' : 'font-semibold text-brand-text'}`}
    >
      {title}
    </h2>
    {intro && (
      <p class={`mt-5 max-w-[58ch] text-[15px] leading-relaxed sm:text-base ${dark ? 'text-white/65' : 'text-brand-muted'}`}>
        {intro}
      </p>
    )}
  </div>
</header>

<style>
  .num-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--num-stroke);
    text-stroke: 1.5px var(--num-stroke);
  }
</style>
