---
import SectionHead from './SectionHead.astro';

const featured = {
  mark: 'TS-01',
  quote: 'We stopped answering freight forwarders. Leeline runs the whole lane, and I never touch a customs form.',
  name: 'Daniel R.',
  ctx: 'Amazon FBA seller · 3 SKUs → 11 SKUs',
};

const rest = [
  {
    mark: 'TS-02',
    quote: 'The AQL 2.5 report is the first thing I show our board. It is the reason we don’t lose sleep over a shipment.',
    name: 'Priya S.',
    ctx: 'Procurement lead · league apparel',
  },
  {
    mark: 'TS-03',
    quote: 'They caught a color drift at Grade 3 before it became a 5,000-unit problem.',
    name: 'Marcus T.',
    ctx: 'Founder · swim label',
  },
];
---

<section id="testimonials" class="grid-tex border-t border-brand-text/10 bg-brand-surface">
  <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 sm:py-28">
    <SectionHead
      num="08"
      mark="Testimonials"
      title="Said by people we shipped for."
    />

    <div class="mt-14 grid gap-10 lg:grid-cols-12">
      <!-- Featured -->
      <figure class="lg:col-span-7" data-reveal="rise">
        <div class="flex items-center gap-3 border-t border-brand-text/15 pt-4">
          <span class="font-heading text-[3rem] leading-none text-brand-accent" aria-hidden="true">“</span>
          <span class="mono text-[10px] uppercase tracking-[0.22em] text-brand-muted">{featured.mark}</span>
        </div>
        <blockquote class="mt-2 font-heading text-[clamp(1.5rem,2.7vw,2.3rem)] font-medium leading-[1.18] tracking-[-0.02em] text-brand-text">
          {featured.quote}
        </blockquote>
        <figcaption class="mt-6 flex items-center gap-4">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-primary font-heading text-[13px] font-bold text-white">
            DR
          </span>
          <div>
            <p class="text-[14px] font-semibold text-brand-text">{featured.name}</p>
            <p class="mono text-[11px] uppercase tracking-[0.14em] text-brand-muted">{featured.ctx}</p>
          </div>
          <span class="mono ml-auto text-[10px] uppercase tracking-[0.16em] text-brand-accent">Verified order</span>
        </figcaption>
      </figure>

      <!-- Supporting -->
      <div class="flex flex-col gap-10 lg:col-span-5 lg:border-l lg:border-brand-text/15 lg:pl-10">
        {rest.map((t) => (
          <figure data-reveal="slide-right">
            <div class="flex items-center gap-3 border-t border-brand-text/15 pt-4">
              <span class="font-heading text-[2rem] leading-none text-brand-accent" aria-hidden="true">“</span>
              <span class="mono text-[10px] uppercase tracking-[0.22em] text-brand-muted">{t.mark}</span>
            </div>
            <blockquote class="mt-2 font-heading text-[1.25rem] font-medium leading-[1.25] tracking-[-0.015em] text-brand-text">
              {t.quote}
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-secondary font-heading text-[12px] font-bold text-white">
                {t.name.split(' ').map((w) => w[0]).join('')}
              </span>
              <div>
                <p class="text-[13px] font-semibold text-brand-text">{t.name}</p>
                <p class="mono text-[10px] uppercase tracking-[0.14em] text-brand-muted">{t.ctx}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
