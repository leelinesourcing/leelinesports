---
import SectionHead from './SectionHead.astro';

const verticals = [
  {
    code: 'VS-01',
    name: 'Performance Wear',
    desc: 'Yoga, compression, and training wear built to hold color and shape across 100+ wash cycles.',
    img: '/images/redesign/image-06.webp',
    alt: 'Yoga apparel in production',
    offset: 'lg:mt-0',
    specs: [
      { k: 'Fabric', v: 'Recycled nylon / spandex · 4-way' },
      { k: 'MOQ', v: '200 pcs custom' },
      { k: 'Test', v: 'ISO 105 · Grade 4+' },
      { k: 'Sample', v: '5–10 days' },
    ],
  },
  {
    code: 'VS-02',
    name: 'Team Sports',
    desc: 'Sublimated jerseys, kits, and uniforms — full-bleed color, never heat-pressed or peeling.',
    img: '/images/redesign/image-08.avif',
    alt: 'Baseball team apparel',
    offset: 'lg:mt-14',
    specs: [
      { k: 'Process', v: 'Full dye-sublimation · no heat-press' },
      { k: 'MOQ', v: '50 blanks · 100 custom' },
      { k: 'Test', v: 'ISO 5077 · shrink ≤5%' },
      { k: 'Sample', v: '7–10 days' },
    ],
  },
  {
    code: 'VS-03',
    name: 'Swim & Outdoor',
    desc: 'UV swimwear and waterproof shells engineered for chlorine, salt, and sun exposure.',
    img: '/images/redesign/image-12.avif',
    alt: 'Custom swimwear samples',
    offset: 'lg:mt-28',
    specs: [
      { k: 'Fabric', v: 'UPF 50+ · seam-sealed shell' },
      { k: 'MOQ', v: '300 pcs custom' },
      { k: 'Test', v: 'AQL 2.5 + water column' },
      { k: 'Sample', v: '5–10 days' },
    ],
  },
];
---

<section id="verticals" class="border-t border-brand-text/10 bg-brand-bg">
  <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 sm:py-28">
    <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHead
        num="01"
        mark="Product verticals"
        title="Three verticals. One standard."
        intro="Performance, team, or swim — every line we cut ships under the same AQL 2.5 inspection, the same DDP landed pricing, and the same signed-off sample."
      />
      <a href="#quote" class="btn-spring group mono hidden shrink-0 items-center gap-2 text-[11px] uppercase tracking-[0.18em] text-brand-primary hover:text-brand-accent md:flex">
        Request a line sheet
        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-7">
      {verticals.map((v, i) => (
        <article
          data-reveal="rise"
          data-stagger
          class={`card-lift group flex flex-col bg-white ring-1 ring-brand-text/8 ${v.offset}`}
        >
          <!-- plate header -->
          <header class="flex items-center justify-between border-b border-brand-text/10 px-5 py-3.5">
            <span class="mono text-[10px] uppercase tracking-[0.22em] text-brand-muted">{v.code}</span>
            <span class="mono flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-brand-primary">
              <span class="h-1.5 w-1.5 bg-brand-primary/80"></span>
              Pass
            </span>
          </header>

          <div class="media relative aspect-[4/3] overflow-hidden bg-brand-surface">
            <img src={v.img} alt={v.alt} class="h-full w-full object-cover" loading="lazy" width="720" height="540" />
            <span class="absolute left-4 top-4 border border-brand-text/15 bg-white/85 px-2 py-1 font-heading text-[12px] font-semibold tracking-[-0.01em] text-brand-primary backdrop-blur-sm">
              0{i + 1}
            </span>
          </div>

          <div class="flex flex-1 flex-col px-5 pb-5 pt-4">
            <h3 class="font-heading text-[1.35rem] font-semibold tracking-[-0.02em] text-brand-text">{v.name}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-brand-muted">{v.desc}</p>
            <div class="mt-5">
              {v.specs.map((s) => (
                <div class="spec">
                  <span class="k">{s.k}</span>
                  <span class="lead"></span>
                  <span class="v">{s.v}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
