---
import Stitch from './Stitch.astro'

const cases = [
  {
    img: '/images/redesign/image-02.webp',
    kicker: 'Compression wear · Amazon',
    title: 'A two-person brand turned one sketch into three SKUs.',
    before: 'No factory, no tech pack, zero inventory knowledge.',
    after: '3 SKUs at MOQ 200 · $40k/mo on Amazon in six months · 0.4% defect rate.',
    metric: ['MOQ 500 → 200', 'Defect 6% → 0.4%', 'Lead 12wks → 5wks'],
    attr: 'Founder, compression-wear label · Austin, TX',
  },
  {
    img: '/images/redesign/image-11.avif',
    kicker: 'Team apparel · CrossFit network',
    title: 'Four boxes needed matching tees in XS–3XL.',
    before: 'Cracked prints after a single season of training.',
    after: '2,400 sublimated tees, delivered DDP in five weeks, reorders in 10 days.',
    metric: ['Sizes XS–3XL', '2,400 units', 'Reorder 10d'],
    attr: 'Owner, 4-location box network · Phoenix, AZ',
  },
  {
    img: '/images/redesign/image-12.avif',
    kicker: 'Swim & outdoor · UPF line',
    title: 'A swimwear line that couldn’t hit UPF 50+.',
    before: 'Colorfastness failing at Grade 2 under chlorine.',
    after: '1,200 units, Grade 4+ colorfast, sea freight landed in 32 days.',
    metric: ['Grade 2 → 4+', '1,200 units', '32d sea DDP'],
    attr: 'Ops lead, outdoor swim brand · San Diego, CA',
  },
]
---

<section class="d2-cases" id="cases">
  <div class="d2-wrap">
    <div class="d2-cases-head">
      <p class="d2-eyebrow" data-reveal="up">Real results</p>
      <h2 class="d2-h2" data-reveal="up" style="--rd:80ms">Sketch in. Brand out.</h2>
      <p class="d2-lede" data-reveal="up" style="--rd:160ms">
        Three briefs that arrived as napkin drawings and left as finished cartons.
      </p>
    </div>

    <div class="d2-cases-list">
      {cases.map((c, i) => (
        <article class={`d2-case${i % 2 === 1 ? ' d2-case--flip' : ''}`}>
          <div class="d2-case-media" data-reveal={i % 2 === 0 ? 'left' : 'right'}>
            <img src={c.img} alt={c.kicker} loading="lazy" width="550" height="525" />
          </div>
          <div class="d2-case-body" data-reveal={i % 2 === 0 ? 'right' : 'left'}>
            <p class="d2-case-kicker">{c.kicker}</p>
            <h3 class="d2-case-title">{c.title}</h3>
            <div class="d2-case-delta">
              <p class="d2-case-before"><span>before</span>{c.before}</p>
              <p class="d2-case-after"><span>after</span>{c.after}</p>
            </div>
            <div class="d2-case-metrics">
              {c.metric.map((m) => (
                <span class="d2-case-metric">{m}</span>
              ))}
            </div>
            <p class="d2-case-attr">{c.attr}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="d2-cases-foot" data-reveal="up"><Stitch /></div>
  </div>
</section>

<style>
  .d2-cases {
    padding: 6rem 0 5rem;
    background: var(--color-brand-surface);
  }
  .d2-cases-head {
    max-width: 44rem;
  }
  .d2-cases-list {
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .d2-case {
    display: grid;
    gap: 1.75rem;
  }
  .d2-case-media {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1 / 0.82;
  }
  .d2-case-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .d2-case-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, transparent 55%, rgba(30, 42, 36, 0.4));
  }
  .d2-case-body {
    align-self: center;
  }
  .d2-case-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-brand-secondary);
  }
  .d2-case-title {
    margin: 0.6rem 0 0;
    font-family: var(--font-heading);
    font-weight: 540;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-brand-primary);
    font-variation-settings: 'opsz' 48;
  }
  .d2-case-delta {
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .d2-case-before,
  .d2-case-after {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .d2-case-before {
    color: var(--color-brand-muted);
    text-decoration: line-through;
    text-decoration-color: rgba(138, 106, 59, 0.5);
  }
  .d2-case-after {
    color: var(--color-brand-text);
    font-weight: 600;
  }
  .d2-case-before span,
  .d2-case-after span {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: 0.6rem;
  }
  .d2-case-before span {
    color: var(--color-brand-muted);
  }
  .d2-case-after span {
    color: var(--color-brand-accent);
  }
  .d2-case-metrics {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .d2-case-metric {
    padding: 0.35rem 0.75rem;
    background: var(--color-brand-surface);
    border: 1px solid rgba(138, 106, 59, 0.25);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-brand-primary);
  }
  .d2-case-attr {
    margin: 1.2rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-brand-muted);
  }
  .d2-cases-foot {
    margin-top: 3.5rem;
  }

  @media (min-width: 880px) {
    .d2-case {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }
    .d2-case--flip .d2-case-media {
      order: 2;
    }
    .d2-case--flip .d2-case-body {
      order: 1;
    }
  }
</style>
