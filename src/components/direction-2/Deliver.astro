---
const capabilities = [
  {
    t: 'OEM',
    d: 'Your tech pack, cut and sewn to tolerance. Nothing reinterpreted, nothing “close enough”.',
    spec: 'Shrinkage ≤3–5% (ISO 5077) · AQL 2.5 every run',
    wide: true,
  },
  {
    t: 'ODM',
    d: 'Your sketch, our pattern room. We grade it, sample it, and hand you a spec you own.',
    spec: '5–10 day pre-production sample, refundable on bulk',
    wide: true,
  },
  {
    t: 'FBA Prep',
    d: 'Barcoded, poly-bagged and injected straight into Amazon FCs.',
    spec: 'TOS-safe, FBA-native',
    wide: false,
  },
  {
    t: 'QC',
    d: 'Inspected, not promised. We don’t take the factory’s word for it.',
    spec: 'AQL 2.5 major / 4.0 minor · live video',
    wide: false,
  },
  {
    t: 'Logistics',
    d: 'DDP to your door — duties paid, no line items at the dock.',
    spec: 'Express 3–5d · Air 7–12d · Sea 25–40d',
    wide: false,
  },
]
---

<section class="d2-deliver" id="deliver">
  <div class="d2-wrap">
    <div class="d2-deliver-head">
      <p class="d2-eyebrow d2-eyebrow--light" data-reveal="up">What we deliver</p>
      <h2 class="d2-h2 d2-h2--light" data-reveal="mask" style="--rd:80ms">
        The whole floor, under one roof.
      </h2>
      <p class="d2-lede d2-lede--light" data-reveal="up" style="--rd:160ms">
        Five capabilities a factory won’t give you and an agent would charge you for. Ours, in-house,
        on the floor in Wuhan.
      </p>
    </div>

    <div class="d2-cap-grid">
      {capabilities.map((c, i) => (
        <article
          class={`d2-cap${c.wide ? ' d2-cap--wide' : ''}`}
          data-reveal={i % 2 === 0 ? 'up' : 'scale'}
          style={`--rd:${i * 70}ms`}
        >
          <svg class="d2-cap-mark" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <g transform="rotate(38 14 14)">
              <path d="M7.4 15 C3.4 8.8 3.6 2.6 9.6 2.1 C15.4 1.7 17.8 8.8 12 12.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              <path fill-rule="evenodd" fill="currentColor" d="M2.5 10.7 H16.6 L20.4 12.5 L16.6 14.3 H2.5 Z M5.4 11.35 a1.35 0.85 0 1 0 2.7 0 a1.35 0.85 0 1 0 -2.7 0 Z" />
            </g>
          </svg>
          <h3 class="d2-cap-title">{c.t}</h3>
          <p class="d2-cap-desc">{c.d}</p>
          <p class="d2-cap-spec">{c.spec}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .d2-deliver {
    background: var(--color-brand-primary);
    padding: 6rem 0 6rem;
    position: relative;
  }
  .d2-deliver-head {
    max-width: 44rem;
  }
  .d2-cap-grid {
    margin-top: 3.5rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .d2-cap {
    background: rgba(246, 241, 231, 0.045);
    border: 1px solid rgba(200, 162, 75, 0.22);
    border-radius: 22px;
    padding: 1.7rem 1.6rem;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.4s ease, border-color 0.4s ease;
  }
  .d2-cap:hover {
    transform: translateY(-6px);
    background: rgba(246, 241, 231, 0.07);
    border-color: rgba(200, 162, 75, 0.5);
  }
  .d2-cap-mark {
    width: 26px;
    height: 26px;
    color: var(--color-brand-accent);
  }
  .d2-cap-title {
    margin: 1rem 0 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    color: var(--color-brand-bg);
    font-variation-settings: 'opsz' 48;
  }
  .d2-cap-desc {
    margin: 0.6rem 0 0;
    font-size: 0.97rem;
    line-height: 1.6;
    color: rgba(246, 241, 231, 0.72);
  }
  .d2-cap-spec {
    margin: 1.1rem 0 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-brand-accent);
  }

  @media (min-width: 720px) {
    .d2-cap-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .d2-cap--wide {
      grid-column: span 1;
    }
  }
  @media (min-width: 1000px) {
    .d2-cap-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .d2-cap--wide {
      grid-column: span 3;
    }
    .d2-cap:not(.d2-cap--wide) {
      grid-column: span 2;
    }
  }
</style>
