---
import Stitch from './Stitch.astro'

const faqs = [
  { q: 'What’s the real minimum order?', a: 'Fifty to 100 units on stock blanks, and 200–300 on custom private label. That’s low enough to test a niche without betting the rent — and high enough to keep a factory honest.' },
  { q: 'How do you protect my IP?', a: 'We sign an NDA before we see your tech pack. Patterns, grading and Pantone specs are registered to you, and your product is never white-labelled to another account.' },
  { q: 'What does DDP actually include?', a: 'Manufacturing, freight and duties in a single number. When your carton arrives, there’s nothing left to pay and nothing for customs to hold.' },
  { q: 'How does QC work?', a: 'Every lot is inspected to AQL 2.5 for major defects and 4.0 for minor ones — at 30%, 60% and 100% through production. You can watch it live on video, and we keep a man-in-plant on the floor.' },
  { q: 'I only have a sketch. Is that enough?', a: 'That’s the point of the atelier. Our ODM pattern room turns a sketch or reference into a graded spec, then a 5–10 day sample you approve before anything is cut.' },
  { q: 'What if the sample isn’t right?', a: 'Sample fees are refundable against your bulk order, and we iterate until it matches the spec. You don’t pay for our learning curve.' },
]
---

<section class="d2-faq" id="faq">
  <div class="d2-wrap d2-faq-grid">
    <div class="d2-faq-head">
      <p class="d2-eyebrow" data-reveal="up">Questions</p>
      <h2 class="d2-h2" data-reveal="up" style="--rd:80ms">Asked, answered, in numbers.</h2>
      <p class="d2-lede" data-reveal="up" style="--rd:160ms">
        Anything else, ask us directly — we reply within one business day.
      </p>
      <a class="d2-btn d2-btn--forest" href="mailto:info@leelinesports.com" data-reveal="up" style="--rd:240ms">
        info@leelinesports.com
      </a>
    </div>

    <div class="d2-faq-list">
      {faqs.map((f, i) => (
        <details class="d2-faq-item" data-reveal="up" style={`--rd:${i * 50}ms`} open={i === 0}>
          <summary class="d2-faq-q">
            {f.q}
            <span class="d2-faq-toggle" aria-hidden="true"></span>
          </summary>
          <div class="d2-faq-a">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>

  <div class="d2-wrap" data-reveal="up"><Stitch /></div>
</section>

<style>
  .d2-faq {
    padding: 6rem 0 5rem;
    background: var(--color-brand-surface);
  }
  .d2-faq-grid {
    display: grid;
    gap: 3rem;
  }
  .d2-faq-head {
    max-width: 36rem;
  }
  .d2-faq-head .d2-btn {
    margin-top: 1.6rem;
  }
  .d2-faq-list {
    display: flex;
    flex-direction: column;
  }
  .d2-faq-item {
    border-bottom: 1px dashed rgba(138, 106, 59, 0.3);
  }
  .d2-faq-item:first-child {
    border-top: 1px dashed rgba(138, 106, 59, 0.3);
  }
  .d2-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.3rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: 540;
    font-size: 1.18rem;
    letter-spacing: -0.01em;
    color: var(--color-brand-primary);
    font-variation-settings: 'opsz' 30;
  }
  .d2-faq-q::-webkit-details-marker {
    display: none;
  }
  .d2-faq-toggle {
    flex: none;
    width: 26px;
    height: 26px;
    position: relative;
    border: 1px solid rgba(138, 106, 59, 0.4);
    border-radius: 50%;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  .d2-faq-toggle::before,
  .d2-faq-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-brand-accent);
    transition: transform 0.4s ease;
  }
  .d2-faq-toggle::before {
    width: 10px;
    height: 2px;
    transform: translate(-50%, -50%);
  }
  .d2-faq-toggle::after {
    width: 2px;
    height: 10px;
    transform: translate(-50%, -50%);
  }
  .d2-faq-item[open] .d2-faq-toggle {
    transform: rotate(135deg);
    background: var(--color-brand-accent);
  }
  .d2-faq-item[open] .d2-faq-toggle::before,
  .d2-faq-item[open] .d2-faq-toggle::after {
    background: var(--color-brand-primary);
  }
  .d2-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .d2-faq-a p {
    overflow: hidden;
    min-height: 0;
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-brand-muted);
    max-width: 56ch;
  }
  .d2-faq-item[open] .d2-faq-a {
    grid-template-rows: 1fr;
    padding-bottom: 1.4rem;
  }

  @media (min-width: 960px) {
    .d2-faq-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 4rem;
    }
  }
</style>
