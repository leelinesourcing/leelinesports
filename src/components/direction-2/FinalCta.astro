---
---

<section class="d2-cta" id="quote">
  <div class="d2-wrap d2-cta-grid">
    <div class="d2-cta-copy">
      <p class="d2-eyebrow d2-eyebrow--light" data-reveal="up">Start the brief</p>
      <h2 class="d2-h2 d2-h2--light" data-reveal="mask" style="--rd:80ms">Bring us the sketch.</h2>
      <p class="d2-lede d2-lede--light" data-reveal="up" style="--rd:160ms">
        Send the brief and we’ll come back within one business day with MOQ, spec and a DDP price —
        not a sales pitch.
      </p>

      <div class="d2-cta-contacts" data-reveal="up" style="--rd:240ms">
        <a class="d2-cta-contact" href="https://wa.me/8613986152456" target="_blank" rel="noopener">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 0 0-6.9 12L2 18l4.1-1.1A8 8 0 1 0 10 2Zm0 1.6a6.4 6.4 0 1 1-3.4 11.9l-.4-.24-2.3.6.6-2.2-.25-.4A6.4 6.4 0 0 1 10 3.6Zm-2 3a.8.8 0 0 0-.6.3c-.2.3-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 4 3.4 2 .8 2.4.7 2.8.6.4-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1-.1-.1-.3-.2-.6-.3l-1.5-.7c-.2-.1-.4-.1-.6.1l-.7.9c-.2.2-.4.2-.6.1a6 6 0 0 1-1.9-1.2 7 7 0 0 1-1.3-1.6c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3.2-.5s0-.3-.1-.4l-.7-1.6a.5.5 0 0 0-.3-.2H8Z"/></svg>
          <span class="d2-cta-contact-body"><em>WhatsApp</em> +86 139 8615 2456</span>
        </a>
        <a class="d2-cta-contact" href="mailto:info@leelinesports.com">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h11A2.5 2.5 0 0 1 18 5.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 2 14.5v-9Zm1.6.3v8.7A.9.9 0 0 0 4.5 15h11a.9.9 0 0 0 .9-.9V5.8l-5.9 4a.9.9 0 0 1-1 0l-5.9-4Zm11.8-.8h-.4L10 8.9 4.9 5h10.5Z"/></svg>
          <span class="d2-cta-contact-body"><em>Email</em> info@leelinesports.com</span>
        </a>
      </div>
      <p class="d2-cta-note" data-reveal="up" style="--rd:320ms">
        NDA before anything leaves your inbox. Your tech pack stays yours.
      </p>
    </div>

    <form class="d2-form" id="quote-form" data-reveal="right">
      <div class="d2-form-stitch" aria-hidden="true"></div>

      <div class="d2-field">
        <label for="f-name">Name</label>
        <input id="f-name" name="name" type="text" placeholder="Alex Morgan" autocomplete="name" required />
      </div>
      <div class="d2-field">
        <label for="f-company">Company</label>
        <input id="f-company" name="company" type="text" placeholder="Your brand or store" autocomplete="organization" />
      </div>
      <div class="d2-field-row">
        <div class="d2-field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" placeholder="you@brand.com" autocomplete="email" required />
        </div>
        <div class="d2-field">
          <label for="f-phone">Phone / WhatsApp</label>
          <input id="f-phone" name="phone" type="tel" placeholder="+1 555 000 0000" autocomplete="tel" />
        </div>
      </div>
      <div class="d2-field-row">
        <div class="d2-field">
          <label for="f-type">Product type</label>
          <select id="f-type" name="type">
            <option value="">Select…</option>
            <option>Performance wear</option>
            <option>Team sports</option>
            <option>Swim & outdoor</option>
            <option>Blanks / stock</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="d2-field">
          <label for="f-moq">Order size</label>
          <select id="f-moq" name="moq">
            <option value="">Select…</option>
            <option>50–100 (blanks)</option>
            <option>200–300 (custom)</option>
            <option>500–1,000</option>
            <option>1,000+</option>
            <option>Not sure yet</option>
          </select>
        </div>
      </div>
      <div class="d2-field">
        <label for="f-date">Target date</label>
        <input id="f-date" name="date" type="date" />
      </div>

      <button class="d2-btn d2-btn--brass d2-btn--block" type="submit">Send the brief</button>
      <p class="d2-form-note" id="form-note" hidden>Received. We’ll reply within one business day with MOQ, spec and a DDP price.</p>
    </form>
  </div>
</section>

<style>
  .d2-cta {
    background: var(--color-brand-primary);
    padding: 7rem 0 7rem;
  }
  .d2-cta-grid {
    display: grid;
    gap: 3rem;
  }
  .d2-cta-copy {
    max-width: 42rem;
  }
  .d2-cta-contacts {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .d2-cta-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: var(--color-brand-bg);
    padding: 0.8rem 1rem;
    border: 1px solid rgba(200, 162, 75, 0.3);
    border-radius: 14px;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .d2-cta-contact:hover {
    border-color: rgba(200, 162, 75, 0.7);
    background: rgba(200, 162, 75, 0.08);
    transform: translateX(4px);
  }
  .d2-cta-contact svg {
    width: 22px;
    height: 22px;
    color: var(--color-brand-accent);
    flex: none;
  }
  .d2-cta-contact-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .d2-cta-contact-body em {
    font-style: normal;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
  }
  .d2-cta-note {
    margin: 1.2rem 0 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(246, 241, 231, 0.55);
  }

  .d2-form {
    background: var(--color-brand-bg);
    border-radius: 26px;
    padding: 2rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    box-shadow: 0 50px 110px -50px rgba(0, 0, 0, 0.65);
  }
  .d2-form-stitch {
    height: 6px;
    background-image:
      repeating-linear-gradient(90deg, var(--color-brand-accent) 0 6px, transparent 6px 14px),
      repeating-linear-gradient(90deg, transparent 0 3px, var(--color-brand-accent) 3px 9px, transparent 9px 14px);
    background-size: 100% 1.6px, 100% 1.6px;
    background-position: 0 0, 0 5px;
    background-repeat: no-repeat;
    margin-bottom: 0.4rem;
  }
  .d2-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .d2-field label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-brand-secondary);
  }
  .d2-field input,
  .d2-field select {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--color-brand-surface);
    border: 1px solid rgba(138, 106, 59, 0.25);
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-brand-text);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .d2-field input:focus,
  .d2-field select:focus {
    outline: none;
    border-color: var(--color-brand-accent);
    box-shadow: 0 0 0 3px rgba(200, 162, 75, 0.22);
  }
  .d2-field-row {
    display: grid;
    gap: 1.1rem;
  }
  .d2-form-note {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-brand-secondary);
    text-align: center;
  }

  @media (min-width: 720px) {
    .d2-field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 960px) {
    .d2-cta-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .d2-form {
      padding: 2.4rem 2.2rem;
    }
  }
</style>
