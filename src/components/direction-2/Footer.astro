---
import Stitch from './Stitch.astro'
---

<footer class="d2-footer" id="footer">
  <div class="d2-wrap">
    <div class="d2-footer-top">
      <div class="d2-footer-brand">
        <a href="#top" class="d2-footer-logo" aria-label="LeelineSports — home">
          <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g transform="rotate(38 14 14)">
              <path d="M7.4 15 C3.4 8.8 3.6 2.6 9.6 2.1 C15.4 1.7 17.8 8.8 12 12.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              <path fill-rule="evenodd" fill="currentColor" d="M2.5 10.7 H16.6 L20.4 12.5 L16.6 14.3 H2.5 Z M5.4 11.35 a1.35 0.85 0 1 0 2.7 0 a1.35 0.85 0 1 0 -2.7 0 Z" />
            </g>
          </svg>
          <span class="d2-footer-word">Leeline<em>Sports</em></span>
        </a>
        <p class="d2-footer-tagline">We handle the mess. You handle the sales.</p>
      </div>

      <div class="d2-footer-cols">
        <nav class="d2-footer-col" aria-label="Verticals">
          <span class="d2-footer-h">Verticals</span>
          <a href="#verticals">Performance wear</a>
          <a href="#verticals">Team sports</a>
          <a href="#verticals">Swim & outdoor</a>
        </nav>
        <nav class="d2-footer-col" aria-label="Company">
          <span class="d2-footer-h">Company</span>
          <a href="#deliver">What we deliver</a>
          <a href="#process">Process</a>
          <a href="#proof">Proof</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="d2-footer-col">
          <span class="d2-footer-h">Contact</span>
          <a href="https://wa.me/8613986152456" target="_blank" rel="noopener">WhatsApp +86 139 8615 2456</a>
          <a href="mailto:info@leelinesports.com">info@leelinesports.com</a>
          <span class="d2-footer-loc">Wuhan, Hubei · China</span>
        </div>
      </div>
    </div>

    <div class="d2-footer-stitch">
      <Stitch color="rgba(200,162,75,0.55)" />
    </div>

    <div class="d2-footer-bottom">
      <div class="d2-footer-registered">
        <span class="d2-footer-registered-mark">
          <img src="/images/redesign/image-01.png" alt="LeelineSports registered mark" width="158" height="29" loading="lazy" />
        </span>
        <span class="d2-footer-registered-caption">Registered mark · LeelineSports Co., Ltd.</span>
      </div>
      <p class="d2-footer-legal">© 2026 LeelineSports. AQL 2.5 · ISO 5077 · ISO 105 · DDP.</p>
    </div>
  </div>
</footer>

<style>
  .d2-footer {
    background: var(--color-brand-primary);
    padding: 5rem 0 2.5rem;
    color: var(--color-brand-bg);
  }
  .d2-footer-top {
    display: grid;
    gap: 2.5rem;
  }
  .d2-footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    line-height: 1;
  }
  .d2-footer-logo svg {
    width: 30px;
    height: 30px;
    color: var(--color-brand-accent);
  }
  .d2-footer-word {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    color: var(--color-brand-bg);
  }
  .d2-footer-word em {
    font-style: italic;
    font-weight: 400;
  }
  .d2-footer-tagline {
    margin: 0.9rem 0 0;
    font-size: 0.98rem;
    font-weight: 600;
    color: rgba(246, 241, 231, 0.6);
  }
  .d2-footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .d2-footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .d2-footer-h {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-accent);
    margin-bottom: 0.3rem;
  }
  .d2-footer-col a,
  .d2-footer-loc {
    font-size: 0.92rem;
    font-weight: 600;
    color: rgba(246, 241, 231, 0.75);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .d2-footer-col a:hover {
    color: var(--color-brand-bg);
  }
  .d2-footer-loc {
    color: rgba(246, 241, 231, 0.5);
  }
  .d2-footer-stitch {
    margin: 2.5rem 0;
  }
  .d2-footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    align-items: flex-start;
  }
  .d2-footer-registered {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .d2-footer-registered-mark {
    display: inline-flex;
    background: #ffffff;
    border-radius: 10px;
    padding: 0.5rem 0.7rem;
  }
  .d2-footer-registered-mark img {
    display: block;
    height: 29px;
    width: auto;
  }
  .d2-footer-registered-caption {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(246, 241, 231, 0.45);
  }
  .d2-footer-legal {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(246, 241, 231, 0.45);
  }

  @media (min-width: 720px) {
    .d2-footer-cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
    .d2-footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  @media (min-width: 960px) {
    .d2-footer-top {
      grid-template-columns: 1.1fr 1.4fr;
      gap: 4rem;
    }
  }
</style>
