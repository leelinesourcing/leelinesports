---
---

<section class="d2-hero" id="top" data-hero>
  <div class="d2-hero-media">
    <img
      src="/images/redesign/image-06.webp"
      alt=""
      width="550"
      height="525"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="d2-hero-veil" aria-hidden="true"></div>

  <!-- floating swatch chip -->
  <div class="d2-hero-chip" aria-hidden="true">
    <span class="d2-hero-chip-label">fabric card</span>
    <span class="d2-swatch-row">
      <i style="background:#1E2A24"></i>
      <i style="background:#8A6A3B"></i>
      <i style="background:#C8A24B"></i>
      <i style="background:#F6F1E7"></i>
    </span>
    <span class="d2-hero-chip-code">Grade 4+ colorfast · ISO 105</span>
  </div>

  <div class="d2-hero-content">
    <div class="d2-hero-item" style="--rd:0ms">
      <p class="d2-eyebrow d2-eyebrow--light">Custom sportswear, made to your spec</p>
    </div>

    <h1 class="d2-h1 d2-hero-item" style="--rd:90ms">
      You bring the <em>sketch</em>.<br />
      We ship the <span class="d2-underline">brand</span>.
    </h1>

    <p class="d2-hero-sub d2-hero-item" style="--rd:200ms">
      LeelineSports is the atelier behind private-label sportswear — sourcing, QC and DDP logistics
      handled end-to-end, from a napkin drawing to a branded carton at the Amazon dock.
    </p>

    <div class="d2-hero-cta d2-hero-item" style="--rd:300ms">
      <a class="d2-btn d2-btn--brass" href="#quote">Request a quote</a>
      <a class="d2-btn d2-btn--ghost" href="https://wa.me/8613986152456" target="_blank" rel="noopener">
        WhatsApp&nbsp;+86&nbsp;139&nbsp;8615&nbsp;2456
      </a>
    </div>

    <div class="d2-hero-trust d2-hero-item" style="--rd:420ms">
      <span>AQL 2.5 QC</span>
      <span>DDP pricing</span>
      <span>5–10 day sampling</span>
      <span>No surprises at the dock</span>
    </div>
  </div>

  <svg class="d2-hero-stitch" viewBox="0 0 40 340" preserveAspectRatio="none" aria-hidden="true">
    <line x1="20" y1="0" x2="20" y2="340" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 10" stroke-linecap="round" class="d2-hero-stitch-path" />
  </svg>
</section>

<style>
  .d2-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-brand-primary);
  }
  .d2-hero-media {
    position: absolute;
    inset: 0;
  }
  .d2-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 30%;
    animation: d2-hero-zoom 16s ease-out forwards;
  }
  .d2-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(200deg, rgba(30, 42, 36, 0.88) 0%, rgba(30, 42, 36, 0.62) 38%, rgba(30, 42, 36, 0.12) 72%, rgba(30, 42, 36, 0.45) 100%);
  }
  .d2-hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 8.5rem 1.5rem 4.5rem;
  }
  .d2-h1 {
    margin: 1.4rem 0 0;
    color: var(--color-brand-bg);
  }
  .d2-h1 em {
    font-style: italic;
    font-weight: 440;
    letter-spacing: -0.045em;
  }
  .d2-underline {
    position: relative;
    white-space: nowrap;
  }
  .d2-underline::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 0.13em;
    background: repeating-linear-gradient(90deg, var(--color-brand-accent) 0 10px, transparent 10px 16px);
    border-radius: 2px;
  }
  .d2-hero-sub {
    max-width: 34ch;
    margin: 1.6rem 0 0;
    font-size: 1.08rem;
    line-height: 1.6;
    color: rgba(246, 241, 231, 0.82);
  }
  .d2-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }
  .d2-hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 2.4rem;
  }
  .d2-hero-trust span {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: rgba(246, 241, 231, 0.66);
  }
  .d2-hero-trust span::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-accent);
    margin-right: 0.6rem;
    vertical-align: 0.12em;
  }

  /* vertical running stitch on the left */
  .d2-hero-stitch {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 340px;
    color: var(--color-brand-accent);
    z-index: 2;
    display: none;
  }
  .d2-hero-stitch-path {
    stroke-dasharray: 2 10;
    stroke-dashoffset: 340;
    animation: d2-stitch-draw 2.6s 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* floating swatch chip */
  .d2-hero-chip {
    position: absolute;
    right: 6%;
    top: 24%;
    z-index: 2;
    background: rgba(246, 241, 231, 0.92);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(138, 106, 59, 0.2);
    border-radius: 16px;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.55);
    animation: d2-float 7s ease-in-out infinite;
    transform-origin: 50% 50%;
  }
  .d2-hero-chip-label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-brand-secondary);
  }
  .d2-swatch-row {
    display: flex;
    gap: 5px;
  }
  .d2-swatch-row i {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .d2-hero-chip-code {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-brand-text);
  }

  /* entrance */
  .d2-hero-item {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    transition-delay: var(--rd, 0ms);
    will-change: opacity, transform;
  }
  .d2-hero.is-in .d2-hero-item {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 720px) {
    .d2-hero-stitch {
      display: block;
    }
    .d2-hero-content {
      padding-left: 4.5rem;
    }
  }
  @media (max-width: 719px) {
    .d2-hero-chip {
      display: none;
    }
  }

  @keyframes d2-hero-zoom {
    from { transform: scale(1.12); }
    to { transform: scale(1.02); }
  }
  @keyframes d2-stitch-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes d2-float {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50% { transform: translateY(-12px) rotate(1.5deg); }
  }
</style>
