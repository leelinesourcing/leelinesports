---
import Stitch from './Stitch.astro'

const icps = [
  { name: 'The FBA Front-Runner', bring: 'a niche and a listing', handle: 'TOS-safe packaging and customs, handled' },
  { name: 'The Gym Visionary', bring: 'your box’s name and a logo', handle: 'XS–3XL sublimation — dye, never heat-press' },
  { name: 'The Influencer Icon', bring: 'a drop concept and a moodboard', handle: 'Pantone matching, NDA, recycled fabrics' },
  { name: 'The League Logician', bring: '12 rosters and a deadline', handle: 'consistent reorders at low MOQ' },
  { name: 'The Diversifying Retailer', bring: '$1M in sales and one supplier', handle: 'supply-chain redundancy and honest QC reports' },
]
---

<section class="d2-icps" id="icps">
  <div class="d2-wrap">
    <div class="d2-icps-head">
      <p class="d2-eyebrow" data-reveal="up">Who this is for</p>
      <h2 class="d2-h2" data-reveal="up" style="--rd:80ms">You bring the idea. We bring the floor.</h2>
    </div>

    <div class="d2-icps-list">
      {icps.map((p, i) => (
        <div class="d2-icp" data-reveal="left" style={`--rd:${i * 50}ms`}>
          <h3 class="d2-icp-name">{p.name}</h3>
          <div class="d2-icp-bring">
            <span class="d2-icp-k">you bring</span>
            <span class="d2-icp-v">{p.bring}</span>
          </div>
          <div class="d2-icp-handle">
            <span class="d2-icp-k">we handle</span>
            <span class="d2-icp-v">{p.handle}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="d2-icps-foot" data-reveal="up"><Stitch /></div>
  </div>
</section>

<style>
  .d2-icps {
    padding: 6rem 0 5rem;
    background: var(--color-brand-surface);
  }
  .d2-icps-head {
    max-width: 42rem;
  }
  .d2-icps-list {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
  }
  .d2-icp {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px dashed rgba(138, 106, 59, 0.28);
    transition: background 0.3s ease, padding 0.3s ease;
  }
  .d2-icp:hover {
    background: rgba(246, 241, 231, 0.5);
    padding-left: 0.8rem;
    padding-right: 0.8rem;
  }
  .d2-icp:first-child {
    border-top: 1px dashed rgba(138, 106, 59, 0.28);
  }
  .d2-icp-name {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    color: var(--color-brand-primary);
    font-variation-settings: 'opsz' 40;
  }
  .d2-icp-bring,
  .d2-icp-handle {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .d2-icp-k {
    flex: none;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
    min-width: 5.2rem;
  }
  .d2-icp-v {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-brand-text);
  }
  .d2-icp-handle .d2-icp-v {
    color: var(--color-brand-secondary);
  }
  .d2-icps-foot {
    margin-top: 3rem;
  }

  @media (min-width: 900px) {
    .d2-icp {
      grid-template-columns: 1.1fr 0.9fr 1fr;
      align-items: baseline;
      gap: 2rem;
    }
    .d2-icp-name {
      font-size: 1.9rem;
    }
  }
</style>
