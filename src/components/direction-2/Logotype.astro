---
interface Props {
  variant?: 'light' | 'dark'
}
const { variant = 'dark' } = Astro.props
---

<a href="#top" class="d2-logo" data-variant={variant} aria-label="LeelineSports — home">
  <svg class="d2-logo-mark" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g transform="rotate(38 14 14)">
      <path d="M7.4 15 C3.4 8.8 3.6 2.6 9.6 2.1 C15.4 1.7 17.8 8.8 12 12.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path fill-rule="evenodd" fill="currentColor" d="M2.5 10.7 H16.6 L20.4 12.5 L16.6 14.3 H2.5 Z M5.4 11.35 a1.35 0.85 0 1 0 2.7 0 a1.35 0.85 0 1 0 -2.7 0 Z" />
    </g>
  </svg>
  <span class="d2-logo-word">Leeline<em>Sports</em></span>
</a>

<style>
  .d2-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    line-height: 1;
  }
  .d2-logo-mark {
    width: 27px;
    height: 27px;
    flex: none;
    color: var(--color-brand-accent);
  }
  .d2-logo-word {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.32rem;
    letter-spacing: -0.02em;
    color: var(--color-brand-primary);
    white-space: nowrap;
  }
  .d2-logo-word em {
    font-style: italic;
    font-weight: 400;
    margin-left: 0.06em;
  }
  .d2-logo[data-variant='light'] .d2-logo-word {
    color: var(--color-brand-bg);
  }
</style>
