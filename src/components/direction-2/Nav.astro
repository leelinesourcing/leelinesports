</header>

<style>
  .d2-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    transition: background-color 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
    border-bottom: 1px solid transparent;
  }
  .d2-nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    justify-content: space-between;
  }
  .d2-nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    line-height: 1;
  }
  .d2-nav-mark {
    width: 26px;
    height: 26px;
    flex: none;
    color: var(--color-brand-accent);
  }
  .d2-nav-word {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--color-brand-bg);
    white-space: nowrap;
    transition: color 0.4s ease;
  }
  .d2-nav-word em {
    font-style: italic;
    font-weight: 400;
  }
  .d2-nav-links {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }
  .d2-nav-links a {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-brand-bg);
    text-decoration: none;
    position: relative;
    transition: color 0.3s ease;
    padding: 0.25rem 0;
  }
  .d2-nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--color-brand-accent) 0 4px, transparent 4px 8px);
    transition: right 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .d2-nav-links a:hover::after {
    right: 0;
  }
  .d2-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .d2-nav-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-brand-bg);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .d2-nav-contact svg {
    width: 17px;
    height: 17px;
    color: var(--color-brand-accent);
  }
  .d2-nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px;
    background: transparent;
    border: 1px solid rgba(246, 241, 231, 0.35);
    border-radius: 999px;
    cursor: pointer;
  }
  .d2-nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-brand-bg);
    border-radius: 2px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  .d2-nav.is-open .d2-nav-toggle span:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .d2-nav.is-open .d2-nav-toggle span:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* menu panel */
  .d2-nav-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    background: var(--color-brand-primary);
  }
  .d2-nav.is-open .d2-nav-menu {
    grid-template-rows: 1fr;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5);
  }
  .d2-nav-menu .d2-nav-menu-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1.5rem 1.5rem;
    gap: 0.25rem;
  }
  .d2-nav-menu a {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-brand-bg);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px dashed rgba(200, 162, 75, 0.25);
  }
  .d2-nav-menu a.d2-btn {
    margin-top: 1rem;
    align-self: flex-start;
    color: var(--color-brand-primary);
  }
  .d2-nav-menu a.d2-nav-menu-wa {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-brand-accent);
    border-bottom: none;
  }

  /* scrolled state */
  .d2-nav.is-scrolled {
    background: rgba(246, 241, 231, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgba(138, 106, 59, 0.18);
    box-shadow: 0 12px 40px -28px rgba(27, 27, 24, 0.5);
  }
  .d2-nav.is-scrolled .d2-nav-word,
  .d2-nav.is-scrolled .d2-nav-links a,
  .d2-nav.is-scrolled .d2-nav-contact {
    color: var(--color-brand-primary);
  }
  .d2-nav.is-scrolled .d2-nav-toggle {
    border-color: rgba(27, 27, 24, 0.2);
  }
  .d2-nav.is-scrolled .d2-nav-toggle span {
    background: var(--color-brand-primary);
  }
  .d2-nav.is-scrolled .d2-nav-menu {
    background: var(--color-brand-bg);
  }
  .d2-nav.is-scrolled .d2-nav-menu a {
    color: var(--color-brand-primary);
  }

  @media (min-width: 880px) {
    .d2-nav-links {
      display: flex;
    }
    .d2-nav-toggle {
      display: none;
    }
    .d2-nav-menu {
      display: none;
    }
  }
</style>
