        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 0 0-6.9 12L2 18l4.1-1.1A8 8 0 1 0 10 2Zm0 1.6a6.4 6.4 0 1 1-3.4 11.9l-.4-.24-2.3.6.6-2.2-.25-.4A6.4 6.4 0 0 1 10 3.6Zm-2 3a.8.8 0 0 0-.6.3c-.2.3-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 4 3.4 2 .8 2.4.7 2.8.6.4-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1-.1-.1-.3-.2-.6-.3l-1.5-.7c-.2-.1-.4-.1-.6.1l-.7.9c-.2.2-.4.2-.6.1a6 6 0 0 1-1.9-1.2 7 7 0 0 1-1.3-1.6c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3.2-.5s0-.3-.1-.4l-.7-1.6a.5.5 0 0 0-.3-.2H8Z"/></svg>
