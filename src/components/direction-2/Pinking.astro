---
interface Props {
  /** color of the section ABOVE (fills the gaps) */
  bg?: string
  /** color of the section BELOW (the teeth) */
  fill?: string
  height?: number
}
const { bg = 'transparent', fill = '#1E2A24', height = 26 } = Astro.props
const step = 44
const W = 1188
let pts = ''
for (let x = 0, i = 0; x <= W; x += step, i++) {
  const y = i % 2 === 0 ? 3 : height - 3
  pts += ` L${x} ${y}`
}
---

<div class="d2-pinking" style={`background:${bg};`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${height}`} preserveAspectRatio="none">
    <path d={`M0 ${height}${pts} L${W} ${height} Z`} style={`fill:${fill};`} />
  </svg>
</div>

<style>
  .d2-pinking {
    display: block;
    width: 100%;
    line-height: 0;
  }
  .d2-pinking svg {
    display: block;
    width: 100%;
    height: 26px;
  }
</style>
