---
const steps = [
  { n: '01', t: 'Discovery', d: 'Share a sketch, tech pack or reference. We lock MOQ, spec and a DDP price in 48 hours.', tag: '48h price' },
  { n: '02', t: 'Shortlist', d: 'We pull two or three matched factories from 5,000+ vetted suppliers.', tag: '2–3 factories' },
  { n: '03', t: 'Sampling', d: 'A 5–10 day pre-production sample, refundable against your bulk order.', tag: '5–10 days' },
  { n: '04', t: 'Production + QC', d: 'AQL 2.5 inspection at 30 / 60 / 100%. Live video if you want it.', tag: 'AQL 2.5' },
  { n: '05', t: 'Delivery', d: 'DDP to your door, or injected straight into Amazon FCs.', tag: 'DDP' },
]
---

<section class="d2-process" id="process">
  <div class="d2-wrap">
    <div class="d2-process-head">
      <p class="d2-eyebrow" data-reveal="up">How it works</p>
      <h2 class="d2-h2" data-reveal="up" style="--rd:80ms">Five steps. One hand-off.</h2>
      <p class="d2-lede" data-reveal="up" style="--rd:160ms">
        You stay in the loop at the moments that matter. Everything between the dots is our job.
      </p>
    </div>

    <ol class="d2-steps">
      <div class="d2-steps-track" aria-hidden="true"></div>
      {steps.map((s) => (
        <li class="d2-step" data-reveal="up" style={`--rd:${s.n * 60}ms`}>
          <span class="d2-step-node">{s.n}</span>
          <h3 class="d2-step-title">{s.t}</h3>
          <p class="d2-step-desc">{s.d}</p>
          <span class="d2-step-tag">{s.tag}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .d2-process {
    padding: 6rem 0 6rem;
    background: var(--color-brand-bg);
  }
  .d2-process-head {
    max-width: 42rem;
  }
  .d2-steps {
    position: relative;
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .d2-steps-track {
    position: absolute;
    display: none;
  }
  .d2-step {
    position: relative;
    padding-left: 4.2rem;
  }
  .d2-step::before {
    content: '';
    position: absolute;
    left: 1.4rem;
    top: 2.9rem;
    bottom: -2rem;
    width: 2px;
    background: repeating-linear-gradient(180deg, var(--color-brand-accent) 0 7px, transparent 7px 14px);
    opacity: 0.55;
  }
  .d2-step:last-child::before {
    display: none;
  }
  .d2-step-node {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.9rem;
    height: 2.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-brand-primary);
    color: var(--color-brand-accent);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    box-shadow: 0 10px 24px -12px rgba(27, 27, 24, 0.6);
  }
  .d2-step-title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--color-brand-primary);
    font-variation-settings: 'opsz' 40;
  }
  .d2-step-desc {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
    max-width: 30ch;
  }
  .d2-step-tag {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(138, 106, 59, 0.35);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-brand-secondary);
  }

  @media (min-width: 900px) {
    .d2-steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.5rem;
    }
    .d2-step {
      padding-left: 0;
      padding-top: 3.6rem;
    }
    .d2-step::before {
      display: none;
    }
    .d2-steps-track {
      display: block;
      left: 0;
      right: 0;
      top: 1.45rem;
      height: 2px;
      background: repeating-linear-gradient(90deg, var(--color-brand-accent) 0 8px, transparent 8px 16px);
      opacity: 0.5;
    }
    .d2-step-node {
      top: 0;
      left: 0;
    }
  }
</style>
