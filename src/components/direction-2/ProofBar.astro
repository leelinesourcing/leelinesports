---
const stats = [
  { n: '5000', d: 0, suffix: '+', label: 'vetted suppliers' },
  { n: '2.5', d: 1, suffix: '', label: 'AQL major-defect ceiling' },
  { n: '100', d: 0, suffix: '', label: 'MOQ, custom private label' },
  { n: '10', d: 0, suffix: '', label: 'days to first sample' },
]

const ticker = [
  'AQL 2.5 / 4.0 QC',
  'ISO 5077 — shrinkage ≤3–5%',
  'ISO 105 — colorfast Grade 4+',
  'DDP — duties included',
  'Express 3–5 days',
  'Air 7–12 days',
  'Sea 25–40 days',
  'FBA prep & injection',
  'Man-in-plant inspection',
]
---

<section class="d2-proof" id="proof">
  <div class="d2-proof-band">
    <div class="d2-proof-stats">
      {stats.map((s) => (
        <div class="d2-stat" data-reveal="up">
          <div class="d2-stat-num">
            <span data-count={s.n} data-decimals={s.d}>0</span><span class="d2-stat-suffix">{s.suffix}</span>
          </div>
          <div class="d2-stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="d2-ticker" aria-hidden="true">
    <div class="d2-ticker-track">
      {[0, 1].map((i) => (
        <div class="d2-ticker-group">
          {ticker.map((t) => (
            <span class="d2-ticker-item">
              {t}
              <svg viewBox="0 0 24 24" fill="none"><path fill="currentColor" d="M2 10.8 H16.8 L20.4 12.4 L16.8 14 H2 Z M5.2 11.6 a1.3 0.8 0 1 0 2.6 0 a1.3 0.8 0 1 0 -2.6 0 Z"/></svg>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .d2-proof {
    position: relative;
    margin-top: -2.5rem;
    z-index: 5;
  }
  .d2-proof-band {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .d2-proof-stats {
    background: var(--color-brand-bg);
    border: 1px solid rgba(138, 106, 59, 0.16);
    border-radius: 22px;
    box-shadow: 0 30px 70px -40px rgba(27, 27, 24, 0.5);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    overflow: hidden;
  }
  .d2-stat {
    padding: 1.7rem 1.4rem;
    border-bottom: 1px dashed rgba(138, 106, 59, 0.2);
  }
  .d2-stat:nth-child(odd) {
    border-right: 1px dashed rgba(138, 106, 59, 0.2);
  }
  .d2-stat-num {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: clamp(2.1rem, 4vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-brand-primary);
    font-variation-settings: 'opsz' 72;
  }
  .d2-stat-suffix {
    color: var(--color-brand-accent);
  }
  .d2-stat-label {
    margin-top: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-brand-muted);
  }

  .d2-ticker {
    margin-top: 1.4rem;
    overflow: hidden;
    background: var(--color-brand-primary);
    color: var(--color-brand-accent);
    border-top: 1px solid rgba(200, 162, 75, 0.25);
    border-bottom: 1px solid rgba(200, 162, 75, 0.25);
  }
  .d2-ticker-track {
    display: flex;
    width: max-content;
    animation: d2-ticker 38s linear infinite;
  }
  .d2-ticker-group {
    display: flex;
    flex: none;
  }
  .d2-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.8rem 1.1rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-brand-bg);
    white-space: nowrap;
  }
  .d2-ticker-item svg {
    width: 15px;
    height: 15px;
    color: var(--color-brand-accent);
  }

  @media (min-width: 720px) {
    .d2-proof {
      margin-top: -3.4rem;
    }
    .d2-proof-stats {
      grid-template-columns: repeat(4, 1fr);
    }
    .d2-stat {
      padding: 2rem 1.6rem;
      border-bottom: none;
    }
    .d2-stat:nth-child(odd) {
      border-right: 1px dashed rgba(138, 106, 59, 0.2);
    }
    .d2-stat:nth-child(4) {
      border-right: none;
    }
  }

  @keyframes d2-ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
