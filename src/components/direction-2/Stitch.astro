---
interface Props {
  /** thread color, any CSS color */
  color?: string
  needle?: boolean
  className?: string
}
const { color = 'var(--color-brand-accent)', needle = true, className = '' } = Astro.props
---

<div class={`d2-stitch ${className}`} style={`--stitch: ${color}`} aria-hidden="true">
  <span class="d2-stitch-track"></span>
  {needle && (
    <svg class="d2-stitch-needle" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path fill-rule="evenodd" fill="currentColor" d="M2 10.8 H16.8 L20.4 12.4 L16.8 14 H2 Z M5.2 11.6 a1.3 0.8 0 1 0 2.6 0 a1.3 0.8 0 1 0 -2.6 0 Z" />
    </svg>
  )}
</div>

<style>
  .d2-stitch {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    color: var(--stitch, var(--color-brand-accent));
  }
  .d2-stitch-track {
    flex: 1 1 auto;
    height: 7px;
    background-image:
      repeating-linear-gradient(90deg, currentColor 0 6px, transparent 6px 14px),
      repeating-linear-gradient(90deg, transparent 0 3px, currentColor 3px 9px, transparent 9px 14px);
    background-size: 100% 1.6px, 100% 1.6px;
    background-position: 0 0px, 0 5px;
    background-repeat: no-repeat;
  }
  .d2-stitch-needle {
    width: 13px;
    height: 13px;
    flex: none;
    opacity: 0.9;
  }
</style>
