---
import Stitch from './Stitch.astro'

const verticals = [
  {
    name: 'Performance Wear',
    img: '/images/redesign/image-06.webp',
    blurb: 'Yoga, compression and training pieces engineered to survive the wash cycle — and the return policy.',
    specs: ['Four-way stretch, 40-wash tested', 'Compression & yoga, XS–3XL', 'MOQ from 200 units'],
    swatches: [
      { c: '#1E2A24', label: 'Forest 19-0415' },
      { c: '#8A6A3B', label: 'Bronze 18-0935' },
      { c: '#C8A24B', label: 'Brass 16-0948' },
    ],
  },
  {
    name: 'Team Sports',
    img: '/images/redesign/image-14.avif',
    blurb: 'Sublimated jerseys and uniforms where the logo is dyed into the fibre, not pressed onto it.',
    specs: ['Sublimated — dye, not heat-press', 'Grade 4+ colorfast (ISO 105)', 'Uniforms & jerseys, MOQ from 200'],
    swatches: [
      { c: '#1E2A24', label: 'Forest 19-0415' },
      { c: '#C8A24B', label: 'Brass 16-0948' },
      { c: '#F6F1E7', label: 'Bone 11-0602' },
    ],
  },
  {
    name: 'Swim & Outdoor',
    img: '/images/redesign/image-12.avif',
    blurb: 'UPF-rated swimwear and waterproof shells built for salt, sun and chlorine.',
    specs: ['UPF 50+ swimwear, waterproof shells', 'Colorfast to Grade 4 (ISO 105)', 'Shrinkage ≤3–5% (ISO 5077)'],
    swatches: [
      { c: '#8A6A3B', label: 'Bronze 18-0935' },
      { c: '#C8A24B', label: 'Brass 16-0948' },
      { c: '#F6F1E7', label: 'Bone 11-0602' },
    ],
  },
]
---

<section class="d2-verticals" id="verticals">
  <div class="d2-wrap">
    <div class="d2-vertical-head">
      <p class="d2-eyebrow" data-reveal="up">What we make</p>
      <h2 class="d2-h2" data-reveal="up" style="--rd:80ms">Three floors of the atelier.</h2>
      <p class="d2-lede" data-reveal="up" style="--rd:160ms">
        Three product verticals, one quality floor. Every line runs to the same standard — AQL 2.5,
        Grade 4+ colorfast, and shrinkage you can quote to a customer.
      </p>
    </div>

    <div class="d2-vertical-grid">
      {verticals.map((v, i) => (
        <article class={`d2-vertical${i === 1 ? ' d2-vertical--stagger' : ''}`} data-reveal={i === 1 ? 'down' : 'up'}>
          <div class="d2-vertical-media">
            <img src={v.img} alt={v.name} loading="lazy" width="550" height="525" />
            <span class="d2-vertical-tag">{v.name}</span>
          </div>
          <div class="d2-vertical-body">
            <p class="d2-vertical-blurb">{v.blurb}</p>
            <ul class="d2-vertical-specs">
              {v.specs.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <div class="d2-vertical-swatches">
              {v.swatches.map((sw) => (
                <span class="d2-vertical-swatch" title={sw.label}>
                  <i style={`background:${sw.c}`}></i>
                  <em>{sw.label}</em>
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="d2-vertical-foot" data-reveal="up">
      <Stitch />
    </div>
  </div>
</section>

<style>
  .d2-verticals {
    padding: 7rem 0 5rem;
    background: var(--color-brand-bg);
  }
  .d2-vertical-head {
    max-width: 46rem;
  }
  .d2-vertical-grid {
    margin-top: 3.5rem;
    display: grid;
    gap: 2rem;
  }
  .d2-vertical {
    display: flex;
    flex-direction: column;
    background: var(--color-brand-surface);
    border: 1px solid rgba(138, 106, 59, 0.14);
    border-radius: 24px;
    overflow: hidden;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.55s ease;
  }
  .d2-vertical:hover {
    transform: translateY(-8px);
    box-shadow: 0 40px 80px -45px rgba(27, 27, 24, 0.45);
  }
  .d2-vertical-media {
    position: relative;
    aspect-ratio: 1 / 0.92;
    overflow: hidden;
  }
  .d2-vertical-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .d2-vertical:hover .d2-vertical-media img {
    transform: scale(1.05);
  }
  .d2-vertical-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.55rem 0.95rem;
    background: var(--color-brand-bg);
    border-radius: 999px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--color-brand-primary);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.4);
  }
  .d2-vertical-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.5rem 1.5rem 1.6rem;
    flex: 1;
  }
  .d2-vertical-blurb {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-brand-text);
  }
  .d2-vertical-specs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .d2-vertical-specs li {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-brand-muted);
    padding-left: 1.05rem;
    position: relative;
  }
  .d2-vertical-specs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-brand-accent);
  }
  .d2-vertical-swatches {
    margin-top: auto;
    padding-top: 0.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .d2-vertical-swatch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-brand-muted);
  }
  .d2-vertical-swatch i {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  .d2-vertical-swatch em {
    font-style: normal;
  }
  .d2-vertical-foot {
    margin-top: 3rem;
  }

  @media (min-width: 880px) {
    .d2-vertical-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
      align-items: start;
    }
    .d2-vertical--stagger {
      margin-top: 2.5rem;
    }
  }
</style>
