---
const icps = [
  { num: '01', name: 'FBA front-runner', role: 'Solo Amazon private-label seller', bring: 'An ASIN and a brand name', handle: 'TOS-compliant FBA prep and fabric that isn’t see-through' },
  { num: '02', name: 'Gym visionary', role: 'Gym / CrossFit owner', bring: 'A logo and a member list', handle: 'Sublimated gear in XS–3XL at gym-friendly MOQs' },
  { num: '03', name: 'Influencer icon', role: 'Creator launching a merch line', bring: 'A Pantone and an NDA', handle: 'Exact color matching and recycled fabrics' },
  { num: '04', name: 'League logician', role: 'Procurement for teams & schools', bring: 'A season deadline', handle: 'Consistent sizing and low-MOQ reorders' },
  { num: '05', name: 'Diversifying retailer', role: '$1M+ e-commerce manager', bring: '$1M+ of demand', handle: 'Redundant supply and honest QC reports' },
];
---

<section class="audience" id="audience">
  <span class="sideline" aria-hidden="true"></span>
  <div class="container">
    <div class="audience__head">
      <div class="num-outline audience__num" data-reveal="clip">03</div>
      <div>
        <p class="label" data-reveal="left">Who this is for</p>
        <h2 class="h2" data-reveal="up" style="--rv-delay:80ms">Five people we already know</h2>
      </div>
    </div>

    <div class="audience__list">
      {icps.map((p, i) => (
        <article class="audience__row" data-reveal="up" style={`--rv-delay:${i * 80}ms`}>
          <div class="audience__persona">
            <span class="audience__num">{p.num}</span>
            <div>
              <h3 class="h3 audience__name">{p.name}</h3>
              <span class="muted audience__role">{p.role}</span>
            </div>
          </div>
          <div class="audience__trade">
            <div class="audience__pair">
              <span class="label audience__pairlabel">You bring</span>
              <p class="audience__pairval">{p.bring}</p>
            </div>
            <span class="audience__arrow">→</span>
            <div class="audience__pair audience__pair--handle">
              <span class="label label--accent audience__pairlabel">We handle</span>
              <p class="audience__pairval">{p.handle}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .audience { position: relative; padding-block: clamp(5rem, 9vw, 8rem); background: var(--color-brand-primary); }
  .audience__head { display: flex; gap: clamp(1.5rem, 3vw, 3rem); align-items: flex-start; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .audience__num { font-size: clamp(4rem, 9vw, 7rem); }
  .audience__head .label { margin-bottom: .9rem; }

  .audience__list { border-top: 1px solid rgba(245,245,244,.1); }
  .audience__row {
    display: grid; grid-template-columns: minmax(220px, .8fr) 1.2fr; gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(1.4rem, 3vw, 2rem); border-bottom: 1px solid rgba(245,245,244,.1);
    align-items: center; transition: background .3s;
  }
  .audience__row:hover { background: rgba(198,241,53,.04); }
  .audience__persona { display: flex; align-items: baseline; gap: 1.1rem; }
  .audience__num { font-family: var(--font-heading); font-stretch: 125%; font-weight: 850; font-size: 1.1rem; color: var(--color-brand-accent); }
  .audience__role { font-size: .88rem; display: block; margin-top: .25rem; }

  .audience__trade { display: grid; grid-template-columns: 1fr auto 1fr; gap: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .audience__pair { display: flex; flex-direction: column; gap: .35rem; }
  .audience__pairval { font-size: 1.02rem; line-height: 1.45; color: var(--color-brand-text); }
  .audience__pair--handle .audience__pairval { color: var(--color-brand-accent); }
  .audience__arrow { color: var(--color-brand-muted); font-size: 1.4rem; }

  @media (max-width: 880px) {
    .audience__row { grid-template-columns: 1fr; gap: 1.2rem; }
    .audience__trade { grid-template-columns: 1fr; gap: .8rem; }
    .audience__arrow { transform: rotate(90deg); }
  }
</style>
