---
const faqs = [
  {
    q: 'What’s your minimum order?',
    a: '50–100 units for stock and blank garments, 200–300 for fully custom private label. Once a line is live, reorders drop to 50 units on most programs.',
  },
  {
    q: 'How do you protect my designs?',
    a: 'An NDA is signed before we see your tech pack. Your IP stays yours — we never resell your designs, and your line never appears in a shared catalog.',
  },
  {
    q: 'What does DDP actually include?',
    a: 'Manufacturing, freight and duties quoted as one number. No separate customs invoice, no “surprise” port fees. What you approve is what you pay.',
  },
  {
    q: 'How do you handle quality control?',
    a: 'Every batch is inspected to AQL 2.5 (major) and 4.0 (minor), with ISO 5077 shrinkage and ISO 105 colorfastness as the baseline. We run live video inspections, and keep a man-in-plant on the floor for orders over 500 units.',
  },
  {
    q: 'Can you handle Amazon FBA prep?',
    a: 'Yes — barcoding, poly-bagging and direct injection into Amazon FCs, all TOS-compliant. Your units land ready to sell, not quarantined for repackaging.',
  },
  {
    q: 'How fast is sampling?',
    a: 'A physical sample in 5–10 days. Sampling fees are refunded against your bulk order, so trying us costs nothing when you move forward.',
  },
];
---

<section class="faq" id="faq">
  <span class="sideline" aria-hidden="true"></span>
  <div class="container faq__grid">
    <div class="faq__left">
      <div class="num-outline faq__num" data-reveal="clip">04</div>
      <p class="label" data-reveal="left">FAQ</p>
      <h2 class="h2 faq__title" data-reveal="up" style="--rv-delay:80ms">Asked before every<br />first order</h2>
      <p class="muted faq__sub" data-reveal="up" style="--rv-delay:160ms">
        Something more specific? Ask on WhatsApp — a human answers, usually
        within the hour.
      </p>
      <a href="https://wa.me/8613986152456" class="btn btn--ghost btn--sm faq__btn" data-reveal="up" style="--rv-delay:220ms">WhatsApp us</a>
    </div>

    <div class="faq__list">
      {faqs.map((f, i) => (
        <div class="faq__item" data-faq-item data-reveal="up" style={`--rv-delay:${i * 70}ms`}>
          <button class="faq__q" data-faq-btn aria-expanded="false">
            <span class="faq__qtext">{f.q}</span>
            <span class="faq__toggle" aria-hidden="true"></span>
          </button>
          <div class="faq__panel" data-faq-panel>
            <p class="faq__a muted">{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { position: relative; padding-block: clamp(5rem, 9vw, 8rem); background: var(--color-brand-bg); }
  .faq__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .faq__num { font-size: clamp(3.5rem, 7vw, 5.5rem); margin-bottom: 1.2rem; }
  .faq__title { margin-top: .8rem; }
  .faq__sub { margin-top: 1.2rem; max-width: 30ch; line-height: 1.6; }
  .faq__btn { margin-top: 1.6rem; }

  .faq__list { border-top: 1px solid rgba(245,245,244,.1); }
  .faq__item { border-bottom: 1px solid rgba(245,245,244,.1); }
  .faq__q {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    background: none; border: 0; cursor: pointer; padding: 1.4rem 0; text-align: left;
  }
  .faq__qtext {
    font-family: var(--font-heading); font-stretch: 112%; font-weight: 750; text-transform: uppercase;
    letter-spacing: -0.01em; font-size: clamp(1.05rem, 1.8vw, 1.3rem); color: var(--color-brand-text);
    transition: color .25s;
  }
  .faq__q:hover .faq__qtext { color: var(--color-brand-accent); }
  .faq__toggle { position: relative; width: 18px; height: 18px; flex-shrink: 0; }
  .faq__toggle::before, .faq__toggle::after {
    content: ""; position: absolute; background: var(--color-brand-accent);
    transition: transform .35s var(--ease-out);
  }
  .faq__toggle::before { left: 0; top: 8px; width: 18px; height: 2px; }
  .faq__toggle::after { top: 0; left: 8px; width: 2px; height: 18px; }
  .faq__item.is-open .faq__toggle::after { transform: rotate(90deg); }
  .faq__item.is-open .faq__qtext { color: var(--color-brand-accent); }

  .faq__panel { max-height: 0; overflow: hidden; transition: max-height .45s var(--ease-out); }
  .faq__a { padding: 0 2.4rem 1.5rem 0; line-height: 1.65; font-size: .98rem; }

  @media (max-width: 880px) {
    .faq__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .faq__num { display: none; }
  }
</style>
