---
const stats = [
  { count: '2.5', decimals: '1', suffix: '', label: 'AQL QC · major defects', note: '4.0 minor' },
  { count: '5000', decimals: '0', suffix: '+', label: 'Vetted suppliers', note: 'Wuhan ground team' },
  { count: '100', decimals: '0', suffix: '', label: 'MOQ custom units', note: '50 for blanks' },
  { display: '5–10d', label: 'Sampling lead', note: 'fees refunded on bulk' },
];
---

<section class="hero speedlines" aria-label="Introduction" data-hero>
  <div class="hero__media" aria-hidden="true">
    <img
      src="/images/redesign/image-04.webp"
      alt=""
      class="hero__img"
      loading="eager"
      decoding="async"
    />
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__sideline sideline" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="label label--accent" data-hero data-reveal="down" style="--rv-delay:80ms">
      Custom sportswear manufacturing · OEM / ODM · Wuhan, CN
    </p>

    <h1 class="display hero__title" data-hero data-reveal="up" style="--rv-delay:180ms">
      <span class="hero__line">Made in Wuhan</span>
      <span class="hero__line">Shipped DDP</span>
      <span class="hero__line">Sold under your logo</span>
    </h1>

    <div class="hero__row" data-hero data-reveal="up" style="--rv-delay:340ms">
      <p class="hero__lede">
        LeelineSports is the outsourced manufacturing and supply chain for private-label
        sportswear. You bring the design — we source, inspect to AQL 2.5, and deliver to
        your warehouse or Amazon FC. No surprise fees. No 4 a.m. WeChat ping.
      </p>
      <div class="hero__cta">
        <a href="#quote" class="btn btn--primary">Request a quote</a>
        <a href="https://wa.me/8613986152456" class="btn btn--ghost">WhatsApp us</a>
        <a href="mailto:info@leelinesports.com" class="hero__mail muted link-arrow">info@leelinesports.com</a>
      </div>
    </div>
  </div>

  <div class="hero__score scoreboard" data-hero data-reveal="up" style="--rv-delay:480ms">
    <div class="container hero__score-inner">
      {stats.map((s) => (
        <div class="hero__cell">
          {s.count ? (
            <div class="stat hero__value" data-count={s.count} data-decimals={s.decimals} data-suffix={s.suffix}>0</div>
          ) : (
            <div class="stat hero__value">{s.display}</div>
          )}
          <div class="hero__cellrow">
            <span class="hero__cell-label">{s.label}</span>
            <span class="hero__cell-note muted">{s.note}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; flex-direction: column;
    justify-content: flex-end; overflow: hidden; padding-bottom: 0;
  }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__img {
    width: 100%; height: 100%; object-fit: cover; object-position: center 40%;
    transform: scale(1.14); transition: transform 2.4s var(--ease-out);
  }
  .hero.is-in .hero__img { transform: scale(1); }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,10,11,.72) 0%, rgba(10,10,11,.35) 45%, rgba(10,10,11,.96) 96%),
      linear-gradient(90deg, rgba(10,10,11,.9) 0%, rgba(10,10,11,.35) 55%, transparent 100%);
  }
  .hero__sideline { z-index: 1; opacity: .65; }

  .hero__content { position: relative; z-index: 2; padding-top: 20vh; padding-bottom: 6rem; }
  .hero__title { margin-top: 1.4rem; display: flex; flex-direction: column; }
  .hero__line { display: block; }
  .hero__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2.5rem; align-items: end; margin-top: 2.2rem; }
  .hero__lede { max-width: 46ch; color: var(--color-brand-text); opacity: .86; font-size: clamp(1rem, 1.4vw, 1.18rem); line-height: 1.6; }
  .hero__cta { display: flex; flex-direction: column; align-items: flex-start; gap: .8rem; }
  .hero__mail { font-size: .92rem; }

  .hero__score { position: relative; z-index: 2; }
  .hero__score-inner {
    display: grid; grid-template-columns: repeat(4, 1fr);
    padding-block: 1.6rem; gap: 1.5rem;
  }
  .hero__cell { display: flex; flex-direction: column; gap: .6rem; }
  .hero__cell + .hero__cell { border-left: 1px solid rgba(245, 245, 244, .1); padding-left: 1.5rem; }
  .hero__value { font-size: clamp(2rem, 4.5vw, 3.4rem); }
  .hero__cellrow { display: flex; flex-direction: column; gap: .15rem; }
  .hero__cell-label { font-size: .82rem; font-weight: 500; color: var(--color-brand-text); }
  .hero__cell-note { font-size: .78rem; }

  @media (max-width: 900px) {
    .hero__row { grid-template-columns: 1fr; gap: 1.6rem; }
    .hero__cta { flex-direction: column; }
    .hero__score-inner { grid-template-columns: repeat(2, 1fr); row-gap: 1.4rem; }
    .hero__cell:nth-child(3) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 480px) {
    .hero__content { padding-top: 16vh; }
    .hero__score-inner { gap: 1rem; }
    .hero__cell + .hero__cell { padding-left: 1rem; }
  }
</style>
