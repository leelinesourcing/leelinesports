---
const links = [
  { href: '#verticals', label: 'Verticals' },
  { href: '#process', label: 'Process' },
  { href: '#audience', label: "Who it's for" },
  { href: '#why-us', label: 'Why us' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href="#top" class="nav__brand" aria-label="LeelineSports — home">
      <img
        src="/images/redesign/image-01.png"
        alt="LeelineSports"
        class="nav__logo"
        width="200"
        height="40"
        loading="eager"
      />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href} class="nav__link">{l.label}</a>)}
    </nav>

    <div class="nav__actions">
      <a href="#quote" class="btn btn--primary btn--sm nav__cta">Request a quote</a>
      <button class="nav__burger" data-menu-btn aria-expanded="false" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu" data-menu>
    <nav class="menu__links" aria-label="Mobile">
      {links.map((l) => <a href={l.href} class="menu__link">{l.label}</a>)}
      <a href="#quote" class="btn btn--primary menu__cta">Request a quote</a>
      <a href="https://wa.me/8613986152456" class="menu__sub">WhatsApp · +86 139 8615 2456</a>
      <a href="mailto:info@leelinesports.com" class="menu__sub">info@leelinesports.com</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    transition: background .35s var(--ease-out), border-color .35s, backdrop-filter .35s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: color-mix(in oklab, var(--color-brand-bg) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: rgba(245, 245, 244, .08);
  }
  .nav__inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 76px; gap: 1.5rem;
  }
  .nav__logo {
    height: 30px; width: auto; filter: brightness(0) invert(1); display: block;
  }
  .nav__links { display: flex; gap: clamp(1.4rem, 3vw, 2.6rem); align-items: center; }
  .nav__link {
    font-family: var(--font-heading); font-stretch: 62%; font-weight: 650;
    text-transform: uppercase; letter-spacing: .1em; font-size: .74rem;
    color: var(--color-brand-muted); transition: color .25s;
  }
  .nav__link:hover { color: var(--color-brand-text); }
  .nav__actions { display: flex; align-items: center; gap: .9rem; }
  .nav__burger {
    display: none; flex-direction: column; gap: 5px; padding: .5rem;
    background: none; border: 0; cursor: pointer;
  }
  .nav__burger span {
    width: 22px; height: 2px; background: var(--color-brand-text);
    transition: transform .3s var(--ease-out), opacity .3s;
  }
  .nav__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__burger[aria-expanded="true"] span:nth-child(2) { transform: translateY(-7px) rotate(-45deg); }

  .menu {
    position: fixed; inset: 76px 0 0 0; z-index: 90;
    background: var(--color-brand-bg);
    transform: translateY(-102%); visibility: hidden;
    transition: transform .5s var(--ease-out), visibility .5s;
    overflow-y: auto;
  }
  .menu.is-open { transform: translateY(0); visibility: visible; }
  .menu__links {
    display: flex; flex-direction: column; gap: .4rem; padding: 2rem clamp(20px, 5vw, 72px) 3rem;
  }
  .menu__link {
    font-family: var(--font-heading); font-stretch: 125%; font-weight: 800;
    text-transform: uppercase; letter-spacing: -0.02em; font-size: clamp(2rem, 9vw, 3.4rem);
    color: var(--color-brand-text); padding: .7rem 0; border-bottom: 1px solid rgba(245, 245, 244, .08);
  }
  .menu__cta { margin-top: 1.6rem; align-self: flex-start; }
  .menu__sub { color: var(--color-brand-muted); font-size: .95rem; margin-top: .5rem; }

  @media (max-width: 900px) {
    .nav__links, .nav__cta { display: none; }
    .nav__burger { display: flex; }
  }
</style>
