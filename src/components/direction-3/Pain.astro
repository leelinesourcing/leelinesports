---
const pains = [
  { p: 'The sample was flawless. The 500-piece shipment was see-through.', cost: '10' },
  { p: 'Your quote left out duties. The invoice didn’t.', cost: '12' },
  { p: 'Six weeks of silence, then “your container is delayed.”', cost: '8' },
  { p: 'The factory ghosted you after the deposit cleared.', cost: '15' },
];
---

<section class="pain" id="pain">
  <span class="sideline" aria-hidden="true"></span>
  <div class="container pain__grid">
    <div class="pain__left">
      <p class="label" data-reveal="left">You've seen the horror stories</p>
      <h2 class="h2 pain__title" data-reveal="up" style="--rv-delay:80ms">
        Importing from China<br />shouldn't be a gamble
      </h2>
      <p class="pain__lede muted" data-reveal="up" style="--rv-delay:160ms">
        Every brand we work with has a version of the same scar — a ruined launch,
        a customs bill that ate the margin, a season shipped late. These are the
        defaults when you buy from a faceless middleman instead of a partner with
        boots on the ground in Wuhan.
      </p>
    </div>

    <div class="pain__board scoreboard" data-reveal="right" style="--rv-delay:120ms">
      <div class="pain__boardhead">
        <span class="label">Sourcing penalties</span>
        <span class="label label--accent">The old way</span>
      </div>
      {pains.map((item, i) => (
        <div class="pain__row" data-reveal="left" style={`--rv-delay:${140 + i * 90}ms`}>
          <span class="pain__cost">-{item.cost}</span>
          <p class="pain__line">{item.p}</p>
          <span class="pain__x">✕</span>
        </div>
      ))}
    </div>
  </div>

  <div class="container pain__answer">
    <div class="pain__answerrule" data-reveal="line"></div>
    <p class="pain__answertext" data-reveal="clip">
      <span class="pain__answerstrong">We built LeelineSports so none of that is your job.</span>
      We handle the mess — sourcing, QC, logistics, customs. You handle the sales.
    </p>
  </div>
</section>

<style>
  .pain { position: relative; padding-block: clamp(5rem, 9vw, 8rem); background: var(--color-brand-bg); }
  .pain__grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .pain__title { margin-top: 1rem; }
  .pain__lede { margin-top: 1.4rem; line-height: 1.65; max-width: 46ch; font-size: 1.02rem; }

  .pain__board { padding: 1.6rem 1.6rem 1rem; }
  .pain__boardhead { display: flex; justify-content: space-between; padding-bottom: 1.1rem; border-bottom: 1px solid rgba(245,245,244,.1); margin-bottom: .4rem; }
  .pain__row {
    display: grid; grid-template-columns: 54px 1fr auto; align-items: center; gap: 1rem;
    padding-block: 1.05rem; border-bottom: 1px solid rgba(245,245,244,.07);
  }
  .pain__row:last-child { border-bottom: 0; }
  .pain__cost {
    font-family: var(--font-heading); font-stretch: 125%; font-weight: 850; font-size: 1.5rem;
    color: var(--color-brand-accent); font-variant-numeric: tabular-nums;
  }
  .pain__line { font-size: .98rem; line-height: 1.5; color: var(--color-brand-text); }
  .pain__x { color: var(--color-brand-accent); opacity: .7; font-size: 1.1rem; }

  .pain__answer { margin-top: clamp(3rem, 6vw, 5rem); }
  .pain__answerrule { height: 2px; background: var(--color-brand-accent); width: 100%; margin-bottom: 1.6rem; }
  .pain__answertext { font-size: clamp(1.3rem, 3vw, 2.2rem); font-weight: 600; line-height: 1.3; max-width: 30ch; color: var(--color-brand-text); }
  .pain__answerstrong { color: var(--color-brand-accent); }

  @media (max-width: 880px) {
    .pain__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
