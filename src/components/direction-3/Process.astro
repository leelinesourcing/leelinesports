---
const steps = [
  { num: '01', title: 'Discovery', dur: '2–3 days', desc: 'Send a sketch, a tech pack, or just a reference product. We lock spec, price and timeline in one brief.' },
  { num: '02', title: 'Shortlist', dur: '3–5 days', desc: 'We match you to vetted factories from 5,000+ suppliers. You approve the shortlist — we negotiate.' },
  { num: '03', title: 'Sampling', dur: '5–10 days', desc: 'A physical sample lands on your desk. Sampling fees are refunded against your bulk order.' },
  { num: '04', title: 'Production + QC', dur: 'In-line', desc: 'We run AQL 2.5 inspection, live video reviews and man-in-plant supervision. Nothing ships blind.' },
  { num: '05', title: 'Delivery', dur: 'DDP', desc: 'Express 3–5d, air 7–12d, sea 25–40d — duties included. FBA prep if you need it.' },
];
---

<section class="process" id="process">
  <span class="sideline" aria-hidden="true"></span>
  <div class="container">
    <div class="process__head">
      <div>
        <p class="label" data-reveal="left">How it works</p>
        <h2 class="h2" data-reveal="up" style="--rv-delay:80ms">Five laps. One finish line.</h2>
      </div>
      <p class="process__intro muted" data-reveal="up" style="--rv-delay:160ms">
        From first message to freight-forwarded, you're never more than a
        WhatsApp away from the person who actually owns your order.
      </p>
    </div>

    <div class="process__track">
      <div class="process__rail" aria-hidden="true">
        <span class="process__railfill" data-reveal="line"></span>
        {steps.map((s, i) => <span class="process__node" style={`left:${i * 20}%`}></span>)}
      </div>
      <div class="process__grid">
        {steps.map((s, i) => (
          <article class="process__step" data-reveal="up" style={`--rv-delay:${i * 100}ms`}>
            <span class="process__num">{s.num}</span>
            <h3 class="h3 process__title">{s.title}</h3>
            <span class="process__dur">{s.dur}</span>
            <p class="muted process__desc">{s.desc}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="process__cta" data-reveal="up">
      <a href="#quote" class="btn btn--primary">Start at lap 01</a>
    </div>
  </div>
</section>

<style>
  .process { position: relative; padding-block: clamp(5rem, 9vw, 8rem); background: var(--color-brand-bg); }
  .process__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .process__head .label { margin-bottom: .9rem; }
  .process__intro { max-width: 34ch; font-size: 1rem; }

  .process__track { position: relative; }
  .process__rail {
    position: relative; height: 2px; margin-bottom: 2.4rem;
    background: rgba(245,245,244,.12);
  }
  .process__railfill { position: absolute; inset: 0; background: var(--color-brand-accent); transform-origin: left; }
  .process__node {
    position: absolute; top: -5px; width: 12px; height: 12px;
    border: 2px solid var(--color-brand-accent); background: var(--color-brand-bg);
    transform: translateX(-6px) rotate(45deg);
  }
  .process__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(1.2rem, 2vw, 1.6rem); }
  .process__step { display: flex; flex-direction: column; gap: .6rem; align-items: flex-start; }
  .process__num { font-family: var(--font-heading); font-stretch: 125%; font-weight: 850; font-size: 1.4rem; color: var(--color-brand-accent); }
  .process__title { color: var(--color-brand-text); }
  .process__dur {
    font-family: var(--font-heading); font-stretch: 62%; font-weight: 650; text-transform: uppercase;
    letter-spacing: .12em; font-size: .68rem; color: var(--color-brand-muted);
  }
  .process__desc { line-height: 1.6; font-size: .93rem; }
  .process__cta { margin-top: clamp(2.5rem, 5vw, 4rem); }

  @media (max-width: 960px) {
    .process__head { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .process__rail { display: none; }
    .process__grid { grid-template-columns: 1fr; gap: 1.8rem; padding-top: 0; }
    .process__step {
      position: relative; padding-left: 2rem; border-left: 2px solid rgba(245,245,244,.1);
    }
    .process__step::before {
      content: ""; position: absolute; left: -7px; top: 4px; width: 12px; height: 12px;
      border: 2px solid var(--color-brand-accent); background: var(--color-brand-bg); transform: rotate(45deg);
    }
  }
</style>
