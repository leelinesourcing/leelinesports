---
const items = [
  'AQL 2.5 QC',
  'ISO 5077 · shrinkage ≤ 3–5%',
  'ISO 105 · colorfast grade 4+',
  'MOQ 50–100 blanks',
  '5,000+ vetted suppliers',
  'DDP pricing · no surprise fees',
  '5–10 day sampling',
  'FBA prep · barcoding / poly-bag / injection',
];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    <div class="ticker__group">
      {items.map((i) => (
        <>
          <span class="ticker__item">{i}</span>
          <span class="ticker__item ticker__sep">///</span>
        </>
      ))}
    </div>
    <div class="ticker__group">
      {items.map((i) => (
        <>
          <span class="ticker__item">{i}</span>
          <span class="ticker__item ticker__sep">///</span>
        </>
      ))}
    </div>
  </div>
</div>
