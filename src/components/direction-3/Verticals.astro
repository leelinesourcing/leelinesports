---
const verticals = [
  {
    img: '/images/redesign/image-06.webp',
    alt: 'Yoga and performance wear',
    num: '01',
    title: 'Performance wear',
    desc: 'Yoga sets, compression, seamless knit and training layers engineered to survive a wash cycle and a reorder.',
    specs: [
      { v: 'Grade 4+', k: 'ISO 105 colorfastness' },
      { v: '≤ 5%', k: 'ISO 5077 shrinkage' },
    ],
    moq: 'MOQ 100',
  },
  {
    img: '/images/redesign/image-14.avif',
    alt: 'Sublimated team jersey',
    num: '02',
    title: 'Team sports',
    desc: 'Fully sublimated jerseys and uniforms in XS–3XL. Logos are dyed into the fabric, not heat-pressed onto it.',
    specs: [
      { v: 'XS–3XL', k: 'Size run, one dye lot' },
      { v: '50', k: 'Low-MOQ reorders' },
    ],
    moq: 'MOQ 200',
  },
  {
    img: '/images/redesign/image-12.avif',
    alt: 'UV swimwear',
    num: '03',
    title: 'Swim & outdoor',
    desc: 'UV swimwear, waterproof jackets and outdoor shells with sealed seams and UPF-rated fabric — tested, not claimed.',
    specs: [
      { v: 'UPF 50+', k: 'Tested sun protection' },
      { v: '3–5d', k: 'Express reorders' },
    ],
    moq: 'MOQ 100',
  },
];

const bench = [
  'Golf', 'Fishing', 'Hunting', 'Cycling', 'Tennis', 'Baseball',
  'Socks', 'Underwear', 'Streetwear', 'Bags', 'Gym', 'Swim',
];
---

<section class="verts speedlines" id="verticals">
  <span class="sideline" aria-hidden="true"></span>
  <span class="plus" style="top:2.6rem; right:clamp(20px,5vw,72px)" aria-hidden="true"></span>
  <div class="container">
    <div class="verts__head">
      <div class="verts__headnum num-outline" data-reveal="clip">01</div>
      <div class="verts__headcopy">
        <p class="label" data-reveal="left" style="--rv-delay:0ms">Three fields. One supply chain.</p>
        <h2 class="h2" data-reveal="up" style="--rv-delay:80ms">We manufacture the gear<br />your buyers already wear</h2>
      </div>
      <p class="verts__intro muted" data-reveal="up" style="--rv-delay:160ms">
        Pick a vertical, send a sketch or a reference, and we take it from
        fabric weight to finished label. Every line starts at 100 units.
      </p>
    </div>

    <div class="verts__grid">
      {verticals.map((v, i) => (
        <article class="vert card" data-reveal="up" style={`--rv-delay:${i * 120}ms`}>
          <div class="vert__media">
            <img src={v.img} alt={v.alt} class="vert__img" loading="lazy" decoding="async" />
            <span class="vert__num num-outline">{v.num}</span>
            <span class="plus" style="top:14px; right:14px" aria-hidden="true"></span>
          </div>
          <div class="vert__body">
            <h3 class="h3">{v.title}</h3>
            <p class="vert__desc muted">{v.desc}</p>
            <div class="vert__specs">
              {v.specs.map((s) => (
                <div class="vert__spec">
                  <span class="vert__specval">{s.v}</span>
                  <span class="vert__speckey muted">{s.k}</span>
                </div>
              ))}
            </div>
            <div class="vert__foot">
              <span class="vert__moq">{v.moq}</span>
              <a href="#quote" class="vert__link link-arrow">Start this vertical →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="verts__bench" data-reveal="up">
      <span class="label">And 12 more categories from the same line</span>
      <div class="verts__chips">
        {bench.map((b) => <span class="chip">{b}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .verts { position: relative; padding-block: clamp(5rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem); }
  .verts__head {
    display: grid; grid-template-columns: 120px 1fr auto; gap: clamp(1.5rem, 3vw, 3rem);
    align-items: end; margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .verts__headnum { font-size: clamp(4rem, 9vw, 7rem); align-self: start; }
  .verts__headcopy .label { margin-bottom: 1rem; }
  .verts__intro { max-width: 32ch; padding-bottom: .4rem; }

  .verts__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.2rem, 2.5vw, 2rem); align-items: start; }
  .vert:nth-child(2) { margin-top: clamp(0px, 4vw, 3.5rem); }
  .vert:nth-child(3) { margin-top: clamp(0px, 8vw, 7rem); }

  .vert { background: var(--color-brand-surface); border: 1px solid rgba(245, 245, 244, .07); }
  .vert__media { position: relative; aspect-ratio: 4 / 4.6; overflow: hidden; }
  .vert__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .9s var(--ease-out), filter .6s;
    filter: saturate(.92) contrast(1.02);
  }
  .vert:hover .vert__img { transform: scale(1.06); }
  .vert__num {
    position: absolute; left: .4rem; bottom: -.5rem; font-size: clamp(4.5rem, 8vw, 6.5rem);
    -webkit-text-stroke: 1px rgba(10,10,11,.9); opacity: .9;
  }
  .vert__body { padding: 1.6rem 1.5rem 1.5rem; }
  .vert__desc { margin-top: .7rem; line-height: 1.55; font-size: .95rem; }
  .vert__specs { display: flex; gap: 1.6rem; margin-top: 1.2rem; padding-block: 1rem; border-top: 1px solid rgba(245,245,244,.08); }
  .vert__spec { display: flex; flex-direction: column; gap: .2rem; }
  .vert__specval { font-family: var(--font-heading); font-stretch: 125%; font-weight: 850; font-size: 1.25rem; color: var(--color-brand-accent); }
  .vert__speckey { font-size: .74rem; }
  .vert__foot { display: flex; align-items: center; justify-content: space-between; margin-top: .4rem; }
  .vert__moq {
    font-family: var(--font-heading); font-stretch: 62%; font-weight: 650; text-transform: uppercase;
    letter-spacing: .12em; font-size: .68rem; color: var(--color-brand-muted);
    border: 1px solid rgba(245,245,244,.14); padding: .4rem .7rem;
  }
  .vert__link { font-size: .88rem; }

  .verts__bench { display: flex; flex-direction: column; gap: 1rem; margin-top: clamp(5rem, 10vw, 9rem); }
  .verts__chips { display: flex; flex-wrap: wrap; gap: .55rem; }
  .chip {
    font-family: var(--font-heading); font-stretch: 62%; font-weight: 600; text-transform: uppercase;
    letter-spacing: .1em; font-size: .7rem; color: var(--color-brand-muted);
    border: 1px solid rgba(245,245,244,.12); padding: .55rem .9rem; transition: color .25s, border-color .25s, background .25s;
  }
  .chip:hover { color: var(--color-brand-text); border-color: var(--color-brand-accent); }

  @media (max-width: 960px) {
    .verts__head { grid-template-columns: 1fr; gap: 1.4rem; }
    .verts__headnum { font-size: 4rem; }
    .verts__grid { grid-template-columns: 1fr; gap: 1.4rem; }
    .vert:nth-child(2), .vert:nth-child(3) { margin-top: 0; }
    .vert__media { aspect-ratio: 16 / 10; }
  }
</style>
