---
const cols = ['MOQ', 'Quality', 'Pricing', 'Reorders'];
const rows = [
  {
    name: 'LeelineSports', tag: 'Manufacturing + supply chain', pts: 98, highlight: true,
    cells: ['50–100 blanks · 200–300 custom', 'AQL 2.5 + ISO 5077 / 105', 'DDP — one number', 'From 50 units'],
  },
  {
    name: 'Direct factory', tag: 'Go it alone', pts: 61, highlight: false,
    cells: ['500+ units', '“Trust me”', 'Ex-works + duties', 'Full MOQ'],
  },
  {
    name: 'Trading company', tag: 'Middleman', pts: 54, highlight: false,
    cells: ['300+ units', 'No standard', 'Markup + duties', 'Slow'],
  },
  {
    name: 'Western agent', tag: 'Local rep', pts: 70, highlight: false,
    cells: ['100 units', 'Good, costly', '+35% margin', 'Slow'],
  },
];
---

<section class="why" id="why-us">
  <div class="container">
    <div class="why__head">
      <p class="label why__label" data-reveal="left">Why us</p>
      <h2 class="h2 why__title" data-reveal="up" style="--rv-delay:80ms">The league table doesn't lie</h2>
      <p class="why__intro" data-reveal="up" style="--rv-delay:160ms">
        Four ways to get sportswear made. One of them owns your QC, your
        freight and your duties — and still comes in cheaper than the agent.
      </p>
    </div>

    <div class="why__tablewrap" data-reveal="up" style="--rv-delay:200ms">
      <table class="why__table">
        <thead>
          <tr>
            <th scope="col" class="why__th-name">Supplier</th>
            {cols.map((c) => <th scope="col" class="why__th">{c}</th>)}
            <th scope="col" class="why__th-pts">PTS</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class={r.highlight ? 'why__row why__row--win' : 'why__row'}>
              <th scope="row" class="why__name">
                <span class="why__nameval">{r.name}</span>
                <span class="why__tag">{r.tag}</span>
              </th>
              {r.cells.map((c) => (
                <td class="why__cell">
                  {r.highlight ? <span class="why__check">✓</span> : <span class="why__x">✕</span>}
                  {c}
                </td>
              ))}
              <td class="why__pts">{r.pts}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="why__foot" data-reveal="up">
      PTS = points we award for de-risking your order. The only column that matters is the one
      you'd bet a season on.
    </p>
  </div>
</section>

<style>
  .why {
    position: relative; padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--color-brand-text); color: #0A0A0B; /* the single inversion */
  }
  .why__label { color: #0A0A0B; opacity: .6; }
  .why__title { margin-top: .8rem; color: #0A0A0B; }
  .why__intro { margin-top: 1.2rem; max-width: 52ch; line-height: 1.6; color: rgba(10,10,11,.72); }

  .why__tablewrap { margin-top: clamp(2.5rem, 5vw, 4rem); overflow-x: auto; border: 1px solid rgba(10,10,11,.16); }
  .why__table { width: 100%; border-collapse: collapse; min-width: 720px; }
  .why__table th, .why__table td { padding: 1.1rem 1.2rem; text-align: left; }
  .why__table thead th {
    font-family: var(--font-heading); font-stretch: 62%; font-weight: 650; text-transform: uppercase;
    letter-spacing: .12em; font-size: .68rem; color: rgba(10,10,11,.55);
    border-bottom: 1px solid rgba(10,10,11,.16);
  }
  .why__th-pts { text-align: right; }
  .why__row { border-bottom: 1px solid rgba(10,10,11,.1); }
  .why__row:last-child { border-bottom: 0; }
  .why__row--win { background: var(--color-brand-accent); }
  .why__row--win .why__nameval { color: #0A0A0B; }
  .why__name { display: flex; flex-direction: column; gap: .2rem; }
  .why__nameval {
    font-family: var(--font-heading); font-stretch: 118%; font-weight: 800; text-transform: uppercase;
    letter-spacing: -0.01em; font-size: 1.05rem; color: #0A0A0B;
  }
  .why__tag { font-size: .78rem; color: rgba(10,10,11,.55); }
  .why__cell { font-size: .92rem; color: rgba(10,10,11,.7); }
  .why__row--win .why__cell { color: #0A0A0B; font-weight: 500; }
  .why__check { color: #0A0A0B; font-weight: 800; margin-right: .45rem; }
  .why__x { color: rgba(10,10,11,.35); margin-right: .45rem; }
  .why__pts {
    font-family: var(--font-heading); font-stretch: 125%; font-weight: 900; font-size: 1.7rem;
    text-align: right; color: #0A0A0B; font-variant-numeric: tabular-nums;
  }
  .why__row--win .why__pts { color: #0A0A0B; }

  .why__foot { margin-top: 1.4rem; font-size: .88rem; color: rgba(10,10,11,.6); max-width: 60ch; }

  @media (max-width: 720px) {
    .why__table { min-width: 640px; }
  }
</style>
