---
import SectionHead from './SectionHead.astro';

const services = [
  {
    n: '01',
    name: 'OEM — Cut & Sew',
    copy: 'Your tech pack, our machines. We source fabric, lock the spec, and cut-and-sew to your exact pattern — down to the seam allowance.',
    tags: ['MOQ 200–300 custom', 'Tech pack driven', 'Pattern kept on file'],
  },
  {
    n: '02',
    name: 'ODM — Design to Shelf',
    copy: 'Give us a reference and a price point; we return a private-label line with fabrics, trims, and samples — ready for your logo.',
    tags: ['5,000+ suppliers', 'Fabric + trim library', 'Pantone matched'],
  },
  {
    n: '03',
    name: 'FBA Prep & Injection',
    copy: 'Barcoding, poly-bagging, carton labeling and direct injection into Amazon FCs — so the goods are sellable the day they land.',
    tags: ['Amazon FC injection', 'FN/UPC labeling', 'Poly-bag compliant'],
  },
  {
    n: '04',
    name: 'Quality Control',
    copy: 'AQL 2.5 major / 4.0 minor at inline and final inspection, with ISO 5077 shrinkage and ISO 105 colorfastness documented per lot.',
    tags: ['AQL 2.5 / 4.0', 'ISO 5077 · ≤3–5%', 'Live video + man-in-plant'],
  },
  {
    n: '05',
    name: 'DDP Logistics',
    copy: 'One landed cost for manufacturing, freight and duties. Express, air, or sea — tracked to your door, no surprise fees at the dock.',
    tags: ['Express 3–5d', 'Air 7–12d', 'Sea 25–40d'],
  },
];
---

<section id="deliver" class="deliver">
  <div class="wrap">
    <SectionHead index="04" code="SERVICE MAP" title="Everything after the sketch is ours." blurb="Five services, one accountable partner. You never have to translate between a factory, a freight forwarder, and an inspector — that's the job we're doing." aside="5 SERVICES" />

    <div class="d-list" data-reveal="up">
      {services.map((s, i) => (
        <article class="d-row" data-reveal="left" style={`--d:${i * 0.05}s`}>
          <div class="d-num" aria-hidden="true">{s.n}</div>
          <div class="d-main">
            <h3 class="d-name">{s.name}</h3>
            <p class="d-copy">{s.copy}</p>
          </div>
          <div class="d-tags">
            {s.tags.map((t) => <span class="mono d-tag">{t}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .deliver { background: var(--paper); padding: 110px 0 120px; }
  .d-list { margin-top: 52px; border-top: 1px solid var(--hair); }

  .d-row {
    display: grid; grid-template-columns: 54px 1fr;
    gap: 18px; align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--hair);
    position: relative;
    transition: background .3s var(--ease-out);
  }
  .d-row::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--blue); transform: scaleY(0); transform-origin: top; transition: transform .35s var(--ease-out); }
  .d-row:hover::before { transform: scaleY(1); }
  .d-row:hover { background: rgba(43,76,196,0.035); }

  @media (min-width: 900px) {
    .d-row { grid-template-columns: 90px 1fr minmax(280px, auto); gap: 26px; align-items: center; }
  }

  .d-num { font-family: var(--font-heading); font-weight: 600; font-size: 2rem; color: var(--blue); letter-spacing: -0.02em; line-height: 1; }
  .d-name { font-family: var(--font-heading); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.02em; margin: 0 0 8px; }
  .d-copy { font-size: 0.98rem; line-height: 1.6; color: var(--muted); margin: 0; max-width: 56ch; }

  .d-tags { display: flex; flex-wrap: wrap; gap: 8px; grid-column: 2; }
  @media (min-width: 900px) { .d-tags { grid-column: auto; justify-content: flex-end; } }
  .d-tag { display: inline-block; border: 1px solid var(--hair); color: var(--ink); padding: 6px 10px; border-radius: 2px; font-size: 0.6rem; white-space: nowrap; }
  .d-tag:hover { border-color: var(--blue); color: var(--blue); }
</style>
