---
import SectionHead from './SectionHead.astro';

const faqs = [
  { n: '01', q: 'What’s your minimum order?', a: '50–100 pieces on stock blanks; 200–300 pieces on custom private label. Below that, we’ll tell you honestly — and point you to a stock program that fits.' },
  { n: '02', q: 'How do you protect my designs?', a: 'An NDA is signed before any sample is made. Your tech pack is shown only to the factory assigned to your order — never to another buyer.' },
  { n: '03', q: 'What does DDP actually include?', a: 'Manufacturing, freight, duties and customs clearance in one landed cost. The price we quote is the price you pay at your door. No dock-side line items.' },
  { n: '04', q: 'How does QC work, exactly?', a: 'AQL 2.5 (major) / 4.0 (minor) sampling at inline and final inspection, with ISO 5077 shrinkage and ISO 105 colorfastness documented per lot. You can watch it live on video, and our man-in-plant stands on the line.' },
  { n: '05', q: 'How fast can I sample?', a: 'Pre-production samples in 5–10 days, lab report attached. Sampling fees are refunded against your bulk order.' },
  { n: '06', q: 'Do you handle Amazon FBA?', a: 'Yes. Barcoding, poly-bagging, carton labeling, and direct injection into Amazon FCs — so inventory is sellable the day it lands.' },
];
---

<section id="faq" class="faq">
  <div class="wrap faq-wrap">
    <SectionHead index="10" code="INQUIRY" title="Questions, answered to spec." blurb="If it's not here, ask directly — a human replies, usually within a day." aside="6 ITEMS" />

    <div class="faq-list" data-reveal="up">
      {faqs.map((f) => (
        <div class="faq-item" data-faq-item>
          <button class="faq-btn" data-faq-btn aria-expanded="false">
            <span class="mono faq-n">{f.n}</span>
            <span class="faq-q">{f.q}</span>
            <span class="faq-ico" aria-hidden="true"></span>
          </button>
          <div class="faq-panel" data-faq-panel>
            <div class="faq-a">{f.a}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="faq-more" data-reveal="up">
      <span class="mono">MORE QUESTIONS?</span>
      <a href="https://wa.me/8613986152456" target="_blank" rel="noopener">WhatsApp · +86 139 8615 2456</a>
      <a href="mailto:info@leelinesports.com">info@leelinesports.com</a>
    </div>
  </div>
</section>

<style>
  .faq { background: var(--paper); padding: 110px 0 120px; }
  .faq-wrap { max-width: 1200px; }
  .faq-list { margin-top: 52px; border-top: 1px solid var(--hair); max-width: 860px; }

  .faq-item { border-bottom: 1px solid var(--hair); }
  .faq-btn { display: grid; grid-template-columns: 40px 1fr 28px; gap: 14px; align-items: center; width: 100%; text-align: left; background: none; border: none; padding: 22px 0; cursor: pointer; }
  .faq-n { color: var(--blue); }
  .faq-q { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.05rem, 1.8vw, 1.25rem); letter-spacing: -0.02em; color: var(--ink); }
  .faq-ico { position: relative; width: 16px; height: 16px; justify-self: end; }
  .faq-ico::before, .faq-ico::after { content: ''; position: absolute; background: var(--blue); transition: transform .3s var(--ease-out); }
  .faq-ico::before { left: 0; top: 7px; width: 16px; height: 1.5px; }
  .faq-ico::after { left: 7px; top: 0; width: 1.5px; height: 16px; }
  .faq-item.is-open .faq-ico::after { transform: rotate(90deg); opacity: 0; }
  .faq-item.is-open .faq-ico::before { transform: rotate(180deg); }

  .faq-panel { height: 0; overflow: hidden; transition: height .4s var(--ease-out); }
  .faq-a { padding: 0 0 24px; padding-left: 54px; max-width: 62ch; font-size: 0.98rem; line-height: 1.65; color: var(--muted); }

  .faq-more { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 44px; }
  .faq-more .mono { color: var(--muted); }
  .faq-more a { color: var(--blue); text-decoration: none; border-bottom: 1px solid var(--hair-blue); padding-bottom: 2px; font-weight: 500; }
  .faq-more a:hover { border-color: var(--blue); }
</style>
