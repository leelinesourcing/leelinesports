---
---

<section id="quote" class="quote">
  <div class="wrap">
    <div class="q-grid">
      <div class="q-pitch">
        <span class="mono q-mark">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <circle cx="12" cy="12" r="6.4"></circle>
            <path d="M12 1v5.6M12 17.4V23M1 12h5.6M17.4 12H23"></path>
          </svg>
          SHT.11 · REQUEST FOR QUOTATION
        </span>

        <h2 class="q-title" data-reveal="up">Request a quote.<br />Get a landed cost.</h2>
        <p class="q-copy" data-reveal="up" style="--d:0.08s">
          Send a sketch or a link to something close. Within a day you get a
          DDP landed cost and a sample timeline — not a sales call.
        </p>

        <ol class="q-steps" data-reveal="up" style="--d:0.16s">
          <li><span class="mono q-step-n">01</span>We reply within 24 hours</li>
          <li><span class="mono q-step-n">02</span>You lock the spec + target date</li>
          <li><span class="mono q-step-n">03</span>Samples in 5–10 days</li>
        </ol>

        <div class="q-contacts" data-reveal="up" style="--d:0.24s">
          <a class="q-contact" href="https://wa.me/8613986152456" target="_blank" rel="noopener">
            <span class="mono">WHATSAPP</span>
            +86 139 8615 2456
          </a>
          <a class="q-contact" href="mailto:info@leelinesports.com">
            <span class="mono">EMAIL</span>
            info@leelinesports.com
          </a>
        </div>
      </div>

      <form class="q-form" data-quote-form data-reveal="right">
        <div class="q-form-head mono">
          <span>RFQ · LL-SP-RFQ</span>
          <span>SHEET 01 / 01</span>
        </div>

        <div class="q-fields">
          <div class="q-field q-field-2">
            <label class="mono q-label" for="qf-name">NAME</label>
            <input id="qf-name" name="name" type="text" placeholder="Your name" required />
          </div>
          <div class="q-field q-field-2">
            <label class="mono q-label" for="qf-company">COMPANY</label>
            <input id="qf-company" name="company" type="text" placeholder="Brand or company" />
          </div>
          <div class="q-field q-field-2">
            <label class="mono q-label" for="qf-email">EMAIL</label>
            <input id="qf-email" name="email" type="email" placeholder="you@brand.com" required />
          </div>
          <div class="q-field q-field-2">
            <label class="mono q-label" for="qf-phone">PHONE / WHATSAPP</label>
            <input id="qf-phone" name="phone" type="tel" placeholder="+1 …" />
          </div>
          <div class="q-field">
            <label class="mono q-label" for="qf-product">PRODUCT TYPE</label>
            <select id="qf-product" name="product">
              <option>Performance wear</option>
              <option>Team sports / jerseys</option>
              <option>Swim & outdoor</option>
              <option>Not sure yet</option>
            </select>
          </div>
          <div class="q-field q-field-2">
            <label class="mono q-label" for="qf-moq">ORDER SIZE (PCS)</label>
            <input id="qf-moq" name="moq" type="text" placeholder="e.g. 500" />
          </div>
          <div class="q-field q-field-2">
            <label class="mono q-label" for="qf-date">TARGET DATE</label>
            <input id="qf-date" name="date" type="text" placeholder="e.g. Q3 launch" />
          </div>
          <div class="q-field">
            <label class="mono q-label" for="qf-brief">PROJECT BRIEF</label>
            <textarea id="qf-brief" name="brief" rows="3" placeholder="Sketch, reference, fabric, or price point…"></textarea>
          </div>
        </div>

        <button class="q-submit" type="submit">
          Request a quote
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </button>
        <p class="mono q-note">NO SPAM · NDA ON REQUEST · RESPONSE &lt; 24H</p>

        <div class="q-success" data-quote-success hidden>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M8 12.5l2.6 2.6L16 9.5"></path>
          </svg>
          <span class="q-success-t">Brief received.</span>
          <span class="q-success-s">We’ll reply within 24 hours with a landed cost and a sample timeline.</span>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .quote { background: var(--paper); padding: 120px 0 130px; }
  .q-grid { display: grid; grid-template-columns: 1fr; gap: 44px; }
  @media (min-width: 960px) { .q-grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 64px; } }

  .q-mark { display: inline-flex; align-items: center; gap: 8px; color: var(--blue); margin-bottom: 22px; }
  .q-title { font-family: var(--font-heading); font-weight: 600; font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.0; letter-spacing: -0.03em; margin: 0; color: var(--ink); }
  .q-copy { margin: 20px 0 0; font-size: 1.08rem; line-height: 1.62; color: var(--muted); max-width: 44ch; }

  .q-steps { list-style: none; margin: 34px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .q-steps li { display: flex; align-items: center; gap: 14px; font-size: 1rem; font-weight: 500; color: var(--ink); }
  .q-step-n { color: var(--blue); }

  .q-contacts { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 36px; }
  .q-contact { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--ink); font-weight: 600; font-size: 0.95rem; }
  .q-contact .mono { color: var(--muted); font-size: 0.58rem; }
  .q-contact:hover { color: var(--blue); }

  .q-form { background: var(--carbon); color: #fff; border-radius: 2px; overflow: hidden; display: flex; flex-direction: column; }
  .q-form-head { display: flex; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid var(--hair-white); color: rgba(255,255,255,0.55); }
  .q-fields { padding: 6px 20px; }
  .q-field { border-bottom: 1px solid var(--hair-white); padding: 13px 0; }
  .q-label { display: block; color: rgba(255,255,255,0.5); font-size: 0.58rem; margin-bottom: 7px; }
  .q-field input, .q-field select, .q-field textarea {
    width: 100%; background: transparent; border: none; outline: none; color: #fff;
    font-family: var(--font-body); font-size: 0.98rem; padding: 0; resize: none;
  }
  .q-field select { appearance: none; cursor: pointer; }
  .q-field select option { color: #161616; }
  .q-field ::placeholder { color: rgba(255,255,255,0.3); }
  .q-field input:focus, .q-field textarea:focus, .q-field select:focus { border-bottom: 1px solid var(--blue); }

  .q-submit {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    margin: 22px 20px 0; padding: 16px; background: var(--red); color: #fff;
    border: none; border-radius: 2px; font-family: var(--font-body); font-weight: 600; font-size: 1rem;
    cursor: pointer; transition: background .2s, transform .25s var(--ease-spring);
  }
  .q-submit:hover { background: #D33A3F; transform: translateY(-1px); }
  .q-note { text-align: center; color: rgba(255,255,255,0.4); margin: 14px 0 22px; font-size: 0.55rem; }

  .q-success { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; padding: 40px 24px; color: #fff; }
  .q-success svg { color: #7C93E8; }
  .q-success-t { font-family: var(--font-heading); font-weight: 600; font-size: 1.4rem; }
  .q-success-s { color: rgba(255,255,255,0.6); max-width: 40ch; font-size: 0.95rem; }
</style>
