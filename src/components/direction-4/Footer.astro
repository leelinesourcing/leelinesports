---
const cols = [
  {
    title: 'Verticals',
    links: [
      ['Performance Wear', '#offerings'],
      ['Team Sports', '#offerings'],
      ['Swim & Outdoor', '#offerings'],
    ],
  },
  {
    title: 'Company',
    links: [
      ['About us', '#top'],
      ['Case studies', '#cases'],
      ['How it works', '#process'],
    ],
  },
];
---

<footer class="footer">
  <div class="ruler" aria-hidden="true"></div>
  <div class="wrap">
    <div class="f-grid">
      <div class="f-brand">
        <img
          class="f-logo"
          src="/images/redesign/image-01.png"
          alt="LeelineSports"
          width="220"
          height="40"
          loading="lazy"
        />
        <p class="f-tag">We handle the mess,<br />you handle the sales.</p>
        <span class="mono f-coord">30.5867°N · 114.3055°E — WUHAN</span>
      </div>

      {cols.map((c) => (
        <nav class="f-col" aria-label={c.title}>
          <span class="mono f-head">{c.title.toUpperCase()}</span>
          {c.links.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
      ))}

      <div class="f-col f-col-contact">
        <span class="mono f-head">REACH US</span>
        <a href="https://wa.me/8613986152456" target="_blank" rel="noopener">WhatsApp · +86 139 8615 2456</a>
        <a href="mailto:info@leelinesports.com">info@leelinesports.com</a>
        <a class="f-cta" href="#quote">Request a quote</a>
      </div>
    </div>

    <div class="f-bottom">
      <span class="mono">© 2026 LEELINESPORTS · ALL RIGHTS RESERVED</span>
      <span class="mono f-sheet">DWG · LL-SP · SHEET 12 / 12</span>
      <a href="#top" class="mono f-top">BACK TO TOP</a>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--surface); border-top: 1px solid var(--hair); }
  .ruler { height: 12px; background:
      repeating-linear-gradient(90deg, var(--muted) 0 1px, transparent 1px 9px); opacity: 0.4; }

  .f-grid { display: grid; grid-template-columns: 1fr; gap: 40px; padding: 64px 0 56px; }
  @media (min-width: 768px) { .f-grid { grid-template-columns: 2fr 1fr 1fr 1.3fr; } }

  .f-brand { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .f-logo { mix-blend-mode: multiply; display: block; }
  .f-tag { margin: 0; font-family: var(--font-heading); font-weight: 500; font-size: 1.05rem; line-height: 1.4; color: var(--ink); }
  .f-coord { color: var(--muted); font-size: 0.56rem; }

  .f-col { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .f-head { color: var(--muted); font-size: 0.6rem; margin-bottom: 6px; }
  .f-col a { color: var(--ink); text-decoration: none; font-size: 0.95rem; }
  .f-col a:hover { color: var(--blue); }

  .f-cta { display: inline-block; margin-top: 6px; background: var(--red); color: #fff !important; padding: 10px 16px; border-radius: 2px; font-weight: 600; font-size: 0.9rem !important; transition: background .2s, transform .25s var(--ease-spring); }
  .f-cta:hover { background: #D33A3F !important; transform: translateY(-1px); }

  .f-bottom { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; padding: 22px 0 30px; border-top: 1px solid var(--hair); }
  .f-bottom .mono { color: var(--muted); font-size: 0.58rem; }
  .f-sheet { margin-left: auto; }
  .f-top { text-decoration: none; color: var(--muted); }
  .f-top:hover { color: var(--blue); }
</style>
