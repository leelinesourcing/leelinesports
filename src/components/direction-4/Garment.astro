---
interface Props {
  class?: string;
  detailed?: boolean;
}
const { class: className = '', detailed = false } = Astro.props;
---

<svg
  class={`garment ${className}`}
  viewBox="0 0 440 520"
  fill="none"
  stroke="currentColor"
  aria-hidden="true"
>
  <!-- corner registration marks -->
  <g stroke-width="1" opacity="0.7">
    <circle cx="16" cy="16" r="7"></circle>
    <path d="M16 3v6M16 23v6M3 16h6M23 16h6"></path>
    <circle cx="424" cy="16" r="7"></circle>
    <path d="M424 3v6M424 23v6M411 16h6M431 16h6"></path>
  </g>

  <!-- body + sleeves outline -->
  <path
    stroke-width="1.6"
    d="M186 62 Q220 46 254 62 L272 88 L330 104 L360 150 L300 150 L292 180 L292 470 L148 470 L148 180 L140 150 L80 150 L110 104 L168 88 Z"
  ></path>

  <!-- neck rib band -->
  <path stroke-width="1.1" stroke-dasharray="3 3" d="M189 70 Q220 57 251 70"></path>

  <!-- center-front line -->
  <path stroke-width="0.9" stroke-dasharray="2 4" opacity="0.8" d="M220 80 L220 466"></path>

  <!-- shoulder seams -->
  <path stroke-width="0.9" stroke-dasharray="3 3" opacity="0.8" d="M186 72 L168 90"></path>
  <path stroke-width="0.9" stroke-dasharray="3 3" opacity="0.8" d="M254 72 L272 90"></path>

  <!-- sleeve hem -->
  <path stroke-width="0.9" stroke-dasharray="3 3" opacity="0.8" d="M82 152 L138 152"></path>
  <path stroke-width="0.9" stroke-dasharray="3 3" opacity="0.8" d="M302 152 L358 152"></path>

  {detailed && (
    <g stroke-width="0.9" opacity="0.7">
      <path stroke-dasharray="3 3" d="M150 196 L150 462"></path>
      <path stroke-dasharray="3 3" d="M290 196 L290 462"></path>
      <!-- hem stitch -->
      <path stroke-dasharray="2 3" d="M158 462 L282 462"></path>
    </g>
  )}

  <!-- chest dimension -->
  <g stroke-width="0.9">
    <path d="M80 218 L360 218"></path>
    <path d="M80 218 l6 -3 v6 z"></path>
    <path d="M360 218 l-6 -3 v6 z"></path>
    <rect x="178" y="205" width="84" height="17" fill="currentColor" opacity="0.08"></rect>
    <text x="220" y="218" text-anchor="middle" font-size="10.5" fill="currentColor"
      font-family="ui-monospace, monospace" letter-spacing="1.2">CHEST · 52 CM</text>
  </g>

  <!-- length dimension -->
  <g stroke-width="0.9">
    <path d="M404 64 L404 468"></path>
    <path d="M404 64 l-3 6 h6 z"></path>
    <path d="M404 468 l-3 -6 h6 z"></path>
    <text x="404" y="290" text-anchor="middle" font-size="10.5" fill="currentColor"
      font-family="ui-monospace, monospace" letter-spacing="1.2" transform="rotate(-90 404 290)">BODY · 70 CM</text>
  </g>

  <!-- sleeve length dimension -->
  <g stroke-width="0.9">
    <path d="M110 124 L80 124 L80 150"></path>
    <path d="M110 124 l-6 -3 v6 z"></path>
    <text x="96" y="116" text-anchor="middle" font-size="10" fill="currentColor"
      font-family="ui-monospace, monospace" letter-spacing="1">SLEEVE</text>
  </g>
</svg>
