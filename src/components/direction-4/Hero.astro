---
import Garment from './Garment.astro';
---

<section id="top" class="hero">
  <!-- grid guides -->
  <div class="wrap hero-wrap">
    <div class="guides" aria-hidden="true">
      {Array.from({ length: 12 }).map(() => <span></span>)}
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="mono kick rise" style="animation-delay:0ms">
          <span class="kick-box">§01</span> THE OUTSOURCED PROCUREMENT DEPARTMENT
        </p>

        <h1 class="rise" style="animation-delay:70ms">
          Bring a sketch.
          <span class="line-two">Ship to spec.</span>
        </h1>

        <svg class="dim rise" style="animation-delay:160ms" viewBox="0 0 420 20" fill="none" stroke="currentColor" aria-hidden="true">
          <path class="dim-track" d="M2 10 H380"></path>
          <path class="dim-head" d="M2 10 l6 -3.2 v6.4 z M380 10 l-6 -3.2 v6.4 z"></path>
          <rect x="150" y="2" width="120" height="15" fill="currentColor" opacity="0.07"></rect>
          <text x="210" y="13" text-anchor="middle" font-size="9" fill="currentColor" font-family="var(--mono)" letter-spacing="1.4">FROM TECH PACK → FBA</text>
        </svg>

        <p class="sub rise" style="animation-delay:220ms">
          LeelineSports runs your sourcing, QC, and DDP logistics across
          <strong>5,000+ vetted factories</strong> — so a private-label line lands
          in your warehouse, or straight into an Amazon FC, on a schedule you can
          plan around. No surprise fees. No black-box inspection.
        </p>

        <div class="cta-row rise" style="animation-delay:300ms">
          <a class="cta-primary" href="#quote">
            Request a quote
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="cta-ghost" href="https://wa.me/8613986152456" target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.8 2c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.8-.1 1.3Z"></path>
            </svg>
            WhatsApp us
          </a>
          <a class="email mono" href="mailto:info@leelinesports.com">info@leelinesports.com</a>
        </div>
      </div>

      <div class="hero-plate rise" style="animation-delay:180ms">
        <div class="plate-head mono">
          <span>PLATE 01 · TECH PACK</span>
          <span>BASE TEE · GSM 160–320</span>
        </div>
        <div class="plate-body">
          <Garment class="plate-garment" detailed />
          <div class="callout callout-a mono">
            <span class="co">A1</span> ISO 105 · COLORFAST GRADE 4+
          </div>
          <div class="callout callout-b mono">
            <span class="co">B4</span> ISO 5077 · SHRINK ≤ 3–5%
          </div>
        </div>
        <div class="plate-foot mono">
          <span>SCALE 1:4</span>
          <span>DWG · LL-SP-001</span>
          <span>REV C</span>
        </div>
        <span class="reg" aria-hidden="true"></span>
      </div>
    </div>

    <!-- proof bar (overlaps next section) -->
    <div class="proof rise" style="animation-delay:380ms">
      <div class="proof-cell">
        <span class="mono proof-label">QC STANDARD</span>
        <span class="proof-val"><span data-count="2.5">2.5</span><em> / 4.0</em></span>
        <span class="mono proof-note">AQL major / minor</span>
      </div>
      <div class="proof-cell">
        <span class="mono proof-label">VETTED FACTORIES</span>
        <span class="proof-val"><span data-count="5000" data-suffix="+">5,000+</span></span>
        <span class="mono proof-note">Wuhan consolidated</span>
      </div>
      <div class="proof-cell">
        <span class="mono proof-label">LOW MOQ</span>
        <span class="proof-val"><span data-count="100">100</span></span>
        <span class="mono proof-note">200–300 custom</span>
      </div>
      <div class="proof-cell">
        <span class="mono proof-label">SAMPLING</span>
        <span class="proof-val">5–10<em>d</em></span>
        <span class="mono proof-note">fees refunded on bulk</span>
      </div>
      <div class="proof-cell">
        <span class="mono proof-label">PRICING</span>
        <span class="proof-val">DDP</span>
        <span class="mono proof-note">duty + freight included</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; background: var(--paper); overflow: hidden; padding: 56px 0 0; }
  .hero-wrap { position: relative; }

  .guides { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(12, 1fr); gap: 0; pointer-events: none; }
  .guides span { border-left: 1px solid var(--hair); }
  .guides span:first-child { border-left: none; }

  .hero-grid { position: relative; display: grid; grid-template-columns: 1fr; gap: 48px; padding-bottom: 96px; }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px; padding-bottom: 120px; }
  }

  .hero-copy { padding-top: 8px; max-width: 620px; }

  .kick { display: flex; align-items: center; gap: 10px; color: var(--muted); margin: 0 0 24px; }
  .kick-box { display: inline-grid; place-items: center; color: var(--blue); border: 1px solid var(--hair-blue); padding: 3px 7px; border-radius: 2px; letter-spacing: 0.12em; }

  .hero h1 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(2.6rem, 7.4vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin: 0;
  }
  .line-two { display: block; color: var(--blue); }

  .dim { display: block; width: min(420px, 100%); color: var(--blue); margin: 22px 0 24px; overflow: visible; }
  .dim-track { stroke-dasharray: 380; stroke-dashoffset: 380; animation: drawline 1.2s var(--ease-out) 0.5s forwards; }
  @keyframes drawline { to { stroke-dashoffset: 0; } }

  .sub { font-size: clamp(1.02rem, 1.5vw, 1.18rem); line-height: 1.62; color: var(--muted); margin: 0 0 30px; max-width: 54ch; }
  .sub strong { color: var(--ink); font-weight: 600; }

  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .cta-primary {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--red); color: #fff; text-decoration: none;
    font-weight: 600; font-size: 1rem; padding: 15px 24px; border-radius: 2px;
    transition: transform .25s var(--ease-spring), background .2s;
  }
  .cta-primary:hover { background: #D33A3F; transform: translateY(-2px); }
  .cta-primary:active { transform: translateY(0) scale(.99); }
  .cta-ghost {
    display: inline-flex; align-items: center; gap: 9px;
    border: 1px solid var(--hair); color: var(--ink); text-decoration: none;
    font-weight: 600; font-size: 1rem; padding: 14px 22px; border-radius: 2px;
    transition: border-color .2s, background .2s, transform .25s var(--ease-spring);
  }
  .cta-ghost:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-2px); }
  .email { color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--hair); padding-bottom: 2px; }
  .email:hover { color: var(--blue); border-color: var(--blue); }

  /* tech-pack plate */
  .hero-plate { position: relative; border: 1px solid var(--hair); background: #fff; padding: 0; display: flex; flex-direction: column; min-height: 480px; }
  .plate-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--hair); color: var(--muted); }
  .plate-body { position: relative; flex: 1; display: grid; place-items: center; padding: 26px 18px; }
  .plate-garment { width: min(360px, 100%); color: var(--blue); }
  .callout { position: absolute; display: inline-flex; align-items: center; gap: 6px; font-size: 0.62rem; color: var(--ink); background: #fff; border: 1px solid var(--hair); padding: 4px 8px; border-radius: 2px; }
  .callout-a { top: 16px; left: 14px; }
  .callout-b { bottom: 16px; right: 14px; }
  .callout .co { color: var(--blue); }
  .plate-foot { display: flex; justify-content: space-between; padding: 10px 14px; border-top: 1px solid var(--hair); color: var(--muted); font-size: 0.6rem; }
  .reg { position: absolute; top: -6px; right: -6px; width: 12px; height: 12px; border: 1px solid var(--blue); border-radius: 50%; background: var(--paper); }
  .reg::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: var(--blue); }

  /* proof bar */
  .proof {
    position: relative; z-index: 5;
    display: grid; grid-template-columns: 1fr;
    background: var(--carbon); color: #fff;
    border-radius: 2px; overflow: hidden;
    margin-bottom: -52px;
  }
  @media (min-width: 640px) { .proof { grid-template-columns: repeat(5, 1fr); } }
  .proof-cell { padding: 20px 20px 22px; border-bottom: 1px solid var(--hair-white); }
  @media (min-width: 640px) {
    .proof-cell { border-bottom: none; border-right: 1px solid var(--hair-white); }
    .proof-cell:last-child { border-right: none; }
  }
  .proof-label { display: block; color: rgba(255,255,255,0.5); margin-bottom: 8px; }
  .proof-val { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.7rem, 3vw, 2.3rem); letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
  .proof-val em { font-style: normal; font-size: 0.55em; color: rgba(255,255,255,0.55); font-weight: 500; }
  .proof-note { display: block; color: rgba(255,255,255,0.4); margin-top: 8px; }
</style>
