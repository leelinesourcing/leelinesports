---
import SectionHead from './SectionHead.astro';
import Garment from './Garment.astro';

const steps = [
  {
    n: '01',
    title: 'Discovery',
    copy: 'Send a sketch, a reference photo, or a full tech pack. We quote a landed cost, not a factory price.',
    time: 'Day 0–2',
    deliver: 'Locked tech pack + DDP pricing',
  },
  {
    n: '02',
    title: 'Shortlist',
    copy: 'Your spec is matched against 5,000+ vetted suppliers — not whoever replied first on a marketplace.',
    time: 'Day 2–5',
    deliver: '2–3 factory shortlist',
  },
  {
    n: '03',
    title: 'Sampling',
    copy: 'Pre-production samples in 5–10 days, with the lab report attached. Fees refunded on the bulk order.',
    time: 'Day 5–15',
    deliver: 'Approved sample + lab report',
    sample: true,
  },
  {
    n: '04',
    title: 'Production + QC',
    copy: 'Inline AQL 2.5 checks run while the line moves; a final inspection signs off every carton before it seals.',
    time: 'Week 3–5',
    deliver: 'Signed QC report',
  },
  {
    n: '05',
    title: 'Delivery',
    copy: 'DDP to your door — or barcoded, poly-bagged, and injected straight into your Amazon FC.',
    time: '3–40d',
    deliver: 'FBA-ready goods',
  },
];
---

<section id="process" class="process">
  <div class="wrap">
    <SectionHead dark index="05" code="PROCESS" title="Five steps. Zero surprises." blurb="Every order runs the same five gates, on the same clock. This is the part that turns importing from a gamble into a repeatable system." aside="DEADLINE-FORWARD" />

    <div class="pt-track">
      <div class="pt-grid">
        <svg class="pt-dash" viewBox="0 0 1200 2" preserveAspectRatio="none" aria-hidden="true">
          <line x1="0" y1="1" x2="1200" y2="1" stroke="#7C93E8" stroke-width="2" stroke-dasharray="8 12" class="dash-loop"></line>
          <path d="M0 1 l6 -3 v6 z M1200 1 l-6 -3 v6 z" fill="#7C93E8"></path>
        </svg>

        {steps.map((s, i) => (
          <article class="pt-card" data-reveal="up" style={`--d:${i * 0.09}s`}>
            <span class="pt-node" aria-hidden="true"></span>
            <div class="pt-head">
              <span class="mono pt-step">STEP {s.n}</span>
              <span class="mono pt-days">{s.time}</span>
            </div>
            <h3 class="pt-title">{s.title}</h3>
            <p class="pt-copy">{s.copy}</p>
            <div class="pt-meta">
              <span class="mono pt-meta-label">DELIVERABLE</span>
              <span class="pt-meta-val">{s.deliver}</span>
            </div>
            {s.sample && <Garment class="pt-sample" />}
          </article>
        ))}
      </div>
    </div>

    <div class="pt-summary" data-reveal="draw">
      <div class="pt-sum-main">
        <span class="mono pt-sum-label">TOTAL CYCLE</span>
        <span class="pt-sum-big">Sketch → FBA-ready in as little as <strong>5 weeks</strong></span>
      </div>
      <div class="pt-sum-speeds">
        <span class="mono pt-speed"><i class="s-e"></i>EXPRESS 3–5d</span>
        <span class="mono pt-speed"><i class="s-a"></i>AIR 7–12d</span>
        <span class="mono pt-speed"><i class="s-s"></i>SEA 25–40d</span>
      </div>
    </div>
  </div>
</section>

<style>
  .process { background: var(--carbon); color: #fff; padding: 110px 0 120px; }

  .pt-track { margin-top: 60px; }
  .pt-grid { position: relative; display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .pt-grid { grid-template-columns: repeat(5, 1fr); } }

  .pt-dash { display: none; position: absolute; top: 0; left: 0; width: 100%; height: 2px; pointer-events: none; }
  @media (min-width: 1024px) { .pt-dash { display: block; } }

  .pt-card { position: relative; border-bottom: 1px solid var(--hair-white); padding: 36px 22px 30px 30px; background: rgba(255,255,255,0.018); overflow: hidden; }
  @media (min-width: 1024px) {
    .pt-card { border-bottom: none; border-top: 1px solid var(--hair-white); border-right: 1px solid var(--hair-white); padding: 40px 20px 30px; }
    .pt-card:last-child { border-right: none; }
  }

  .pt-node { position: absolute; width: 11px; height: 11px; background: var(--blue); border-radius: 50%; }
  .pt-node::before { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid #7C93E8; animation: nodepulse 2.6s var(--ease-out) infinite; }
  @media (max-width: 1023px) { .pt-node { left: 0; top: 22px; transform: translateX(-50%); } }
  @media (min-width: 1024px) { .pt-node { left: 50%; top: -6px; transform: translateX(-50%); } }

  .pt-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 22px; }
  .pt-step { color: #7C93E8; }
  .pt-days { color: rgba(255,255,255,0.45); }
  .pt-title { font-family: var(--font-heading); font-weight: 600; font-size: 1.45rem; letter-spacing: -0.02em; margin: 0 0 12px; }
  .pt-copy { font-size: 0.94rem; line-height: 1.6; color: rgba(255,255,255,0.64); margin: 0 0 24px; }

  .pt-meta { border-top: 1px solid var(--hair-white); padding-top: 14px; display: flex; flex-direction: column; gap: 5px; }
  .pt-meta-label { color: rgba(255,255,255,0.4); font-size: 0.58rem; }
  .pt-meta-val { color: #fff; font-weight: 500; font-size: 0.92rem; letter-spacing: -0.01em; }

  .pt-sample { position: absolute; right: -20px; bottom: -30px; width: 150px; opacity: 0.14; color: #7C93E8; pointer-events: none; }

  .pt-summary { margin-top: 48px; border: 1px solid var(--hair-white); padding: 22px 24px; display: grid; gap: 20px; }
  @media (min-width: 900px) { .pt-summary { grid-template-columns: 1fr auto; align-items: center; } }
  .pt-sum-main { display: flex; flex-direction: column; gap: 8px; }
  .pt-sum-label { color: rgba(255,255,255,0.45); }
  .pt-sum-big { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.25rem, 2.4vw, 1.7rem); letter-spacing: -0.02em; }
  .pt-sum-big strong { color: #7C93E8; }
  .pt-sum-speeds { display: flex; flex-wrap: wrap; gap: 10px; }
  .pt-speed { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--hair-white); padding: 7px 11px; border-radius: 2px; color: rgba(255,255,255,0.7); font-size: 0.6rem; }
  .pt-speed i { width: 7px; height: 7px; border-radius: 50%; }
  .s-e { background: #7C93E8; } .s-a { background: #A6B6F0; } .s-s { background: rgba(255,255,255,0.35); }
</style>
