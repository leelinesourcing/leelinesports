---
const quotes = [
  {
    q: 'The first shipment that didn’t need a single phone call. Tech pack in, cartons at the FC — with a QC report I actually read.',
    name: 'Marcus T.',
    role: 'Amazon private-label founder · 3,000+ units/mo',
    featured: true,
  },
  {
    q: 'Our league runs on a deadline. Leeline hit all five of mine and delivered eight days early.',
    name: 'Dana R.',
    role: 'Procurement lead · regional lacrosse league',
  },
  {
    q: 'I stopped babysitting factories. AQL 2.5 inline means the photos finally match the product.',
    name: 'Priya S.',
    role: 'Founder · activewear brand',
  },
];
---

<section id="proof" class="tst">
  <div class="wrap tst-wrap">
    <div class="tst-guides" aria-hidden="true">
      {Array.from({ length: 12 }).map(() => <span></span>)}
    </div>

    <div class="tst-head">
      <span class="mono tst-mark">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="12" cy="12" r="6.4"></circle>
          <path d="M12 1v5.6M12 17.4V23M1 12h5.6M17.4 12H23"></path>
        </svg>
        SHT.09 · FIELD NOTES
      </span>
      <h2 class="tst-title" data-reveal="up">Buyers, in their own words.</h2>
      <p class="tst-blurb" data-reveal="up" style="--d:0.08s">Not testimonials from a sales deck — production notes from people who run real orders.</p>
    </div>

    <div class="tst-grid">
      <blockquote class="tst-featured" data-reveal="up">
        <span class="tst-quotemark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 3v8M12 16v5M3 12h8M16 12h5"></path>
          </svg>
        </span>
        <p class="tst-q tst-q-lg">“{quotes[0].q}”</p>
        <footer class="tst-by">
          <span class="tst-name">{quotes[0].name}</span>
          <span class="mono tst-role">{quotes[0].role}</span>
        </footer>
      </blockquote>

      <div class="tst-side">
        {quotes.slice(1).map((t, i) => (
          <blockquote class="tst-small" data-reveal="up" style={`--d:${0.1 + i * 0.08}s`}>
            <p class="tst-q">“{t.q}”</p>
            <footer class="tst-by">
              <span class="tst-name">{t.name}</span>
              <span class="mono tst-role">{t.role}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tst { position: relative; background: var(--blue); color: #fff; padding: 110px 0 120px; overflow: hidden; }
  .tst-wrap { position: relative; }
  .tst-guides { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(12, 1fr); pointer-events: none; opacity: 0.35; }
  .tst-guides span { border-left: 1px solid rgba(255,255,255,0.12); }
  .tst-guides span:first-child { border-left: none; }

  .tst-head { position: relative; max-width: 640px; margin-bottom: 56px; }
  .tst-mark { display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.78); margin-bottom: 20px; }
  .tst-title { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.9rem, 4.4vw, 3.2rem); line-height: 1.02; letter-spacing: -0.03em; margin: 0; }
  .tst-blurb { color: rgba(255,255,255,0.72); margin: 16px 0 0; max-width: 52ch; }

  .tst-grid { position: relative; display: grid; grid-template-columns: 1fr; gap: 1px; background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.16); }
  @media (min-width: 900px) { .tst-grid { grid-template-columns: 7fr 5fr; } }

  .tst-featured { position: relative; background: var(--blue); padding: 40px 34px 34px; margin: 0; overflow: hidden; }
  .tst-quotemark { position: absolute; top: 24px; right: 26px; width: 46px; height: 46px; color: rgba(255,255,255,0.35); }
  .tst-q { margin: 0; line-height: 1.4; font-weight: 500; }
  .tst-q-lg { font-family: var(--font-heading); font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: -0.02em; }
  .tst-small { background: var(--blue); padding: 30px 30px 28px; margin: 0; }
  .tst-small + .tst-small { border-top: 1px solid rgba(255,255,255,0.16); }
  .tst-by { display: flex; flex-direction: column; gap: 3px; margin-top: 22px; }
  .tst-name { font-weight: 600; font-size: 0.95rem; }
  .tst-role { color: rgba(255,255,255,0.6); font-size: 0.6rem; }
</style>
