---
import Underline from './Underline.astro';

const cases = [
  {
    metric: '21',
    suffix: ' days',
    label: 'sketch to delivery',
    title: 'CrossFit affiliate merch drop',
    desc: '2,000 sublimated tees and tanks, graded XS–3XL, delivered from Wuhan to a Texas gym in three weeks flat.',
    attr: 'CrossFit affiliate · Austin, TX',
  },
  {
    metric: '18',
    suffix: '%',
    label: 'lower landed cost',
    title: 'Private-label activewear relaunch',
    desc: 'An FBA seller switched three ASINs to LeelineSports and cut landed cost 18% while holding defects under 2.5%.',
    attr: 'Private-label activewear · 3 ASINs',
  },
  {
    metric: '2.5',
    suffix: '%',
    decimals: 1,
    label: 'defect rate ceiling',
    title: 'UPF swimwear, zero surprises',
    desc: '1,500 pieces in UPF 50+ fabric with Grade 4+ colorfastness — one DDP invoice, no customs bill after.',
    attr: 'DTC swim brand · Florida',
  },
];
---

<section id="results" class="relative bg-brand-bg">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-28">
    <div class="max-w-3xl">
      <span class="js-reveal inline-flex items-center gap-2 rounded-full border border-brand-primary/15 bg-white/60 px-4 py-2 font-body text-[13px] font-medium text-brand-primary" data-reveal="up">
        Real results
      </span>
      <h2 class="js-reveal mt-5 font-heading font-semibold leading-[1.02] tracking-[-0.025em] text-brand-text text-[clamp(2rem,4.5vw,3.4rem)]" data-reveal="up" style="--d:.08s">
        Three briefs that became
        <span class="relative inline-block whitespace-nowrap">
          brands.
          <Underline class="absolute -bottom-2 left-0 h-[0.26em] w-full" />
        </span>
      </h2>
      <p class="js-reveal mt-5 max-w-xl font-body text-lg text-brand-muted" data-reveal="up" style="--d:.16s">
        Anonymous, but real — the kind of work we ship every month.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
      {cases.map((c, i) => (
        <article
          class={`js-reveal flex flex-col rounded-[1.75rem] bg-brand-surface p-7 shadow-[0_24px_50px_-30px_rgba(20,58,53,.3)] spring ${i === 1 ? 'md:-mt-6' : ''}`}
          data-reveal="up"
          style={`--d:${i * 0.09}s`}
        >
          <div class="flex items-end gap-2">
            <span class="font-heading font-semibold leading-none tracking-[-0.03em] text-brand-primary text-[clamp(3.5rem,6vw,4.5rem)]">
              <span data-count={c.metric} data-suffix={c.suffix} data-decimals={c.decimals ?? 0}>0</span>
            </span>
            <span class="mb-2 font-body text-[13px] font-medium leading-tight text-brand-muted">{c.label}</span>
          </div>
          <h3 class="mt-5 font-heading text-xl font-semibold text-brand-text">{c.title}</h3>
          <p class="mt-3 flex-1 font-body text-[15px] leading-relaxed text-brand-muted">{c.desc}</p>
          <p class="mt-6 border-t border-brand-primary/10 pt-4 font-body text-[13px] font-medium text-brand-primary">
            {c.attr}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
