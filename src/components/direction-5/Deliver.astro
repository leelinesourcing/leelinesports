---
import Underline from './Underline.astro';
import Check from './Check.astro';
import Divider from './Divider.astro';

const services = [
  {
    num: '01',
    title: 'OEM manufacturing',
    desc: 'Your spec, our floor. Stock blanks from 50–100 pieces, fully custom private label from 200–300.',
    evidence: 'MOQ 50–100 blanks · 200–300 custom',
  },
  {
    num: '02',
    title: 'ODM design',
    desc: 'Bring a sketch or a tech pack. We develop patterns, match exact Pantones, and build 3D and physical samples.',
    evidence: 'Tech-pack-to-production · 5–10 day sampling',
  },
  {
    num: '03',
    title: 'FBA prep',
    desc: 'Barcoding, poly-bagging and direct injection into Amazon fulfillment centers — TOS-clean, always.',
    evidence: 'Barcoding · poly-bagging · FC injection',
  },
  {
    num: '04',
    title: 'Quality control',
    desc: 'AQL 2.5 on major defects, 4.0 on minor. Live video inspections plus a man-in-plant at your factory.',
    evidence: 'AQL 2.5 / 4.0 · ISO 5077 · ISO 105',
  },
  {
    num: '05',
    title: 'Logistics & DDP',
    desc: 'Express, air or sea — every option delivered duty-paid, so the price you sign is the price you pay.',
    evidence: 'Express 3–5d · Air 7–12d · Sea 25–40d',
  },
];
---

<section id="deliver" class="relative bg-brand-primary">
  <Divider fill="var(--color-brand-primary)" />
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-28">
    <div class="max-w-3xl">
      <span class="js-reveal inline-flex items-center gap-2 rounded-full border border-brand-bg/20 bg-white/5 px-4 py-2 font-body text-[13px] font-medium text-brand-accent" data-reveal="up">
        What we deliver
      </span>
      <h2 class="js-reveal mt-5 font-heading font-semibold leading-[1.02] tracking-[-0.025em] text-brand-bg text-[clamp(2rem,4.5vw,3.4rem)]" data-reveal="up" style="--d:.08s">
        Five services.
        <span class="relative inline-block whitespace-nowrap">
          Zero guesswork.
          <Underline class="absolute -bottom-2 left-0 h-[0.26em] w-full" />
        </span>
      </h2>
      <p class="js-reveal mt-5 max-w-xl font-body text-lg text-brand-bg/70" data-reveal="up" style="--d:.16s">
        Everything between “we have an idea” and “the goods are in the warehouse” —
        handled by one team, on one invoice.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <article
          class="js-reveal flex flex-col rounded-[1.6rem] border border-white/10 bg-white/5 p-7 transition-colors duration-300 hover:border-white/20 hover:bg-white/[0.08]"
          data-reveal="up"
          style={`--d:${i * 0.07}s`}
        >
          <div class="flex items-center justify-between">
            <span class="font-heading text-3xl font-semibold text-brand-accent">{s.num}</span>
            <Check class="h-6 w-6 text-brand-accent/80" />
          </div>
          <h3 class="mt-5 font-heading text-xl font-semibold text-brand-bg">{s.title}</h3>
          <p class="mt-3 flex-1 font-body text-[15px] leading-relaxed text-brand-bg/70">{s.desc}</p>
          <p class="mt-5 border-t border-white/10 pt-4 font-body text-[13px] font-medium text-brand-accent">
            {s.evidence}
          </p>
        </article>
      ))}
      <article class="js-reveal flex flex-col justify-center rounded-[1.6rem] bg-brand-accent p-7 text-brand-primary" data-reveal="scale" style="--d:.35s">
        <p class="font-heading text-2xl font-semibold leading-tight">Sampling fees are refunded on your bulk order.</p>
        <p class="mt-3 font-body text-[15px] text-brand-primary/85">
          Try before you commit. Pre-production samples land in 5–10 days.
        </p>
        <a href="#quote" class="mt-5 inline-flex w-fit items-center rounded-full bg-brand-primary px-5 py-2.5 font-body text-sm font-semibold text-brand-bg">
          Start sampling
        </a>
      </article>
    </div>
  </div>
</section>
