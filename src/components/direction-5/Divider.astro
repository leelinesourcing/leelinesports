---
interface Props {
  fill?: string;
  flip?: boolean;
  class?: string;
}
const { fill = 'var(--color-brand-bg)', flip = false, class: className = '' } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 1440 96"
  preserveAspectRatio="none"
  aria-hidden="true"
  style={`display:block;width:100%;${flip ? 'transform:scaleX(-1);' : ''}`}
>
  <path
    d="M0 50 C 170 94, 350 6, 720 42 C 1090 78, 1260 14, 1440 44 L 1440 96 L 0 96 Z"
    fill={fill}
  />
</svg>
