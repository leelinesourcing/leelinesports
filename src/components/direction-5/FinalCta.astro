---
import Underline from './Underline.astro';
import Check from './Check.astro';
import Divider from './Divider.astro';
---

<section id="quote" class="relative overflow-hidden bg-brand-primary">
  <Divider fill="var(--color-brand-primary)" />
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 px-5 py-24 sm:px-8 sm:py-28 lg:grid-cols-2 lg:items-center">
    <div>
      <span class="js-reveal inline-flex items-center gap-2 rounded-full border border-brand-bg/20 bg-white/5 px-4 py-2 font-body text-[13px] font-medium text-brand-accent" data-reveal="up">
        Let’s talk
      </span>
      <h2 class="js-reveal mt-5 font-heading font-semibold leading-[1.02] tracking-[-0.025em] text-brand-bg text-[clamp(2.2rem,5vw,3.8rem)]" data-reveal="up" style="--d:.08s">
        Tell us what you’re
        <span class="relative inline-block whitespace-nowrap">
          building.
          <Underline class="absolute -bottom-2 left-0 h-[0.26em] w-full" />
        </span>
      </h2>
      <p class="js-reveal mt-6 max-w-lg font-body text-lg leading-relaxed text-brand-bg/75" data-reveal="up" style="--d:.16s">
        Send a sketch, a tech pack, or just a rough idea. We’ll come back within one
        business day with a supplier shortlist, a DDP price, and a realistic timeline.
      </p>

      <ul class="js-reveal mt-8 space-y-3" data-reveal="up" style="--d:.24s">
        {[
          'A quote within one business day',
          'No obligation, no spam, ever',
          'NDA available before you share details',
        ].map((line) => (
          <li class="flex items-center gap-3 font-body text-[15px] text-brand-bg/90">
            <Check class="h-5 w-5 shrink-0 text-brand-accent" />
            {line}
          </li>
        ))}
      </ul>

      <div class="js-reveal mt-8 flex flex-wrap gap-3" data-reveal="up" style="--d:.3s">
        <a href="https://wa.me/8613986152456" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-brand-bg/25 px-5 py-2.5 font-body text-sm font-medium text-brand-bg transition-colors hover:bg-white/5">
          WhatsApp · +86 139 8615 2456
        </a>
        <a href="mailto:info@leelinesports.com" class="inline-flex items-center gap-2 rounded-full border border-brand-bg/25 px-5 py-2.5 font-body text-sm font-medium text-brand-bg transition-colors hover:bg-white/5">
          info@leelinesports.com
        </a>
      </div>
    </div>

    <div class="js-reveal relative rounded-[2rem] bg-brand-bg p-7 shadow-[0_60px_120px_-50px_rgba(0,0,0,.6)] sm:p-9" data-reveal="right" style="--d:.2s">
      <p class="font-heading text-xl font-semibold text-brand-text">Request a quote</p>
      <p class="mt-1 font-body text-[14px] text-brand-muted">The more you share, the tighter the quote.</p>

      <form id="quote-form" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block font-body text-[13px] font-medium text-brand-text">Full name</span>
          <input type="text" name="name" required autocomplete="name" placeholder="Alex Morgan" class="w-full rounded-xl border border-brand-primary/15 bg-white px-4 py-3 font-body text-[15px] text-brand-text placeholder:text-brand-muted/60 focus:border-brand-accent focus:outline-none" />
        </label>
        <label class="block">
          <span class="mb-1.5 block font-body text-[13px] font-medium text-brand-text">Company</span>
          <input type="text" name="company" autocomplete="organization" placeholder="Your brand" class="w-full rounded-xl border border-brand-primary/15 bg-white px-4 py-3 font-body text-[15px] text-brand-text placeholder:text-brand-muted/60 focus:border-brand-accent focus:outline-none" />
        </label>
        <label class="block">
          <span class="mb-1.5 block font-body text-[13px] font-medium text-brand-text">Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@brand.com" class="w-full rounded-xl border border-brand-primary/15 bg-white px-4 py-3 font-body text-[15px] text-brand-text placeholder:text-brand-muted/60 focus:border-brand-accent focus:outline-none" />
        </label>
        <label class="block">
          <span class="mb-1.5 block font-body text-[13px] font-medium text-brand-text">Phone / WhatsApp</span>
          <input type="tel" name="phone" autocomplete="tel" placeholder="+1 …" class="w-full rounded-xl border border-brand-primary/15 bg-white px-4 py-3 font-body text-[15px] text-brand-text placeholder:text-brand-muted/60 focus:border-brand-accent focus:outline-none" />
        </label>
        <label class="block sm:col-span-2">
          <span class="mb-1.5 block font-body text-[13px] font-medium text-brand-text">Product type</span>
          <select name="product" class="w-full rounded-xl border border-brand-primary/15 bg-white px-4 py-3 font-body text-[15px] text-brand-text focus:border-brand-accent focus:outline-none">
            <option>Performance wear</option>
            <option>Team sports</option>
            <option>Swim &amp; outdoor</option>
            <option>Custom apparel / blanks</option>
            <option>Not sure yet</option>
          </select>
        </label>
        <label class="block">
          <span class="mb-1.5 block font-body text-[13px] font-medium text-brand-text">Order size (MOQ)</span>
          <select name="moq" class="w-full rounded-xl border border-brand-primary/15 bg-white px-4 py-3 font-body text-[15px] text-brand-text focus:border-brand-accent focus:outline-none">
            <option>50–200 units</option>
            <option>200–500 units</option>
            <option>500–1,000 units</option>
            <option>1,000–5,000 units</option>
            <option>5,000+ units</option>
          </select>
        </label>
        <label class="block">
          <span class="mb-1.5 block font-body text-[13px] font-medium text-brand-text">Target date</span>
          <input type="text" name="target" placeholder="e.g. Q4 2026" class="w-full rounded-xl border border-brand-primary/15 bg-white px-4 py-3 font-body text-[15px] text-brand-text placeholder:text-brand-muted/60 focus:border-brand-accent focus:outline-none" />
        </label>

        <button type="submit" class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-brand-accent px-7 py-4 font-body text-[15px] font-semibold text-brand-primary shadow-[0_18px_40px_-18px_rgba(224,154,62,.95)] spring sm:col-span-2">
          Request a quote
        </button>
        <p id="form-note" role="status" hidden class="sm:col-span-2 rounded-xl bg-brand-secondary/10 px-4 py-3 text-center font-body text-[14px] font-medium text-brand-primary"></p>
      </form>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-5 py-8 sm:flex-row sm:px-8">
      <div class="flex items-center gap-3">
        <img src="/images/redesign/image-01.png" alt="LeelineSports logo" width="32" height="32" class="h-7 w-auto" decoding="async" />
        <p class="font-body text-[13px] text-brand-bg/60">© 2026 LeelineSports · We handle the mess, you handle the sales.</p>
      </div>
      <p class="font-body text-[13px] text-brand-bg/50">Wuhan · Guangzhou · FBA-ready</p>
    </div>
  </div>
</section>
