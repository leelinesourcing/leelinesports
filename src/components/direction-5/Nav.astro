---
import Bell from './Bell.astro';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <nav class="flex items-center justify-between py-4" aria-label="Primary">
      <a href="#main" class="flex items-center gap-3">
        <img
          src="/images/redesign/image-01.png"
          alt="LeelineSports logo"
          width="40"
          height="40"
          class="h-9 w-auto"
          decoding="async"
        />
        <span class="font-heading font-600 text-lg tracking-[-0.01em] text-brand-text">
          Leeline<span class="text-brand-accent">Sports</span>
        </span>
      </a>

      <div class="hidden items-center gap-8 lg:flex">
        <a href="#verticals" class="font-body text-[15px] font-medium text-brand-text/80 transition-colors hover:text-brand-primary">What we make</a>
        <a href="#process" class="font-body text-[15px] font-medium text-brand-text/80 transition-colors hover:text-brand-primary">How it works</a>
        <a href="#who" class="font-body text-[15px] font-medium text-brand-text/80 transition-colors hover:text-brand-primary">Who it's for</a>
        <a href="#results" class="font-body text-[15px] font-medium text-brand-text/80 transition-colors hover:text-brand-primary">Results</a>
        <a href="#faq" class="font-body text-[15px] font-medium text-brand-text/80 transition-colors hover:text-brand-primary">FAQ</a>
      </div>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href="https://wa.me/8613986152456"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border border-brand-primary/20 px-4 py-2.5 font-body text-[14px] font-medium text-brand-primary transition-colors hover:border-brand-primary/50 hover:bg-brand-surface"
        >
          <Bell class="h-4 w-4 text-brand-accent animate-bell" />
          WhatsApp us
        </a>
        <a
          href="#quote"
          class="inline-flex items-center gap-2 rounded-full bg-brand-primary px-5 py-2.5 font-body text-[14px] font-semibold text-brand-bg shadow-[0_14px_30px_-14px_rgba(20,58,53,.7)] spring"
        >
          Request a quote
        </a>
      </div>

      <button
        id="menu-btn"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-brand-primary/20 text-brand-primary lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="menu-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </nav>

    <div id="mobile-menu" class="mobile-menu overflow-hidden lg:hidden">
      <div class="flex flex-col gap-1 rounded-3xl border border-brand-primary/10 bg-brand-bg p-4 shadow-[0_24px_60px_-24px_rgba(20,58,53,.5)]">
        <a href="#verticals" class="rounded-2xl px-4 py-3 font-body font-medium text-brand-text/90 hover:bg-brand-surface">What we make</a>
        <a href="#process" class="rounded-2xl px-4 py-3 font-body font-medium text-brand-text/90 hover:bg-brand-surface">How it works</a>
        <a href="#who" class="rounded-2xl px-4 py-3 font-body font-medium text-brand-text/90 hover:bg-brand-surface">Who it's for</a>
        <a href="#results" class="rounded-2xl px-4 py-3 font-body font-medium text-brand-text/90 hover:bg-brand-surface">Results</a>
        <a href="#faq" class="rounded-2xl px-4 py-3 font-body font-medium text-brand-text/90 hover:bg-brand-surface">FAQ</a>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <a href="https://wa.me/8613986152456" target="_blank" rel="noopener" class="rounded-full border border-brand-primary/20 px-4 py-3 text-center font-body text-sm font-medium text-brand-primary">WhatsApp</a>
          <a href="#quote" class="rounded-full bg-brand-primary px-4 py-3 text-center font-body text-sm font-semibold text-brand-bg">Request a quote</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    transition: background-color .4s ease, box-shadow .4s ease, transform .4s ease;
  }
  header.is-scrolled {
    background: rgba(246, 240, 230, .88);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 10px 34px -22px rgba(20, 58, 53, .55);
  }
  .font-600 { font-weight: 600; }

  .menu-bars {
    position: relative;
    width: 18px;
    height: 12px;
    display: inline-block;
  }
  .menu-bars span {
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform .3s ease, opacity .3s ease;
  }
  .menu-bars span:nth-child(1) { top: 0; }
  .menu-bars span:nth-child(2) { top: 5px; }
  .menu-bars span:nth-child(3) { top: 10px; }

  .mobile-menu {
    max-height: 0;
    transition: max-height .45s cubic-bezier(.22, .61, .36, 1);
  }
  .mobile-menu.open { max-height: 460px; }
</style>
