---
import Underline from './Underline.astro';
import Bell from './Bell.astro';

const steps = [
  {
    n: '1',
    title: 'Discovery',
    desc: 'Tell us what you’re selling. We map specs, targets and budget on a 30-minute call.',
    time: '30 min call',
  },
  {
    n: '2',
    title: 'Shortlist',
    desc: 'We match you to 3 suppliers from 5,000+ who already make products like yours.',
    time: '3 vetted options',
  },
  {
    n: '3',
    title: 'Sampling',
    desc: 'Pre-production samples in 5–10 days. Fees refund against your bulk order.',
    time: '5–10 days',
  },
  {
    n: '4',
    title: 'Production + QC',
    desc: 'We run AQL 2.5 inspections and stream live video from the line before release.',
    time: 'AQL 2.5 · live video',
  },
  {
    n: '5',
    title: 'Delivery',
    desc: 'Express, air or sea — DDP, with duties included and no surprise invoices.',
    time: '3–5d · 7–12d · 25–40d',
  },
];
---

<section id="process" class="relative overflow-hidden bg-brand-bg">
  <div class="mx-auto max-w-7xl px-5 pb-24 pt-24 sm:px-8 sm:pb-32 sm:pt-28">
    <div class="max-w-3xl">
      <span class="js-reveal inline-flex items-center gap-2 rounded-full border border-brand-primary/15 bg-white/60 px-4 py-2 font-body text-[13px] font-medium text-brand-primary" data-reveal="up">
        How it works
      </span>
      <h2 class="js-reveal mt-5 font-heading font-semibold leading-[1.02] tracking-[-0.025em] text-brand-text text-[clamp(2rem,4.5vw,3.4rem)]" data-reveal="up" style="--d:.08s">
        From hello to your warehouse in
        <span class="relative inline-block whitespace-nowrap">
          five steps.
          <Underline class="absolute -bottom-2 left-0 h-[0.26em] w-full" />
        </span>
      </h2>
    </div>

    <ol class="relative mt-16 grid grid-cols-1 gap-x-6 gap-y-12 md:grid-cols-5">
      <span class="pointer-events-none absolute left-0 right-0 top-7 hidden h-0.5 border-t-2 border-dashed border-brand-secondary/30 md:block" aria-hidden="true"></span>

      {steps.map((s, i) => (
        <li class="js-reveal relative" data-reveal="up" style={`--d:${i * 0.1}s`}>
          <div class="flex md:flex-col md:items-start">
            <span class="z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-primary font-heading text-lg font-semibold text-brand-bg shadow-[0_14px_30px_-14px_rgba(20,58,53,.7)]">
              {s.n}
            </span>
            <div class="mt-0 ml-4 md:ml-0 md:mt-5">
              <h3 class="font-heading text-lg font-semibold text-brand-text">{s.title}</h3>
              <p class="mt-2 font-body text-[14.5px] leading-relaxed text-brand-muted">{s.desc}</p>
              <span class="mt-3 inline-block rounded-full bg-brand-surface px-3 py-1 font-body text-[12px] font-medium text-brand-primary">
                {s.time}
              </span>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="js-reveal mt-14 flex flex-col items-start gap-4 rounded-[1.75rem] border border-brand-primary/10 bg-brand-surface p-7 sm:flex-row sm:items-center sm:justify-between sm:p-8" data-reveal="up" style="--d:.1s">
      <div class="flex items-center gap-4">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-accent text-brand-primary">
          <Bell class="h-5 w-5 animate-bell" />
        </span>
        <p class="font-body text-[16px] text-brand-text">
          <span class="font-semibold">Not sure where to start?</span> Send the sketch or tech pack you have —
          we’ll map the rest on a call.
        </p>
      </div>
      <a href="#quote" class="inline-flex shrink-0 items-center rounded-full bg-brand-primary px-6 py-3.5 font-body text-sm font-semibold text-brand-bg spring">
        Request a quote
      </a>
    </div>
  </div>
</section>
