---
const items = [
  'AQL 2.5 QC',
  '5,000+ vetted suppliers',
  'MOQ 50 blanks',
  'DDP — no surprise fees',
  '5–10 day sampling',
  'ISO 5077 · ISO 105',
  'FBA injection ready',
];
---

<section class="relative overflow-hidden bg-brand-primary py-4" aria-label="Proof points">
  <div class="marquee-mask overflow-hidden">
    <div class="animate-marquee flex w-max items-center gap-10">
      {[0, 1].map((copy) => (
        <div class="flex items-center gap-10" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <span class="flex items-center gap-10 whitespace-nowrap">
              <span class="font-body text-sm font-medium tracking-wide text-brand-bg/90">{item}</span>
              <span class="h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
