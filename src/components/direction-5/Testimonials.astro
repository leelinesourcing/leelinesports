---
import Underline from './Underline.astro';
import Divider from './Divider.astro';

const featured = {
  quote: 'I stopped losing sleep the week Leeline sent a live video of my order before it shipped.',
  name: 'Marcus T.',
  role: 'Founder, 3-ASIN activewear brand',
  initials: 'MT',
};

const others = [
  {
    quote: 'The DDP quote was the first time importing made sense. One price, landed at the FC, duties included.',
    name: 'Priya R.',
    role: 'Ops lead, DTC swim brand',
    initials: 'PR',
  },
  {
    quote: 'They matched us with a factory that already made compression for a name brand. First order passed AQL 2.5 with zero defects.',
    name: 'Jordan K.',
    role: 'CrossFit box owner',
    initials: 'JK',
  },
];
---

<section class="relative bg-brand-surface">
  <Divider fill="var(--color-brand-surface)" />
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-28">
    <div class="max-w-3xl">
      <span class="js-reveal inline-flex items-center gap-2 rounded-full border border-brand-primary/15 bg-white/60 px-4 py-2 font-body text-[13px] font-medium text-brand-primary" data-reveal="up">
        From our clients
      </span>
      <h2 class="js-reveal mt-5 font-heading font-semibold leading-[1.02] tracking-[-0.025em] text-brand-text text-[clamp(2rem,4.5vw,3.4rem)]" data-reveal="up" style="--d:.08s">
        People who sleep
        <span class="relative inline-block whitespace-nowrap">
          better now.
          <Underline class="absolute -bottom-2 left-0 h-[0.26em] w-full" />
        </span>
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <figure class="js-reveal flex flex-col rounded-[1.75rem] bg-brand-primary p-8 text-brand-bg shadow-[0_50px_90px_-45px_rgba(20,58,53,.9)] sm:p-10" data-reveal="left">
        <svg viewBox="0 0 40 30" class="h-8 w-10 text-brand-accent" fill="currentColor" aria-hidden="true">
          <path d="M0 30V18.5C0 7.5 7.4 0 18.4 0v5.6C11.7 6.2 6.7 11 6.1 18.5H15V30H0Zm25 0V18.5C25 7.5 32.4 0 43.4 0v5.6C36.7 6.2 31.7 11 31.1 18.5H40V30H25Z" />
        </svg>
        <blockquote class="mt-6 font-heading font-medium leading-snug text-[clamp(1.35rem,2.6vw,1.9rem)]">
          {featured.quote}
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-brand-accent to-brand-secondary font-heading text-sm font-semibold text-brand-primary">
            {featured.initials}
          </span>
          <div>
            <p class="font-body text-[15px] font-semibold">{featured.name}</p>
            <p class="font-body text-[13px] text-brand-bg/70">{featured.role}</p>
          </div>
        </figcaption>
      </figure>

      <div class="flex flex-col gap-6">
        {others.map((t, i) => (
          <figure class="js-reveal flex flex-1 flex-col rounded-[1.5rem] border border-white/60 bg-brand-bg p-7 shadow-[0_24px_50px_-30px_rgba(20,58,53,.3)]" data-reveal="right" style={`--d:${i * 0.1}s`}>
            <blockquote class="font-body text-[16px] leading-relaxed text-brand-text">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-brand-secondary to-brand-primary font-heading text-xs font-semibold text-brand-bg">
                {t.initials}
              </span>
              <div>
                <p class="font-body text-[14px] font-semibold">{t.name}</p>
                <p class="font-body text-[13px] text-brand-muted">{t.role}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
