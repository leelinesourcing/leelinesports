---
import Underline from './Underline.astro';
import Divider from './Divider.astro';

const personas = [
  {
    initials: 'FR',
    name: 'FBA Front-Runner',
    role: 'Solo Amazon private label',
    bring: 'You bring your ASINs.',
    handle: 'We handle TOS-clean packaging and injection into Amazon FCs.',
    color: 'from-brand-secondary to-brand-primary',
  },
  {
    initials: 'GV',
    name: 'Gym Visionary',
    role: 'Gym & CrossFit owner',
    bring: 'You bring your community.',
    handle: 'We handle XS–3XL merch with sublimated — not heat-pressed — logos.',
    color: 'from-brand-accent to-brand-secondary',
  },
  {
    initials: 'II',
    name: 'Influencer Icon',
    role: 'Creator launching a line',
    bring: 'You bring your audience.',
    handle: 'We handle exact Pantone matching, an NDA, and recycled fabrics.',
    color: 'from-brand-primary to-brand-secondary',
  },
  {
    initials: 'LL',
    name: 'League Logician',
    role: 'Procurement, teams & schools',
    bring: 'You bring your deadlines.',
    handle: 'We handle consistent reorders at 50-piece MOQs, season after season.',
    color: 'from-brand-secondary to-brand-accent',
  },
  {
    initials: 'DR',
    name: 'Diversifying Retailer',
    role: '$1M+ e-commerce manager',
    bring: 'You bring the volume.',
    handle: 'We handle supply-chain redundancy and honest QC reports.',
    color: 'from-brand-primary to-brand-accent',
  },
];
---

<section id="who" class="relative bg-brand-surface">
  <Divider fill="var(--color-brand-surface)" />
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-28">
    <div class="max-w-3xl">
      <span class="js-reveal inline-flex items-center gap-2 rounded-full border border-brand-primary/15 bg-white/60 px-4 py-2 font-body text-[13px] font-medium text-brand-primary" data-reveal="up">
        Who this is for
      </span>
      <h2 class="js-reveal mt-5 font-heading font-semibold leading-[1.02] tracking-[-0.025em] text-brand-text text-[clamp(2rem,4.5vw,3.4rem)]" data-reveal="up" style="--d:.08s">
        Built for the people who
        <span class="relative inline-block whitespace-nowrap">
          sell the gear.
          <Underline class="absolute -bottom-2 left-0 h-[0.26em] w-full" />
        </span>
      </h2>
      <p class="js-reveal mt-5 max-w-xl font-body text-lg text-brand-muted" data-reveal="up" style="--d:.16s">
        You don’t need to become an import expert. That’s literally our job.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {personas.map((p, i) => (
        <article
          class={`js-reveal flex flex-col rounded-[1.75rem] border border-white/60 bg-brand-bg p-7 shadow-[0_24px_50px_-30px_rgba(20,58,53,.3)] spring ${i === 4 ? 'sm:col-span-2 lg:col-span-1' : ''}`}
          data-reveal="up"
          style={`--d:${i * 0.07}s`}
        >
          <div class="flex items-center gap-3">
            <span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br ${p.color} font-heading text-sm font-semibold text-brand-bg`}>
              {p.initials}
            </span>
            <div>
              <h3 class="font-heading text-[17px] font-semibold leading-tight text-brand-text">{p.name}</h3>
              <p class="font-body text-[13px] text-brand-muted">{p.role}</p>
            </div>
          </div>
          <p class="mt-5 font-body text-[15px] font-medium text-brand-primary">{p.bring}</p>
          <p class="mt-2 flex-1 font-body text-[15px] leading-relaxed text-brand-muted">{p.handle}</p>
        </article>
      ))}

      <article class="js-reveal flex flex-col justify-center rounded-[1.75rem] bg-brand-primary p-7 text-brand-bg" data-reveal="up" style="--d:.35s">
        <p class="font-heading text-2xl font-semibold leading-tight">Don’t see yourself here?</p>
        <p class="mt-3 font-body text-[15px] text-brand-bg/75">
          If you sell anything people wear, we can likely make it. Tell us what you’re planning.
        </p>
        <a href="#quote" class="mt-5 inline-flex w-fit items-center rounded-full bg-brand-accent px-5 py-2.5 font-body text-sm font-semibold text-brand-primary">
          Tell us your plan
        </a>
      </article>
    </div>
  </div>
</section>
