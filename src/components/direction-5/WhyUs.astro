---
import Underline from './Underline.astro';
import Check from './Check.astro';

const points = [
  {
    num: '5,000+',
    title: 'Suppliers, shortlisted for you',
    desc: 'We match by product category and factory history — not by who paid for the top of a directory.',
  },
  {
    num: '1 price',
    title: 'DDP, no surprise fees',
    desc: 'Manufacturing, shipping and duties land on a single quote. What you sign is what you pay.',
  },
  {
    num: 'AQL 2.5',
    title: 'QC on every order',
    desc: 'The same inspection standard big brands use, applied whether you order 300 or 30,000 pieces.',
  },
  {
    num: 'Wuhan',
    title: 'Ground presence, not fly-ins',
    desc: 'Our inspectors live near the factories and supervise in-plant, every single run.',
  },
  {
    num: '0 risk',
    title: 'Sampling fees refunded',
    desc: 'Pay for samples, get it back on your bulk order. Iterate until the garment is right.',
  },
];

const compare = [
  { label: 'vs a direct factory', line: 'One factory, one set of problems, no one in your corner.' },
  { label: 'vs a trading company', line: 'A middleman markup with no QC or standards attached.' },
  { label: 'vs a Western agent', line: 'The same service, at 3–4× the landed cost.' },
];
---

<section class="relative bg-brand-bg">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 px-5 py-24 sm:px-8 sm:py-28 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5 lg:sticky lg:top-28">
      <span class="js-reveal inline-flex items-center gap-2 rounded-full border border-brand-primary/15 bg-white/60 px-4 py-2 font-body text-[13px] font-medium text-brand-primary" data-reveal="up">
        Why LeelineSports
      </span>
      <h2 class="js-reveal mt-5 font-heading font-semibold leading-[1.02] tracking-[-0.025em] text-brand-text text-[clamp(2rem,4.5vw,3.3rem)]" data-reveal="up" style="--d:.08s">
        Not a factory. Not a middleman.
        <span class="relative inline-block whitespace-nowrap">
          Your procurement desk.
          <Underline class="absolute -bottom-2 left-0 h-[0.26em] w-full" />
        </span>
      </h2>
      <p class="js-reveal mt-5 max-w-lg font-body text-lg text-brand-muted" data-reveal="up" style="--d:.16s">
        We’re the department you’d build if you could afford to station a
        sourcing lead, a QC inspector and a logistics manager in China.
      </p>
      <div class="js-reveal mt-8 flex items-center gap-4" data-reveal="up" style="--d:.24s">
        <span class="font-heading text-5xl font-semibold text-brand-primary">
          <span data-count="5000">0</span><span class="text-brand-accent">+</span>
        </span>
        <span class="font-body text-sm leading-snug text-brand-muted">vetted suppliers<br />across 6 provinces</span>
      </div>
    </div>

    <div class="lg:col-span-7">
      <ol class="space-y-4">
        {points.map((p, i) => (
          <li
            class="js-reveal flex gap-5 rounded-[1.5rem] border border-brand-primary/10 bg-white/60 p-6 sm:items-center"
            data-reveal="left"
            style={`--d:${i * 0.07}s`}
          >
            <span class="hidden w-24 shrink-0 font-heading text-xl font-semibold text-brand-primary sm:block">
              {p.num}
            </span>
            <div>
              <h3 class="flex items-center gap-2 font-heading text-lg font-semibold text-brand-text">
                <Check class="h-5 w-5 text-brand-accent" />
                {p.title}
              </h3>
              <p class="mt-1.5 font-body text-[15px] leading-relaxed text-brand-muted sm:hidden">{p.num} · {p.desc}</p>
              <p class="mt-1.5 hidden font-body text-[15px] leading-relaxed text-brand-muted sm:block">{p.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="js-reveal mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3" data-reveal="up" style="--d:.2s">
        {compare.map((c) => (
          <div class="rounded-[1.25rem] border border-brand-primary/10 bg-brand-surface p-5">
            <p class="font-body text-[13px] font-semibold text-brand-primary">{c.label}</p>
            <p class="mt-2 font-body text-[13.5px] leading-relaxed text-brand-muted">{c.line}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
