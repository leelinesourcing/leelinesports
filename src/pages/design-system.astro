          </div>
        </div>
        <div class="ds-stage">
          <PricingDelivery />
        </div>
      </article>

      <article class="ds-item ds-item--full">
        <div class="cw-wrap">
          <div class="ds-item-bar">
            <span class="ds-item-name">Process</span>
