---
/**
 * Design System — the component and token inventory.
 *
 * No-index, internal only. Every entry below is imported from `src/components/`;
 * nothing is defined inline on this page. Add any new reusable component here
 * with its name and file path so this stays the source of truth.
 *
 * Full rules live in docs/brand-guide.md.
 */
import Layout from '../layouts/Layout.astro'

// ── Atoms ────────────────────────────────────────────────
import Badge from '../components/Badge.astro'
import Button from '../components/Button.astro'
import Contour from '../components/Contour.astro'
import Mark from '../components/Mark.astro'
import Check from '../components/Check.astro'
import Stars from '../components/Stars.astro'
import SectionHead from '../components/SectionHead.astro'

// ── Sections ─────────────────────────────────────────────
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import ProofBar from '../components/ProofBar.astro'
import Verticals from '../components/Verticals.astro'
import Pain from '../components/Pain.astro'
import Services from '../components/Services.astro'
import BeyondOrder from '../components/BeyondOrder.astro'
import Certifications from '../components/Certifications.astro'
import PricingDelivery from '../components/PricingDelivery.astro'
import Process from '../components/Process.astro'
import ICPs from '../components/ICPs.astro'
import WhyUs from '../components/WhyUs.astro'
import CaseStudies from '../components/CaseStudies.astro'
import Testimonials from '../components/Testimonials.astro'
import Showcase from '../components/Showcase.astro'
import Faq from '../components/Faq.astro'
import FinalCta from '../components/FinalCta.astro'
import Footer from '../components/Footer.astro'

// ── Golf Apparel Manufacturer page ───────────────────────
import GolfHero from '../components/GolfHero.astro'
import GolfTypes from '../components/GolfTypes.astro'
import GolfCustom from '../components/GolfCustom.astro'
import GolfServices from '../components/GolfServices.astro'
import GolfCustomers from '../components/GolfCustomers.astro'
import GolfCertifications from '../components/GolfCertifications.astro'
import GolfReviews from '../components/GolfReviews.astro'
import CyclingHero from '../components/CyclingHero.astro'
import CyclingSpecStrip from '../components/CyclingSpecStrip.astro'
import CyclingTypes from '../components/CyclingTypes.astro'
import CyclingSpecPlate from '../components/CyclingSpecPlate.astro'
import CyclingCustom from '../components/CyclingCustom.astro'
import CyclingServices from '../components/CyclingServices.astro'
import CyclingDisciplines from '../components/CyclingDisciplines.astro'
import CyclingCertification from '../components/CyclingCertification.astro'
import CyclingTrusted from '../components/CyclingTrusted.astro'
import CyclingReviews from '../components/CyclingReviews.astro'

/** Every token in the `@theme` block, in source order. */
const colors = [
  { name: 'steel', hex: '#386694', use: 'Denim blue — links, rules, numerals, badges', onDark: true },
  { name: 'navy', hex: '#0E2038', use: 'Deep navy — the secondary step', onDark: true },
  { name: 'berry', hex: '#B2475B', use: 'Oxblood berry — CTAs, marks, accents', onDark: true },
  { name: 'cream', hex: '#F8F7F3', use: 'Page background', onDark: false },
  { name: 'linen', hex: '#EEECE6', use: 'Raised surfaces, alternating bands', onDark: false },
  { name: 'charcoal', hex: '#1A1B22', use: 'Body copy', onDark: true },
  { name: 'slate', hex: '#7A7C88', use: 'Muted copy', onDark: false },
  { name: 'denim', hex: '#12284B', use: 'Dark panels — the closing CTA', onDark: true },
  { name: 'midnight', hex: '#0A182E', use: 'Deepest step — the footer', onDark: true },
  { name: 'paper', hex: '#FFFFFF', use: 'White cards and panels on linen', onDark: false },
  { name: 'mist', hex: '#F1F2F9', use: 'Light ink on the dark featured card', onDark: false },
  { name: 'ink', hex: '#182430', use: 'Shadow and photographic-veil base', onDark: true },
]
---

<Layout title="Design System — LeelineSports" description="Internal component inventory and brand reference." noindex>
  <main>
    <!-- ── header ─────────────────────────────────────── -->
    <div class="cw-wrap ds-head">
      <p class="cw-eyebrow">Brand reference</p>
      <h1 class="cw-h1 ds-title">Design System</h1>
      <p class="cw-lede">Component inventory and brand reference</p>
      <p class="ds-note">
        Everything on this page is imported from <code>src/components/</code> — nothing is
        defined inline here. Rules, rationale and image treatment live in
        <code>docs/brand-guide.md</code>.
      </p>
    </div>

    <!-- ── colors ─────────────────────────────────────── -->
    <section class="cw-wrap ds-section" id="colors">
      <h2 class="ds-section-title">Colors</h2>
      <p class="ds-section-sub">
        Every token in the <code>@theme</code> block. Token names map to the utilities
        <code>bg-*</code>, <code>text-*</code>, <code>border-*</code> and <code>ring-*</code>.
      </p>

      <div class="ds-swatches">
        {colors.map((c) => (
          <figure class="ds-swatch">
            <div class="ds-swatch-chip" style={`background: var(--color-${c.name})`}>
              <span class:list={['ds-swatch-class', c.onDark ? 'text-cream' : 'text-charcoal']}>
                bg-{c.name}
              </span>
            </div>
            <figcaption class="ds-swatch-meta">
              <span class="ds-swatch-name">{c.name}</span>
              <span class="ds-swatch-hex">{c.hex}</span>
              <span class="ds-swatch-use">{c.use}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ── typography ─────────────────────────────────── -->
    <section class="cw-wrap ds-section" id="typography">
      <h2 class="ds-section-title">Typography</h2>
      <p class="ds-section-sub">
        Fraunces carries voice; Manrope carries information. Both are self-hosted variable
        fonts — the fractional weights only work because of that.
      </p>

      <div class="ds-type">
        <div class="ds-type-row">
          <div class="ds-type-meta"><span>H1</span><code>.cw-h1</code></div>
          <div class="ds-type-sample">
            <p class="cw-h1">Carry the risk.</p>
            <p class="ds-type-spec">
              Fraunces · 620 · clamp(3rem, 9vw, 6.9rem) · line-height 0.94 · tracking −0.035em ·
              opsz 144. The hero overrides the size to clamp(2.4rem, 5.4vw, 4.6rem) at
              line-height 1.02. Shown as a <code>&lt;p&gt;</code> so this page keeps a single h1.
            </p>
          </div>
        </div>

        <div class="ds-type-row">
          <div class="ds-type-meta"><span>H2</span><code>.cw-h2</code></div>
          <div class="ds-type-sample">
            <h2 class="cw-h2">One roof, five services.</h2>
            <p class="ds-type-spec">
              Fraunces · 520 · clamp(2.1rem, 4.5vw, 3.6rem) · line-height 1.02 · tracking
              −0.025em · opsz 80.
            </p>
          </div>
        </div>

        <div class="ds-type-row">
          <div class="ds-type-meta"><span>H3</span><code>.cw-h3</code></div>
          <div class="ds-type-sample">
            <h3 class="cw-h3">Built to your tech pack.</h3>
            <p class="ds-type-spec">
              Fraunces · 560 · clamp(1.35rem, 2.6vw, 1.85rem) · line-height 1.12 · tracking
              −0.015em · opsz 48.
            </p>
          </div>
        </div>

        <div class="ds-type-row">
          <div class="ds-type-meta"><span>H4</span><code>.ds-h4</code></div>
          <div class="ds-type-sample">
            <h4 class="ds-h4">Standards you can verify.</h4>
            <p class="ds-type-spec">
              Fraunces · 560 · 1.3rem · line-height 1.15 · tracking −0.025em · opsz 48. There is
              no global H4 class — this is the sub-heading treatment the component styles use
              in Certifications.
            </p>
          </div>
        </div>

        <div class="ds-type-row">
          <div class="ds-type-meta"><span>Kicker</span><code>.cw-eyebrow</code></div>
          <div class="ds-type-sample">
            <p class="cw-eyebrow">What we make</p>
            <p class="ds-type-spec">
              Fraunces italic · 420 · 1.05rem · tracking 0.01em · slate. Prefixed by a berry
              ring. The dark-ground variant is <code>.cw-eyebrow--light</code>.
            </p>
          </div>
        </div>

        <div class="ds-type-row">
          <div class="ds-type-meta"><span>Body</span><code>body</code></div>
          <div class="ds-type-sample">
            <p>
              Bring a sketch or a tech pack — we run sourcing, AQL 2.5 inspection and DDP
              delivery under one roof, so you never touch a shipment.
            </p>
            <p class="ds-type-spec">
              Manrope · 400 · 1.03rem · line-height 1.6 · <code>charcoal</code> on
              <code>cream</code>. The default text style; no class required.
            </p>
          </div>
        </div>

        <div class="ds-type-row">
          <div class="ds-type-meta"><span>Lead</span><code>.cw-lede</code></div>
          <div class="ds-type-sample">
            <p class="cw-lede">
              Every quote is DDP — manufacturing, freight and import duties arrive as a single
              approved figure.
            </p>
            <p class="ds-type-spec">
              Manrope · 400 · 1.10rem · line-height 1.66 · slate · measure capped at 58ch. The
              dark-ground variant is <code>.cw-lede--light</code>.
            </p>
          </div>
        </div>

        <div class="ds-type-row">
          <div class="ds-type-meta"><span>Caption</span><code>.ds-caption</code></div>
          <div class="ds-type-sample">
            <p class="ds-caption">AQL 2.5 major / 4.0 minor · ISO 5077 · ISO 105</p>
            <p class="ds-type-spec">
              Manrope · 600 · 0.92rem · tracking 0.01em · slate. The label/caption scale used by
              stat labels (0.90rem), certificate labels (0.92rem) and footnotes (0.94rem). Nothing
              on the site renders below 0.82rem.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── atoms ──────────────────────────────────────── -->
    <section class="cw-wrap ds-section" id="atoms">
      <h2 class="ds-section-title">Atoms</h2>
      <p class="ds-section-sub">Small reusable elements. Import these instead of rebuilding them.</p>

      <article class="ds-item">
        <div class="ds-item-bar">
          <span class="ds-item-name">Badge</span>
          <code class="ds-item-path">src/components/Badge.astro</code>
        </div>
        <div class="ds-stage ds-stage--pad">
          <div class="ds-row">
            <Badge>Default</Badge>
            <Badge variant="accent">Accent</Badge>
            <Badge variant="outline">Outline</Badge>
            <Badge size="sm">Small</Badge>
            <Badge size="lg">Large</Badge>
            <Badge uppercase>Tracked caps</Badge>
          </div>
          <div class="ds-dark-chip ds-row">
            <Badge variant="onDark">On dark</Badge>
            <Badge variant="onDark" uppercase>Process tag</Badge>
          </div>
        </div>
      </article>

      <article class="ds-item">
        <div class="ds-item-bar">
          <span class="ds-item-name">Button</span>
          <code class="ds-item-path">src/components/Button.astro</code>
        </div>
        <div class="ds-stage ds-stage--pad">
          <div class="ds-row">
            <Button href="#quote">Berry</Button>
            <Button href="#quote" variant="indigo">Indigo</Button>
            <Button href="#quote" size="sm">Small</Button>
          </div>
          <div class="ds-dark-chip ds-row">
            <Button href="#quote" variant="ghost">Ghost</Button>
            <Button href="#quote" variant="ghost" size="sm">Ghost small</Button>
          </div>
          <div class="ds-row ds-row--stack">
            <Button href="#quote" block>Block</Button>
          </div>
        </div>
      </article>

      <article class="ds-item">
        <div class="ds-item-bar">
          <span class="ds-item-name">Mark</span>
          <code class="ds-item-path">src/components/Mark.astro</code>
        </div>
        <div class="ds-stage ds-stage--pad">
          <div class="ds-row ds-row--middle">
            <span class="text-berry"><Mark /></span>
            <span class="text-steel"><Mark /></span>
            <span class="text-charcoal"><Mark /></span>
            <span class="ds-caption">registration crosshair · tints via currentColor</span>
          </div>
        </div>
      </article>

      <article class="ds-item">
        <div class="cw-wrap">
          <div class="ds-item-bar">
            <span class="ds-item-name">Check</span>
            <code class="ds-item-path">src/components/Check.astro</code>
          </div>
        </div>
        <div class="ds-stage ds-stage--pad">
          <div class="ds-row ds-row--middle">
            <span class="text-berry"><Check /></span>
            <span class="text-steel"><Check /></span>
            <span class="text-charcoal"><Check /></span>
            <span class="ds-caption">confirmation tick · tints via currentColor</span>
          </div>
        </div>
      </article>

      <article class="ds-item">
        <div class="cw-wrap">
          <div class="ds-item-bar">
            <span class="ds-item-name">Stars</span>
            <code class="ds-item-path">src/components/Stars.astro</code>
          </div>
        </div>
        <div class="ds-stage ds-stage--pad">
          <div class="ds-row ds-row--middle">
            <span class="text-berry"><Stars /></span>
            <span class="text-steel"><Stars /></span>
            <span class="text-charcoal"><Stars /></span>
            <span class="ds-caption">rating row · tints via currentColor</span>
          </div>
        </div>
      </article>

      <article class="ds-item">
        <div class="ds-item-bar">
          <span class="ds-item-name">Contour</span>
          <code class="ds-item-path">src/components/Contour.astro</code>
        </div>
        <div class="ds-stage ds-stage--pad">
          <div class="ds-row ds-row--middle">
            <span class="text-berry"><Contour /></span>
            <span class="text-steel"><Contour size={22} /></span>
            <span class="text-slate"><Contour size={64} /></span>
            <span class="ds-caption">concentric eyebrow ornament · centre dot is always berry</span>
          </div>
        </div>
      </article>

      <article class="ds-item">
        <div class="ds-item-bar">
          <span class="ds-item-name">SectionHead</span>
          <code class="ds-item-path">src/components/SectionHead.astro</code>
        </div>
        <div class="ds-stage ds-stage--pad">
          <SectionHead
            kicker="What we make"
            lead="The kicker sits above the title with a hairline rule, and the lead runs under it at a comfortable measure."
          >
            One roof, five services.
          </SectionHead>
          <div class="ds-dark-chip ds-stage--pad">
            <SectionHead
              kicker="Dark tone"
              tone="dark"
              align="center"
              lead="tone='dark' inverts the palette; align='center' centres the block and drops the rule."
            >
              Centred on a dark ground.
            </SectionHead>
          </div>
        </div>
      </article>
    </section>

    <!-- ── sections ───────────────────────────────────── -->
    <section class="ds-section" id="sections">
      <div class="cw-wrap">
        <h2 class="ds-section-title">Sections</h2>
        <p class="ds-section-sub">
          Full page sections, rendered exactly as they appear. Each one ships with the
          placeholder content shown; pass props to override it.
        </p>
      </div>

      <article class="ds-item ds-item--full">
        <div class="cw-wrap">
          <div class="ds-item-bar">
            <span class="ds-item-name">Nav</span>
            <code class="ds-item-path">src/components/Nav.astro</code>
          </div>
        </div>
        <div class="ds-stage ds-stage--fixed">
          <Nav />
        </div>
      </article>

      <article class="ds-item ds-item--full">
        <div class="cw-wrap">
          <div class="ds-item-bar">
